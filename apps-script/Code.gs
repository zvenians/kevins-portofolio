n      cancelAnimationFrame(frame);frame=requestAnimationFrame(()=>{\n        stage.style.setProperty('--depth-rx',((.5-y)*2.2).toFixed(2)+'deg');\n        stage.style.setProperty('--depth-ry',((x-.5)*2.8).toFixed(2)+'deg');\n        stage.style.setProperty('--depth-x',(x*100).toFixed(1)+'%');\n        stage.style.setProperty('--depth-y',(y*100).toFixed(1)+'%');\n        const coordinate=stage.querySelector(':scope > .spatial-coordinate b');\n        if(coordinate)coordinate.textContent=String(Math.round(x*99)).padStart(2,'0')+' / '+String(Math.round(y*99)).padStart(2,'0')+' / '+String(index+1).padStart(2,'0');\n      });\n    });\n    stage.addEventListener('pointerleave',reset);\n    stage.addEventListener('focusin',event=>{stage.classList.add('has-depth-focus');event.target.closest('.depth-plane')?.classList.add('is-depth-active');});\n    stage.addEventListener('focusout',event=>{event.target.closest('.depth-plane')?.classList.remove('is-depth-active');if(!stage.contains(event.relatedTarget))stage.classList.remove('has-depth-focus');});\n    reset();\n  });\n}\n\nfunction admin(){document.body.classList.remove('focus-reading');$('#main').innerHTML=`<article class=\"admin-page\"><span class=\"eyebrow\">OWNER WORKSPACE / GOOGLE APPS SCRIPT</span><h1>Keep it growing.</h1><p>Projects, media, and your current resume. Every write is checked on the server.</p><div class=\"admin-toolbar\"><button id=\"new-project\" class=\"solid-button\">Add a project +</button><a class=\"text-link\" href=\"${esc(data.databaseUrl)}\" target=\"_blank\" rel=\"noopener\">Open content spreadsheet ↗</a><a class=\"text-link\" href=\"${esc(data.appUrl)}\" target=\"_top\">View public site ↗</a><button id=\"refresh-admin\">Refresh content</button></div><div class=\"admin-panel\"><h2>Exhibits</h2><div class=\"admin-list\">${data.projects.map(p=>`<button data-edit=\"${esc(p.id)}\"><span>${esc(p.name)}</span><span>${esc(p.visibility)} · ${p.featured?'Featured · ':''}${p.order} ↗</span></button>`).join('')}</div></div><div id=\"project-editor\"></div><div class=\"admin-panel\"><h2>Resume</h2><p class=\"admin-help\">PDF only, maximum 5 MB. Uploads are private drafts. Publishing exposes the selected PDF through the website; other versions stay private.</p><div class=\"drop-zone\" id=\"resume-drop\"><label for=\"resume-upload\">Choose a PDF or drop it here</label><br><input id=\"resume-upload\" type=\"file\" accept=\"application/pdf,.pdf\"><p id=\"upload-message\" role=\"status\"></p></div><div class=\"admin-list\" style=\"margin-top:20px\">${(data.resumes||[]).map(r=>`<div class=\"admin-toolbar\"><span>${esc(r.name)} · ${esc(String(r.uploadedAt).slice(0,10))} · ${r.published?'PUBLISHED':'DRAFT'}</span><button data-preview-resume=\"${esc(r.id)}\">Preview</button><button data-publish-resume=\"${esc(r.id)}\">${r.published?'Unpublish':'Publish'}</button></div>`).join('')||'<p class=\"admin-help\">No resume uploaded yet.</p>'}</div></div><div class=\"admin-panel\"><h2>Media</h2><p class=\"admin-help\">PNG or JPEG, maximum 4 MB. Uploaded files stay private until attached to a published project.</p><input id=\"media-upload\" type=\"file\" accept=\"image/png,image/jpeg\"><div class=\"admin-list\" style=\"margin-top:20px\">${(data.media||[]).map(m=>`<p>${esc(m.name)} <code>${esc(m.id)}</code></p>`).join('')}</div></div><div class=\"admin-panel\"><h2>Public contact details</h2><p class=\"admin-help\">Only add contact details you want visitors to see. Empty fields remain hidden.</p><form id=\"settings-form\" class=\"form-grid\"><label>Email<input name=\"email\" type=\"email\" value=\"${esc(data.settings?.email||'')}\"></label><label>LinkedIn HTTPS URL<input name=\"linkedin\" type=\"url\" value=\"${esc(data.settings?.linkedin||'')}\"></label><label>WhatsApp, country code and digits<input name=\"whatsapp\" value=\"${esc(data.settings?.whatsapp||'')}\"></label><div><button class=\"solid-button\">Publish contact details</button></div></form></div><div class=\"admin-panel\"><h2