f respondents<input name=\"sample\" inputmode=\"numeric\" maxlength=\"6\" placeholder=\"For example: 120\"></label><label>Target date<input name=\"deadline\" type=\"date\"></label><label class=\"wide\">A little context<textarea name=\"note\" maxlength=\"600\" rows=\"5\" placeholder=\"For example: the data is ready, but I am still unsure which test to use and how to explain the regression result.\"></textarea></label><button class=\"dark-button wide\" type=\"submit\">Prepare my consultation message ↗</button><div class=\"intake-result wide\" id=\"intake-result\" hidden><p id=\"intake-summary\"></p><a class=\"solid-button\" id=\"intake-contact\" target=\"_blank\" rel=\"noopener\">Continue on WhatsApp ↗</a></div></form>`;}\nfunction researchRows(r){return `<div class=\"research-table\"><table><thead><tr>${r.headers.map(x=>`<th>${esc(x)}</th>`).join('')}</tr></thead><tbody>${r.rows.map(row=>`<tr>${row.map(x=>`<td>${esc(x)}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`;}\nfunction researchDataset(i){if(i===0)return [['DEMONSTRATION DATA'],['respondent','Q01','Q02','Q03','Q04'],['R001',4,4,3,5],['R002',3,4,2,4],['R003',5,5,4,5],['R004',2,3,2,3],['R005',4,3,3,4]];if(i===1)return [['DEMONSTRATION DATA'],['respondent','service_quality','access_ease','outcome'],['R001',4.2,3.8,4.4],['R002',3.5,3.2,3.6],['R003',4.8,4.1,4.9],['R004',2.9,3.4,3.1],['R005',4.0,4.4,4.3]];if(i===2)return [['DEMONSTRATION DATA'],['respondent','group','score'],['R001','Method A',79],['R002','Method A',82],['R003','Method B',73],['R004','Method B',76],['R005','Method A',74],['R006','Method B',70]];return [['DEMONSTRATION DATA'],['section','purpose','question'],...researchCases[i].rows];}\nfunction renderResearch(i=0){state.research=i;remember();$$('[data-research]').forEach(b=>b.setAttribute('aria-pressed',Number(b.dataset.research)===i));const r=researchCases[i];$('#research-output').innerHTML=`<span class=\"eyebrow\">INTERACTIVE DEMO / SYNTHETIC DATA</span><h3>${r.title}</h3><p>${r.summary