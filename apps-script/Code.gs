es;s.onerror=()=>rej(new Error('PDF library could not load.'));document.head.appendChild(s)});const pdf=await PDFLib.PDFDocument.create();const font=await pdf.embedFont(PDFLib.StandardFonts.Helvetica);const lines=[['THE LIVING INDEX / MAINTENANCE','Demonstration Data - fictional records only','Equipment: DEMO-GEN-01 / Backup generator','Total service cost: IDR 5,200,000','Next inspection: 20 November 2026','Follow-up: review cooling-hose replacement recommendation.'],...services.map(r=>['SERVICE RECORD / '+r[2],'Demonstration Data - fictional records only','Equipment: DEMO-GEN-01','Date: '+r[0],'Type: '+r[1],'Work: '+r[3],'Cost: IDR '+r[4].toLocaleString('en-US')])];lines.forEach((ls,i)=>{const page=pdf.addPage([595,842]);ls.forEach((s,j)=>page.drawText(s,{x:50,y:760-j*36,size:j===0?17:11,font}));page.drawText(`${i+1} / ${lines.length}`,{x:50,y:40,size:10,font});});Engine.downloadBlob('maintenance-demo.pdf',new Blob([await pdf.save()],{type:'application/pdf'}));});}\nlet scheduleState={month:'2026-11',names:'Team A, Team B, Team C',holidays:'2026-11-10',weekdays:true};function scheduling(){const people=scheduleState.names.split(',').map(n=>n.trim()).filter(Boolean);const duplicate=new Set(people.map(n=>n.toLowerCase())).size!==people.length;const rows=schedule(scheduleState.month,people,scheduleState.holidays.split(',').map(s=>s.trim()),scheduleState.weekdays);$('#workspace').innerHTML=workspaceHeading('05','A rhythm that adjusts itself.',`<button class=\"dark-button\" id=\"schedule-export\" ${!rows.length||duplicate?'disabled':''}>Export Excel ↓</button>`)+`<div class=\"lab-controls\"><label>Month<input id=\"schedule-month\" type=\"month\" value=\"${scheduleState.month}\"></label><label>Rotation, comma-separated<input id=\"schedule-names\" value=\"${esc(scheduleState.names)}\"></label><label>Excluded dates, YYYY-MM-DD<input id=\"schedule-holidays\" value=\"${esc(scheduleState.holidays)}\"></label><label class=\"checkbox\"><input id=\"schedule-weekdays\" type=\"chec