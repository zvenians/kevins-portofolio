e.','A transparent proportion estimate using confidence level, margin of error, expected proportion, and optional finite-population correction.',`<form class=\"tool-form\" id=\"sample-planner\"><label>Confidence<select name=\"confidence\"><option value=\"1.645\">90%</option><option value=\"1.96\" selected>95%</option><option value=\"2.576\">99%</option></select></label><label>Margin of error<input name=\"margin\" type=\"number\" min=\"1\" max=\"20\" step=\"0.5\" value=\"5\"><small>Percent</small></label><label>Expected proportion<input name=\"proportion\" type=\"number\" min=\"1\" max=\"99\" value=\"50\"><small>Use 50% when uncertain.</small></label><label>Population size<input name=\"population\" type=\"number\" min=\"0\" max=\"10000000\" value=\"1000\"><small>Use 0 for a large or unknown population.</small></label></form>`);\n  const form=$('#sample-planner');function update(){const f=new FormData(form),z=Number(f.get('confidence')),e=Number(f.get('margin'))/100,p=Number(f.get('proportion'))/100,N=Number(f.get('population')),n0=z*z*p*(1-p)/(e*e),adjusted=N>0?n0/(1+(n0-1)/N):n0,n=Math.ceil(adjusted);$('#tool-result').innerHTML=`<span class=\"eyebrow\">PLANNING ESTIMATE</span><div class=\"sample-number\">${n}</div><p>minimum completed responses</p><dl><div><dt>Large-population estimate</dt><dd>${Math.ceil(n0)}</dd></div><div><dt>Finite correction</dt><dd>${N>0?'Applied for N = '+N.toLocaleString('en-US'):'Not applied'}</dd></div><div><dt>Reminder</dt><dd>Increase invitations for non-response and confirm the sampling design with a supervisor.</dd></div></dl><button id=\"sample-notes\">Download planning note ↓</button>`;$('#sample-notes').onclick=()=>Engine.downloadBlob('sample-size-planning-note.txt',new Blob([`SAMPLE SIZE PLANNING DEMO\\nEstimate: ${n}\\nConfidence z: ${z}\\nMargin: ${e*100}%\\nExpected proportion: ${p*100}%\\nPopulation: ${N||'large or unknown'}\\n\\nThis is a planning estimate, not approval of a research design.`],{type:'text/plain;charset=utf-8'}