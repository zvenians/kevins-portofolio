/strong><span>items to review</span></div></div><div class=\"citation-findings\"><div><h5>Missing from reference list</h5>${missing.length?missing.map(x=>`<span>${esc(x)}</span>`).join(''):'<span>None found</span>'}</div><div><h5>Not cited in this draft</h5>${unused.length?unused.map(x=>`<span>${esc(x)}</span>`).join(''):'<span>None found</span>'}</div></div><p class=\"tool-caution\">Only parenthetical “(Author, 2024)” patterns are checked. Narrative citations, organizations, multiple authors, DOI accuracy, and source authenticity need a full review.</p>`;}\n  form.oninput=update;update();\n}\n\nconst defenseQuestions={quantitative:['Why does this test fit your research question?','How did you check the assumptions?','What does the effect size add beyond the p-value?','Which limitation matters most when reading this result?'],qualitative:['Why is this participant selection appropriate?','How did you move from raw material to themes?','What did you do to strengthen credibility?','Which alternative interpretation did you consider?'],mixed:['Why was one method not enough?','How did the quantitative and qualitative findings connect?','Where did the two strands disagree?','How did integration change the conclusion?']};\nlet defensePosition=0;\nfunction defensePractice(){\n  const w=$('#research-tool-workspace');\n  w.innerHTML=toolkitFrame('07','Practice the difficult questions.','Choose a design, write a short answer in your own words, then use the prompts to check whether the answer is defensible.',`<form class=\"tool-form\" id=\"defense-form\"><label>Research design<select name=\"design\"><option value=\"quantitative\">Quantitative</option><option value=\"qualitative\">Qualitative</option><option value=\"mixed\">Mixed methods</option></select></label><label class=\"wide\">Research topic<input name=\"topic\" value=\"How service quality relates to user satisfaction\" maxlength=\"180\"></label></form>`,`<div id=\"tool-result\" class=\"tool-result defense-card\" aria-live=\"polite\"></div>`);\n  const form=$('#defense-form');function draw(){const f=new FormData(form),design=String(f.get('design')),topic=String(f.get('topic')),questions=defenseQuestions[design],q=questions[defensePosition%questions.length];$('#tool-result').innerHTML=`<span class=\"eyebrow\">QUESTION ${defensePosition%questions.length+1} / ${questions.length}</span><h5>${esc(q)}</h5><p>Topic in view: ${esc(topic)}</p><textarea id=\"defense-answer\" rows=\"6\" placeholder=\"Build your answer: decision → evidence → limitation.\"></textarea><div class=\"answer-checks\"><span>□ State the decision clearly</span><span>□ Point to evidence</span><span>□ Acknowledge a limitation</span><span>□ Avoid claims the design cannot support</span></div><button id=\"defense-next\">Next question →</button>`;$('#defense-next').onclick=()=>{defensePosition++;draw();};}\n  form.oninput=()=>{defensePosition=0;draw();};draw();\n}\n\nconst revisionDefaults=[['Confirm research question',true],['Finalize instrument blueprint',true],['Document data-cleaning decisions',false],['Run and review assumptions',false],['Prepare results tables',false],['Check citation consistency',false],['Rehearse defense questions',false]];\nfunction revisionTracker(){\n  const w=$('#research-tool-workspace');let saved;try{saved=JSON.parse(localStorage.getItem('living-research-plan')||'null');}catch{}const plan=Array.isArray(saved?.tasks)?saved.tasks:revisionDefaults.map(x=>[...x]);const target=saved?.target||'2026-11-30';\n  w.innerHTML=toolkitFrame('08','Keep revisions visible.','A local checklist for planning the next research actions. Progress stays in this browser only.',`<form class=\"tool-form\" id=\"revision-form\"><label>Target date<input id=\"revision-target\" type=\"date\" value=\"${esc(target)}\"></label><div class=\"wide revision-list\">${plan.map((item,i)=>`<label><input data-revision=\"${i}\" type=\"checkbox\" ${item[1]?'checked':''}><span>${esc(item[0])}</span></label>`).join('')}</div></form>`);\n  function update(){plan.forEach((item,i)=>item[1]=$(`[data-revision=\"${i}\"]`).checked);const date=$('#revision-target').value,done=plan.filter(x=>x[1]).length,percent=Math.round(done/plan.length*100),days=date?Math.ceil((new Date(date+'T12:00:00')-new Date())/86400000):null;try{localStorage.setItem('living-research-plan',JSON.stringify({target:date,tasks:plan}));}catch{}$('#tool-result').innerHTML=`<div class=\"revision-progress\"><strong>${percent}%</strong><div><span style=\"width:${percent}%\"></span></div><p>${done} of ${plan.length} actions complete · ${days===null?'no target selected':days>=0?days+' days remaining':Math.abs(days)+' days past target'}</p></div><button id=\"revision-export\">Download revision plan ↓</button>`;$('#revision-export').onclick=()=>csvDownload('research-revision-plan.csv',[['PERSONAL PLANNING FILE'],['Target date',date],['Action','Status'],...plan.map(x=>[x[0],x[1]?'Complete':'Open'])]);}\n  $('#revision-form').onchange=update;update();\n}\n\n// Six focused demonstrations that fill the remaining portfolio gaps.\nfunction nextWaveDemo(kind){\n  const demos={fieldcompanion:fieldCompanionDemo,dataprep:dataPreparationDemo,documents:documentAutomationDemo,commerceops:commerceOperationsDemo,qualityroom:qualityEvidenceDemo,scopebuilder:scopeBuilderDemo};\n  (demos[kind]||(()=>{$('#next-wave-demo').innerHTML='<p>This demonstration is unavailable.</p>';}))();\n}\n\nfunction demoDownload(name,text,type='text/plain;charset=utf-8'){\n  Engine.downloadBlob(name,new Blob([text],{type}));\n}\n\nfunction demoShell(kicker,title,note,body){\n  return `<div class=\"working-demo\" data-demo-stage><div class=\"depth-readout\" aria-hidden=\"true\"><span>INPUT</span><i></i><span>PROCESS</span><i></i><span>OUTPUT</span></div><header class=\"working-demo-head\"><div><span>${kicker}</span><h3>${title}</h3></div><p>${note}</p></header><div class=\"workbench-body\">${body}</div><footer>Demonstration Data / Runs locally / Nothing is submitted</footer></div>`;\n}\n\nfunction fieldCompanionDemo(){\n  const root=$('#next-wave-demo');\n  let connected=true;\n  let queue=[];\n  try{queue=JSON.parse(localStorage.getItem('living-field-queue')||'[]');}catch{}\n  const assets=[\n    {id:'DEMO-OFC-021',name:'Office workstation',department:'Marketing',location:'Room M-03'},\n    {id:'DEMO-MCH-011',name:'Transfer pump',department:'Engineering',location:'Plant A'},\n    {id:'DEMO-VEH-003',name:'Operational vehicle',department:'Operations',location:'Main garage'}\n  ];\n  root.innerHTML=demoShell('FIELD COMPANION / OFFLINE-FIRST PROTOTYPE','A field record that can wait for the network.','Find an asset, record what you actually saw, and keep the handover traceable.',`\n    <div class=\"field-device\">\n      <aside><span class=\"device-label\">FIELD SESSION / 23 OCT 2026</span><button id=\"field-network\" aria-pressed=\"true\">Network / available</button><dl><div><dt>Assigned</dt><dd>${assets.length}</dd></div><div><dt>Local queue</dt><dd id=\"field-queue-count\">0</dd></div><div><dt>Synced</dt><dd id=\"field-synced-count\">0</dd></div></dl><button id=\"field-sync\" class=\"ink-button\">Sync queued records</button><p id=\"field-sync-note\" role=\"status\">Ready for field work.</p></aside>\n      <main><label class=\"field-search\">Inventory number<select id=\"field-asset\">${assets.map(a=>`<option value=\"${a.id}\">${a.id} / ${a.name}</option>`).join('')}</select></label><div id=\"field-asset-card\"></div><form id=\"field-capture\"><div class=\"form-pair\"><label>Observed condition<select name=\"condition\"><option>Good</option><option>Monitor</option><option>Needs repair</option><option>Not found</option></select></label><label>Location found<input name=\"location\" required maxlength=\"80\"></label></div><label>Observation note<textarea name=\"note\" rows=\"4\" maxlength=\"300\" placeholder=\"Write only what can be verified in the field.\"></textarea></label><label class=\"evidence-input\">Evidence photo <input name=\"photo\" type=\"file\" accept=\"image/jpeg,image/png\" capture=\"environment\"><small>The demo stores only the selected file name, never the image.</small></label><button class=\"ink-button\" type=\"submit\">Add to local queue</button></form><div id=\"field-queue\"></div></main>\n    </div>`);\n  const save=()=>{try{localStorage.setItem('living-field-queue',JSON.stringify(queue));}catch{}};\n  function drawAsset(){const a=assets.find(x=>x.id===$('#field-asset').value);$('#field-asset-card').innerHTML=`<span>ASSET FOUND</span><strong>${esc(a.name)}</strong><p>${esc(a.department)} / expected at ${esc(a.location)}</p>`;$('#field-capture [name=\"location\"]').value=a.location;}\n  function drawQueue(){const pending=queue.filter(x=>x.status==='Queued'),synced=queue.filter(x=>x.status==='Synced');$('#field-queue-count').textContent=pending.length;$('#field-synced-count').textContent=synced.length;$('#field-queue').innerHTML=queue.length?`<div class=\"field-log\"><span>LOCAL ACTIVITY</span>${queue.slice().reverse().map(r=>`<article><b>${esc(r.asset)}</b><span>${esc(r.condition)} / ${esc(r.location)}</span><small>${esc(r.time)} · ${esc(r.status)}${r.photo?' · '+esc(r.photo):''}</small></article>`).join('')}</div>`:'<p class=\"empty-note\">No observations recorded in this browser.</p>';}\n  $('#field-network').onclick=()=>{connected=!connected;const b=$('#field-network');b.setAttribute('aria-pressed',connected);b.textContent=connected?'Network / available':'Network / offline';$('#field-sync-note').textContent=connected?'Connection restored. Queued work is still under your control.':'Offline mode. New observations remain on this device.';};\n  $('#field-sync').onclick=()=>{if(!connected){$('#field-sync-note').textContent='Sync paused. Restore the network first.';return;}const pending=queue.filter(x=>x.status==='Queued');if(!pending.length){$('#field-sync-note').textContent='Nothing is waiting to sync.';return;}pending.forEach(x=>x.status='Synced');save();drawQueue();$('#field-sync-note').textContent=`${pending.length} record${pending.length===1?'':'s'} moved through the simulated sync queue.`;};\n  $('#field-asset').onchange=drawAsset;\n  $('#field-capture').onsubmit=e=>{e.preventDefault();if(!e.currentTarget.reportValidity())return;const f=new FormData(e.currentTarget),photo=e.currentTarget.elements.photo.files[0];queue.push({asset:$('#field-asset').value,condition:String(f.get('condition')),location:String(f.get('location')),note:String(f.get('note')),photo:photo?.name||'',time:new Date().toLocaleString('en-GB',{dateStyle:'medium',timeStyle:'short'}),status:'Queued'});save();drawQueue();e.currentTarget.elements.note.value='';e.currentTarget.elements.photo.value='';$('#field-sync-note').textContent=connected?'Observation queued. Sync it when the field session is ready.':'Observation saved locally while offline.';};\n  drawAsset();drawQueue();\n}\n\nconst prepSource=[\n  {id:'R-001',group:'Control',q1:4,q2r:2,q3:5,age:23},\n  {id:'R-002',group:'Program',q1:5,q2r:1,q3:5,age:22},\n  {id:'R-003',group:'Control',q1:3,q2r:99,q3:4,age:24},\n  {id:'R-003',group:'Control',q1:3,q2r:99,q3:4,age:24},\n  {id:'R-004',group:'Program',q1:2,q2r:5,q3:2,age:142},\n  {id:'R-005',group:'Program',q1:4,q2r:2,q3:4,age:21}\n];\n\nfunction dataPreparationDemo(){\n  const root=$('#next-wave-demo');let prepared=[];\n  root.innerHTML=demoShell('RESEARCH DATA / PREPARATION DESK','Clean decisions before statistical output.','Inspect missing codes, duplicate IDs, reverse-scored items, and implausible values before opening SPSS.',`\n    <div class=\"prep-layout\"><aside><label>Missing-value code<input id=\"prep-missing\" type=\"number\" value=\"99\"></label><label>Scale minimum<input id=\"prep-min\" type=\"number\" min=\"0\" value=\"1\"></label><label>Scale maximum<input id=\"prep-max\" type=\"number\" min=\"1\" value=\"5\"></label><label class=\"check-row\"><input id=\"prep-reverse\" type=\"checkbox\" checked> Reverse-score Q2R</label><button id=\"prep-run\" class=\"ink-button\">Prepare working copy</button><div id=\"prep-findings\"></div></aside><main><div class=\"desk-tabs\"><button data-prep-view=\"raw\" aria-pressed=\"true\">Raw import</button><button data-prep-view=\"clean\" aria-pressed=\"false\">Prepared copy</button><button data-prep-view=\"codebook\" aria-pressed=\"false\">Codebook</button></div><div id=\"prep-table\"></div><div class=\"desk-actions\"><button id=\"prep-csv\" disabled>Download prepared CSV</button><button id=\"prep-syntax\" disabled>Download SPSS syntax</button></div></main></div>`);\n  let view='raw';\n  function rowsTable(rows){return table(['Respondent','Group','Q1','Q2R','Q3','Age','Scale mean'],rows.map(r=>`<tr class=\"${r.issue?'review':''}\"><td>${esc(r.id)}</td><td>${esc(r.group)}</td><td>${r.q1}</td><td>${r.q2r===''?'Missing':r.q2r}</td><td>${r.q3}</td><td>${r.age}</td><td>${r.mean??'—'}</td></tr>`).join(''));}\n  function draw(){$$('[data-prep-view]').forEach(b=>b.setAttribute('aria-pressed',b.dataset.prepView===view));if(view==='raw')$('#prep-table').innerHTML=rowsTable(prepSource.map(r=>({...r,mean:'—',issue:r.q2r===99||r.age>100})));else if(view==='clean')$('#prep-table').innerHTML=prepared.length?rowsTable(prepared):'<p class=\"empty-note\">Run preparation to create a working copy.</p>';else $('#prep-table').innerHTML=table(['Variable','Label','Type','Values / rule'],[['id','Respondent identifier','String','Unique; duplicates flagged'],['group','Study group','Nominal','Control / Program'],['q1','Service clarity item','Scale','1–5'],['q2r','Delay/friction item','Scale','Reverse: 6 − value'],['q3','Confidence item','Scale','1–5'],['age','Age in years','Scale','Review values outside 15–100']].map(r=>`<tr>${r.map(v=>`<td>${esc(v)}</td>`).join('')}</tr>`).join(''));}\n  $('#prep-run').onclick=()=>{const missing=Number($('#prep-missing').value),min=Number($('#prep-min').value),max=Number($('#prep-max').value),seen=new Set(),issues=[];prepared=[];prepSource.forEach(r=>{if(seen.has(r.id)){issues.push(`Duplicate ${r.id} excluded from the working copy.`);return;}seen.add(r.id);const q2=r.q2r===missing?'':$('#prep-reverse').checked?max+min-r.q2r:r.q2r,valid=[r.q1,q2,r.q3].filter(v=>typeof v==='number'),mean=valid.length?(valid.reduce((a,b)=>a+b,0)/valid.length).toFixed(2):'';prepared.push({...r,q2r:q2,mean,issue:r.age<15||r.age>100});if(r.q2r===missing)issues.push(`${r.id}: Q2R changed from missing code to blank.`);if(r.age<15||r.age>100)issues.push(`${r.id}: age ${r.age} requires source verification.`);});$('#prep-findings').innerHTML=`<span>PREPARATION LOG</span><strong>${prepared.length} usable rows</strong>${issues.map(x=>`<p>${esc(x)}</p>`).join('')}`;$('#prep-csv').disabled=false;$('#prep-syntax').disabled=false;view='clean';draw();};\n  $$('[data-prep-view]').forEach(b=>b.onclick=()=>{view=b.dataset.prepView;draw();});\n  $('#prep-csv').onclick=()=>csvDownload('research-data-prepared-demo.csv',[['DEMONSTRATION DATA'],['id','group','q1','q2r','q3','age','scale_mean'],...prepared.map(r=>[r.id,r.group,r.q1,r.q2r,r.q3,r.age,r.mean])]);\n  $('#prep-syntax').onclick=()=>demoDownload('research-data-preparation-demo.sps',`* Demonstration syntax. Review variable names and file paths before use.\\nMISSING VALUES q1 q2r q3 (99).\\nRECODE q2r (1=5)(2=4)(3=3)(4=2)(5=1) INTO q2r_scored.\\nCOMPUTE scale_mean=MEAN.2(q1,q2r_scored,q3).\\nVARIABLE LABELS scale_mean 'Mean of available scale items'.\\nEXECUTE.\\n`);\n  draw();\n}\n\nfunction simplePdfBytes(lines){\n  const clean=value=>String(value??'').normalize('NFKD').replace(/[^\\x20-\\x7E]/g,' ').replace(/([\\\\()])/g,'\\\\$1');\n  const stream=['BT','/F1 15 Tf','55 780 Td'];\n  lines.forEach((line,index)=>{if(index){stream.push('0 -28 Td');stream.push(index===2?'/F1 20 Tf':'/F1 10 Tf');}stream.push(`(${clean(line)}) Tj`);});\n  stream.push('ET');const content=stream.join('\\n');\n  const objects=[\n    '<< /Type /Catalog /Pages 2 0 R >>',\n    '<< /Type /Pages /Kids [3 0 R] /Count 1 >>',\n    '<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Resources << /Font << /F1 4 0 R >> >> /Contents 5 0 R >>',\n    '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>',\n    `<< /Length ${content.length} >>\\nstream\\n${content}\\nendstream`\n  ];\n  let pdf='%PDF-1.4\\n',offsets=[0];objects.forEach((object,index)=>{offsets.push(pdf.length);pdf+=`${index+1} 0 obj\\n${object}\\nendobj\\n`;});const xref=pdf.length;pdf+=`xref\\n0 ${objects.length+1}\\n0000000000 65535 f \\n`;offsets.slice(1).forEach(offset=>pdf+=String(offset).padStart(10,'0')+' 00000 n \\n');pdf+=`trailer\\n<< /Size ${objects.length+1} /Root 1 0 R >>\\nstartxref\\n${xref}\\n%%EOF`;\n  return new TextEncoder().encode(pdf);\n}\n\nfunction documentAutomationDemo(){\n  const root=$('#next-wave-demo');\n  const serial=String(new Date().getUTCFullYear())+'/014';\n  root.innerHTML=demoShell('DOCUMENT AUTOMATION / CONTROLLED DRAFT','One source, several reliable outputs.','The document remains readable because the data model, template, approval state, and archive reference stay separate.',`\n    <div class=\"document-desk\"><form id=\"document-form\"><label>Document type<select name=\"type\"><option>Asset field review</option><option>Maintenance summary</option><option>Meeting minutes</option><option>Formal correspondence</option></select></label><label>Reference<input name=\"reference\" value=\"WBL/AST/${serial}\" required></label><label>Department<input name=\"department\" value=\"Asset Administration\" required maxlength=\"80\"></label><label>Prepared by<input name=\"owner\" value=\"Field Verification Team\" required maxlength=\"80\"></label><label class=\"wide\">Subject<input name=\"subject\" value=\"Follow-up for assets requiring field confirmation\" required maxlength=\"140\"></label><label class=\"wide\">Main note<textarea name=\"note\" rows=\"5\" maxlength=\"500\">Four records still require location confirmation. One equipment record needs a clearer specification from the responsible department.</textarea></label><button class=\"ink-button wide\" type=\"submit\">Refresh controlled draft</button></form><div><div class=\"paper-preview\" id=\"document-preview\"></div><div class=\"desk-actions\"><button id=\"document-pdf\">Generate sample PDF</button><button id=\"document-log\">Download archive log</button></div></div></div>`);\n  let draft={};\n  function update(e){e?.preventDefault();const form=$('#document-form');if(!form.reportValidity())return;draft=Object.fromEntries(new FormData(form));$('#document-preview').innerHTML=`<header><span>${esc(draft.reference)}</span><b>DRAFT / INTERNAL REVIEW</b></header><h4>${esc(draft.type)}</h4><p class=\"paper-subject\">${esc(draft.subject)}</p><dl><div><dt>Department</dt><dd>${esc(draft.department)}</dd></div><div><dt>Prepared by</dt><dd>${esc(draft.owner)}</dd></div><div><dt>Generated</dt><dd>${new Date().toLocaleDateString('en-GB',{dateStyle:'long'})}</dd></div></dl><p>${esc(draft.note)}</p><footer><span>Review status / Draft</span><span>Archive destination / DEMO-ASSET-REPORTS</span></footer>`;}\n  $('#document-form').onsubmit=update;update();\n  $('#document-log').onclick=()=>demoDownload('document-archive-log-demo.csv',`reference,type,department,status,generated_at\\n\"${draft.reference}\",\"${draft.type}\",\"${draft.department}\",Draft,\"${new Date().toISOString()}\"\\n`,'text/csv;charset=utf-8');\n  $('#document-pdf').onclick=()=>action($('#document-pdf'),()=>{const noteLines=String(draft.note).match(/.{1,78}(?:\\s|$)/g)||[''];const lines=['CONTROLLED DOCUMENT / DEMONSTRATION',draft.reference,draft.type.toUpperCase(),draft.subject,'Department: '+draft.department,'Prepared by: '+draft.owner,'Status: DRAFT / INTERNAL REVIEW','',...noteLines.map(x=>x.trim()),'','Synthetic document. No confidential records are included.'];demoDownload('controlled-document-demo.pdf',simplePdfBytes(lines),'application/pdf');});\n}\n\nfunction commerceOperationsDemo(){\n  const root=$('#next-wave-demo');\n  let inventory=[{sku:'NOTE-GRID',name:'Field Notes / Grid',stock:7,reorder:4,cost:39000,price:68000},{sku:'TRAY-GRAPH',name:'Desk Tray / Graphite',stock:3,reorder:4,cost:79000,price:129000},{sku:'BOT-SIGNAL',name:'Bottle / Signal',stock:1,reorder:3,cost:94000,price:158000},{sku:'TOTE-NAT',name:'Canvas Tote / Natural',stock:6,reorder:3,cost:112000,price:184000}];\n  let orders=[{id:'SERA-1041',customer:'Maya A.',items:2,total:252000,status:'Paid'},{id:'SERA-1042',customer:'Dion R.',items:1,total:158000,status:'Picking'},{id:'SERA-1043',customer:'Nadia P.',items:3,total:323000,status:'Packed'},{id:'SERA-1044',customer:'R. Putra',items:1,total:129000,status:'Return review'}];\n  const statuses=['Paid','Picking','Packed','Shipped'];\n  root.innerHTML=demoShell('SERA / OPERATIONS CONSOLE','The work after checkout.','Stock, fulfilment, exceptions, and margin live behind the storefront—not inside another decorative dashboard.',`<div class=\"ops-console\"><nav><button data-ops=\"orders\" aria-pressed=\"true\">Order desk</button><button data-ops=\"stock\" aria-pressed=\"false\">Stock ledger</button><button data-ops=\"summary\" aria-pressed=\"false\">Daily close</button></nav><div id=\"ops-view\"></div></div>`);\n  let view='orders';\n  function metrics(){const revenue=orders.filter(o=>o.status!=='Return review').reduce((s,o)=>s+o.total,0),low=inventory.filter(x=>x.stock<=x.reorder).length;return {revenue,low,open:orders.filter(o=>o.status!=='Shipped').length};}\n  function draw(){$$('[data-ops]').forEach(b=>b.setAttribute('aria-pressed',b.dataset.ops===view));const m=metrics();if(view==='orders')$('#ops-view').innerHTML=`<div class=\"console-strip\"><span>${m.open} OPEN</span><span>${money(m.revenue)} RECORDED</span><span>${orders.filter(o=>o.status==='Return review').length} EXCEPTION</span></div>${table(['Order','Customer','Items','Total','Current stage','Next action'],orders.map((o,i)=>`<tr class=\"${o.status==='Return review'?'review':''}\"><td>${o.id}</td><td>${o.customer}</td><td>${o.items}</td><td>${money(o.total)}</td><td>${o.status}</td><td><button data-order-next=\"${i}\">${o.status==='Return review'?'Resolve review':o.status==='Shipped'?'Completed':'Advance stage'}</button></td></tr>`).join(''))}`;else if(view==='stock')$('#ops-view').innerHTML=`<div class=\"stock-adjust\"><label>SKU<select id=\"stock-sku\">${inventory.map(x=>`<option>${x.sku}</option>`).join('')}</select></label><label>Movement<input id=\"stock-movement\" type=\"number\" value=\"1\" min=\"-20\" max=\"20\"></label><label>Reason<select id=\"stock-reason\"><option>Supplier receipt</option><option>Manual correction</option><option>Damaged item</option><option>Customer return</option></select></label><button id=\"stock-post\" class=\"ink-button\">Post movement</button></div>${table(['SKU','Product','On hand','Reorder point','Unit cost','Sale price','Gross margin','State'],inventory.map(x=>`<tr class=\"${x.stock<=x.reorder?'review':''}\"><td>${x.sku}</td><td>${x.name}</td><td>${x.stock}</td><td>${x.reorder}</td><td>${money(x.cost)}</td><td>${money(x.price)}</td><td>${Math.round((x.price-x.cost)/x.price*100)}%</td><td>${x.stock<=x.reorder?'Reorder':'Available'}</td></tr>`).join(''))}`;else $('#ops-view').innerHTML=`<div class=\"close-sheet\"><span>DAILY CLOSE / FICTIONAL STORE</span><strong>${money(m.revenue)}</strong><p>Recorded revenue across non-return orders</p><dl><div><dt>Orders in view</dt><dd>${orders.length}</dd></div><div><dt>Open fulfilment</dt><dd>${m.open}</dd></div><div><dt>Low-stock SKUs</dt><dd>${m.low}</dd></div><div><dt>Return reviews</dt><dd>${orders.filter(o=>o.status==='Return review').length}</dd></div></dl><button id=\"ops-export\">Export daily summary</button></div>`;bind();}\n  function bind(){$$('[data-order-next]').forEach(b=>b.onclick=()=>{const o=orders[Number(b.dataset.orderNext)];if(o.status==='Return review')o.status='Paid';else{const i=statuses.indexOf(o.status);o.status=statuses[Math.min(i+1,statuses.length-1)];}draw();});if($('#stock-post'))$('#stock-post').onclick=()=>{const item=inventory.find(x=>x.sku===$('#stock-sku').value),move=Number($('#stock-movement').value);if(!Number.isFinite(move)||item.stock+move<0){toast('That movement would create invalid stock.');return;}item.stock+=move;toast(`${item.sku}: ${move>0?'+':''}${move} / ${$('#stock-reason').value}`);draw();};if($('#ops-export'))$('#ops-export').onclick=()=>csvDownload('sera-operations-daily-close-demo.csv',[['DEMONSTRATION DATA'],['Order','Customer','Items','Total','Status'],...orders.map(o=>[o.id,o.customer,o.items,o.total,o.status]),[],['SKU','Product','Stock','Reorder point'],...inventory.map(x=>[x.sku,x.name,x.stock,x.reorder])]);}\n  $$('[data-ops]').forEach(b=>b.onclick=()=>{view=b.dataset.ops;draw();});draw();\n}\n\nfunction qualityEvidenceDemo(){\n  const root=$('#next-wave-demo');\n  root.innerHTML=demoShell('RELEASE REVIEW / BROWSER SELF-CHECK','Proof should be inspectable.','This is a local release check, not a fabricated Lighthouse score. It reports only what the current document can verify.',`<div class=\"quality-console\"><div class=\"quality-controls\"><label>Preview width <input id=\"quality-width\" type=\"range\" min=\"320\" max=\"1100\" value=\"880\"><output id=\"quality-width-value\">880 px</output></label><button id=\"quality-run\" class=\"ink-button\">Run document checks</button><button id=\"quality-copy\">Copy report</button></div><div class=\"quality-frame\" id=\"quality-frame\"><div><span>RESPONSIVE SAMPLE</span><h4>A useful layout survives a smaller screen.</h4><p>Type, spacing, and controls change together. Nothing important depends on hover.</p><button>Primary action</button><a href=\"#quality-results\">Read evidence</a></div><dl><div><dt>Input</dt><dd>Validated</dd></div><div><dt>State</dt><dd>Visible</dd></div><div><dt>Motion</dt><dd>Optional</dd></div></dl></div><div id=\"quality-results\" aria-live=\"polite\"></div></div>`);\n  let report='';\n  function run(){const checks=[['Skip link',!!document.querySelector('.skip'),'Keyboard users can bypass repeated navigation.'],['Main landmark',!!document.querySelector('main#main'),'The page exposes one primary content region.'],['Dialog labels',[...document.querySelectorAll('dialog')].every(d=>d.querySelector('[aria-label],h2')),'Modal surfaces have a discoverable name.'],['Reduced motion',matchMedia('(prefers-reduced-motion: reduce)').matches||document.documentElement.classList.contains('reduced')||document.documentElement.outerHTML.includes('living-motion'),'A motion preference path is available.'],['Table overflow',[...document.querySelectorAll('.table-scroll')].every(x=>x.tabIndex===0),'Wide evidence tables remain keyboard-scrollable.'],['Project URLs',data.projects.every(p=>p.slug&&p.name),'Every content object has a stable slug and name.'],['Synthetic labels',document.body.textContent.includes('Demonstration Data')||document.body.textContent.includes('DEMONSTRATION'),'Demonstration material is distinguished from verified work.']];report=checks.map(x=>`${x[1]?'PASS':'REVIEW'} / ${x[0]} / ${x[2]}`).join('\\n');$('#quality-results').innerHTML=`<div class=\"audit-list\">${checks.map(x=>`<article class=\"${x[1]?'pass':'review'}\"><b>${x[1]?'PASS':'REVIEW'}</b><strong>${x[0]}</strong><p>${x[2]}</p></article>`).join('')}</div><p class=\"disclosure\">These checks inspect semantics and interface safeguards in the current page. Network performance, Core Web Vitals, and cross-browser behavior still require external measurement.</p>`;}\n  $('#quality-width').oninput=e=>{const width=e.target.value;$('#quality-width-value').textContent=width+' px';$('#quality-frame').style.width=Math.min(width,root.clientWidth)+'px';};$('#quality-run').onclick=run;$('#quality-copy').onclick=()=>navigator.clipboard?.writeText(report).then(()=>toast('Release report copied.')).catch(()=>demoDownload('release-check.txt',report));run();\n}\n\nfunction scopeBuilderDemo(){\n  const root=$('#next-wave-demo');\n  const deliverables={Website:['Responsive interface','Content editor','Deployment notes','Accessibility review'],Data:['Clean workbook','Calculation notes','Exception report','Handover guide'],Research:['Method review','Data preparation','Analysis notes','Defense preparation'],Automation:['Process map','Apps Script workflow','Audit log','Maintenance notes']};\n  root.innerHTML=demoShell('PROJECT INTAKE / SCOPE BUILDER','A better conversation starts with a useful brief.','Choose what matters, name the boundary, and leave with a message that is ready to discuss—not an invented instant quote.',`<div class=\"scope-desk\"><form id=\"scope-form\"><label>Work area<select name=\"area\" id=\"scope-area\">${Object.keys(deliverables).map(x=>`<option>${x}</option>`).join('')}</select></label><label>Current stage<select name=\"stage\"><option>Only an idea</option><option>Existing files or system</option><option>Partially working</option><option>Needs repair or expansion</option></select></label><label>Preferred timeline<select name=\"timeline\"><option>Flexible</option><option>Within two weeks</option><option>Within one month</option><option>Specific date</option></select></label><label>Working environment<select name=\"environment\"><option>Google Workspace</option><option>Vercel and web</option><option>Excel or local files</option><option>Still deciding</option></select></label><fieldset class=\"wide\"><legend>Useful handover</legend><div id=\"scope-deliverables\"></div></fieldset><label class=\"wide\">What is difficult right now?<textarea name=\"problem\" rows=\"5\" maxlength=\"500\" required placeholder=\"A short, practical description is enough.\"></textarea></label><label class=\"wide\">What should remain out of scope?<input name=\"boundary\" maxlength=\"180\" placeholder=\"For example: no payment integration in the first release.\"></label><button class=\"ink-button wide\" type=\"submit\">Prepare project brief</button></form><div id=\"scope-output\"><span>BRIEF PREVIEW</span><p>Your choices will appear here. No price or deadline is guessed before the work is reviewed.</p></div></div>`);\n  let message='';\n  function drawOptions(){const area=$('#scope-area').value;$('#scope-deliverables').innerHTML=deliverables[area].map((x,i)=>`<label><input type=\"checkbox\" name=\"deliverable\" value=\"${esc(x)}\" ${i<2?'checked':''}> ${esc(x)}</label>`).join('');}\n  drawOptions();$('#scope-area').onchange=drawOptions;\n  $('#scope-form').onsubmit=e=>{e.preventDefault();if(!e.currentTarget.reportValidity())return;const f=new FormData(e.currentTarget),items=f.getAll('deliverable');message=['Hello Kevin, I would like to discuss a project.','',`Work area: ${f.get('area')}`,`Current stage: ${f.get('stage')}`,`Preferred timeline: ${f.get('timeline')}`,`Environment: ${f.get('environment')}`,`Useful handover: ${items.join(', ')||'To be discussed'}`,'',`Current problem: ${f.get('problem')}`,`Out of scope: ${f.get('boundary')||'To be discussed'}`,'','I understand the scope, timeline, and cost still need to be reviewed together.'].join('\\n');const email=data.settings?.email||'simatupangkevin9@gmail.com',phone=String(data.settings?.whatsapp||'').replace(/\\D/g,'');$('#scope-output').innerHTML=`<span>PROJECT BRIEF / READY TO REVIEW</span><h4>${esc(f.get('area'))}</h4><dl><div><dt>Stage</dt><dd>${esc(f.get('stage'))}</dd></div><div><dt>Timeline</dt><dd>${esc(f.get('timeline'))}</dd></div><div><dt>Handover</dt><dd>${items.map(esc).join(' / ')||'To be discussed'}</dd></div></dl><p>${esc(f.get('problem'))}</p><div class=\"desk-actions\"><button id=\"scope-copy\">Copy brief</button><a class=\"ink-button\" href=\"${phone?'https:\\x2f\\x2fwa.me/'+phone+'?text='+encodeURIComponent(message):'mailto:'+encodeURIComponent(email)+'?subject='+encodeURIComponent('Project discussion')+'&body='+encodeURIComponent(message)}\" target=\"_blank\" rel=\"noopener\">Continue the conversation</a></div>`;$('#scope-copy').onclick=()=>navigator.clipboard?.writeText(message).then(()=>toast('Project brief copied.')).catch(()=>demoDownload('project-brief.txt',message));};\n}\n\nfunction initImmersion(){\n  const html=document.documentElement,header=$('.header');\n  if(!$('.living-progress'))document.body.insertAdjacentHTML('afterbegin','<div class=\"living-progress\" aria-hidden=\"true\"></div><div class=\"living-halo\" aria-hidden=\"true\"></div><div class=\"space-index\" aria-hidden=\"true\"><span></span><b>SPACE 00</b><span></span></div>');\n  const sections=[...document.querySelectorAll('main section[id]')];\n  const rail=$('.space-index');\n  if(rail&&sections.length)rail.innerHTML='<span></span><b>SPACE 00</b>'+sections.slice(0,8).map((_,i)=>`<i class=\"${i===0?'is-current':''}\" data-space=\"${i}\"></i>`).join('')+'<span></span>';\n  const revealTargets=$$('.section-heading,.exhibit,.workspace,.experiment,.profile-grid,.capability,.connect h2,.connect-actions,.case-copy,.case-visual');\n  revealTargets.forEach((el,i)=>{el.classList.add('motion-reveal');el.style.transitionDelay=Math.min(i%4,3)*45+'ms';});\n  if(window.__livingObserver)window.__livingObserver.disconnect();\n  window.__livingObserver=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting){entry.target.classList.add('is-visible');if(entry.target.matches('section[id]'))setCurrentSpace(entry.target,sections);}}),{rootMargin:'-12% 0px -18%',threshold:.08});\n  [...sections,...revealTargets].forEach(el=>window.__livingObserver.observe(el));\n  initDemoDepth();\n  if(document.body.dataset.immersionBound)return;\n  document.body.dataset.immersionBound='true';\n  let frame=0;\n  document.addEventListener('pointermove',event=>{if(reduced||event.pointerType==='touch')return;cancelAnimationFrame(frame);frame=requestAnimationFrame(()=>{html.style.setProperty('--pointer-x',event.clientX+'px');html.style.setProperty('--pointer-y',event.clientY+'px');const arrival=event.target.closest('.arrival');if(arrival){const rect=arrival.getBoundingClientRect();html.style.setProperty('--hero-x',((event.clientX-rect.left)/rect.width-.5).toFixed(3));html.style.setProperty('--hero-y',((event.clientY-rect.top)/rect.height-.5).toFixed(3));}const card=event.target.closest('.exhibit');if(card){const rect=card.getBoundingClientRect();card.style.setProperty('--tilt-x',(((event.clientX-rect.left)/rect.width-.5)*4).toFixed(2));card.style.setProperty('--tilt-y',(((event.clientY-rect.top)/rect.height-.5)*4).toFixed(2));}});});\n  document.addEventListener('pointerout',event=>{const card=event.target.closest?.('.exhibit');if(card&&!card.contains(event.relatedTarget)){card.style.removeProperty('--tilt-x');card.style.removeProperty('--tilt-y');}});\n  const updateScroll=()=>{const max=document.documentElement.scrollHeight-innerHeight,progress=max>0?(scrollY/max)*100:0;html.style.setProperty('--scroll-progress',progress+'%');header?.classList.toggle('is-scrolled',scrollY>24);};\n  addEventListener('scroll',updateScroll,{passive:true});updateScroll();\n}\nfunction setCurrentSpace(section,sections){\n  const index=Math.max(0,sections.indexOf(section)),rail=$('.space-index');\n  if(rail){const label=rail.querySelector('b');if(label)label.textContent='SPACE '+String(index).padStart(2,'0');rail.querySelectorAll('i').forEach((dot,i)=>dot.classList.toggle('is-current',i===index));}\n  $$('.header nav a').forEach(link=>link.classList.toggle('is-current',link.getAttribute('href')==='#'+section.id));\n}\n\nfunction initDemoDepth(){\n  const stages=[...document.querySelectorAll('[data-demo-stage],#booking-demo,#archive-demo,#commerce-demo,.research-toolkit,.data-lab .workspace')];\n  stages.forEach((stage,index)=>{\n    stage.classList.add('spatial-demo');\n    stage.style.setProperty('--stage-index',String(index+1).padStart(2,'0'));\n    if(!stage.querySelector(':scope > .spatial-coordinate'))stage.insertAdjacentHTML('afterbegin','<div class=\"spatial-coordinate\" aria-hidden=\"true\"><span>LIVE WORKSPACE</span><b>00 / 00 / 00</b></div>');\n    const planeSets=[\n      ['.working-demo-head,.commerce-notice,.commerce-store-head,.toolkit-heading,.workspace-heading,.simulation-label','depth-plane depth-plane--label'],\n      ['.field-device>aside,.prep-layout>aside,.document-desk>form,.scope-desk>form,.quality-controls,.ops-console>nav,.commerce-toolbar,.commerce-categories,.commerce-checkout>form,.toolkit-tabs,.lab-controls,.archive-controls,.booking-form','depth-plane depth-plane--input'],\n      ['.field-device>main,.prep-layout>main,.paper-preview,#scope-output,#quality-frame,#quality-results,#ops-view,.commerce-grid,.commerce-cart,.commerce-order,.toolkit-workspace,.lab-stats,.table-scroll,.calendar,.cleanup>div,.archive-list,.booking-summary','depth-plane depth-plane--output']\n    ];\n    planeSets.forEach(([selector,names])=>stage.querySelectorAll(selector).forEach(el=>el.classList.add(...names.split(' '))));\n    if(stage.dataset.depthBound)return;\n    stage.dataset.depthBound='true';\n    let frame=0;\n    const reset=()=>{stage.style.setProperty('--depth-rx','.55deg');stage.style.setProperty('--depth-ry','-.65deg');stage.style.setProperty('--depth-x','50%');stage.style.setProperty('--depth-y','50%');};\n    stage.addEventListener('pointermove',event=>{\n      if(reduced||event.pointerType==='touch'||matchMedia('(pointer: coarse)').matches)return;\n      const rect=stage.getBoundingClientRect(),x=(event.clientX-rect.left)/rect.width,y=(event.clientY-rect.top)/rect.height;\n      cancelAnimationFrame(frame);frame=requestAnimationFrame(()=>{\n        stage.style.setProperty('--depth-rx',((.5-y)*2.2).toFixed(2)+'deg');\n        stage.style.setProperty('--depth-ry',((x-.5)*2.8).toFixed(2)+'deg');\n        stage.style.setProperty('--depth-x',(x*100).toFixed(1)+'%');\n        stage.style.setProperty('--depth-y',(y*100).toFixed(1)+'%');\n        const coordinate=stage.querySelector(':scope > .spatial-coordinate b');\n        if(coordinate)coordinate.textContent=String(Math.round(x*99)).padStart(2,'0')+' / '+String(Math.round(y*99)).padStart(2,'0')+' / '+String(index+1).padStart(2,'0');\n      });\n    });\n    stage.addEventListener('pointerleave',reset);\n    stage.addEventListener('focusin',event=>{stage.classList.add('has-depth-focus');event.target.closest('.depth-plane')?.classList.add('is-depth-active');});\n    stage.addEventListener('focusout',event=>{event.target.closest('.depth-plane')?.classList.remove('is-depth-active');if(!stage.contains(event.relatedTarget))stage.classList.remove('has-depth-focus');});\n    reset();\n  });\n}\n\nfunction admin(){document.body.classList.remove('focus-reading');$('#main').innerHTML=`<article class=\"admin-page\"><span class=\"eyebrow\">OWNER WORKSPACE / GOOGLE APPS SCRIPT</span><h1>Keep it growing.</h1><p>Projects, media, and your current resume. Every write is checked on the server.</p><div class=\"admin-toolbar\"><button id=\"new-project\" class=\"solid-button\">Add a project +</button><a class=\"text-link\" href=\"${esc(data.databaseUrl)}\" target=\"_blank\" rel=\"noopener\">Open content spreadsheet ↗</a><a class=\"text-link\" href=\"${esc(data.appUrl)}\" target=\"_top\">View public site ↗</a><button id=\"refresh-admin\">Refresh content</button></div><div class=\"admin-panel\"><h2>Exhibits</h2><div class=\"admin-list\">${data.projects.map(p=>`<button data-edit=\"${esc(p.id)}\"><span>${esc(p.name)}</span><span>${esc(p.visibility)} · ${p.featured?'Featured · ':''}${p.order} ↗</span></button>`).join('')}</div></div><div id=\"project-editor\"></div><div class=\"admin-panel\"><h2>Resume</h2><p class=\"admin-help\">PDF only, maximum 5 MB. Uploads are private drafts. Publishing exposes the selected PDF through the website; other versions stay private.</p><div class=\"drop-zone\" id=\"resume-drop\"><label for=\"resume-upload\">Choose a PDF or drop it here</label><br><input id=\"resume-upload\" type=\"file\" accept=\"application/pdf,.pdf\"><p id=\"upload-message\" role=\"status\"></p></div><div class=\"admin-list\" style=\"margin-top:20px\">${(data.resumes||[]).map(r=>`<div class=\"admin-toolbar\"><span>${esc(r.name)} · ${esc(String(r.uploadedAt).slice(0