tuck.</h3><p>Keep it short. The site will turn your answers into a clear WhatsApp message. Nothing you type here is stored on this website.</p><div class=\"method-helper\"><label>Main goal<select id=\"research-goal\"><option value=\"\">Choose a goal</option><option>Test a relationship or effect</option><option>Compare groups</option><option>Review a questionnaire</option><option>Plan or improve the research structure</option><option>Organize the results and report</option></select></label><label>Data type<select id=\"research-data-type\"><option value=\"\">Choose a data type</option><option>Numbers or scales</option><option>Categories</option><option>Not sure yet</option></select></label><p id=\"method-hint\" role=\"status\">Choose a goal and data type to see an initial direction.</p></div></div><form id=\"research-intake-form\"><label>Current stage<select name=\"stage\" required><option value=\"\">Choose a stage</option><option>Planning the proposal</option><option>Writing or revising the research</option><option>Designing the questionnaire</option><option>Data already collected</option><option>Analyzing the results</option><option>Preparing for the defense</option></select></label><label>What do you need?<select name=\"need\" required><option value=\"\">Choose one</option><option>SPSS data analysis</option><option>Research method review</option><option>Research structure and writing review</option><option>Result interpretation</option><option>Document formatting</option><option>Defense presentation</option><option>Not sure — I want to discuss it first</option></select></label><label>Number of respondents<input name=\"sample\" inputmode=\"numeric\" maxlength=\"6\" placeholder=\"For example: 120\"></label><label>Target date<input name=\"deadline\" type=\"date\"></label><label class=\"wide\">A little context<textarea name=\"note\" maxlength=\"600\" rows=\"5\" placeholder=\"For example: the data is ready, but I am still unsure which test to use and how to explain the regression result.\"></textarea></label><button class=\"dark-button wide\" type=\"submit\">Prepare my consultation message ↗</button><div class=\"intake-result wide\" id=\"intake-result\" hidden><p id=\"intake-summary\"></p><a class=\"solid-button\" id=\"intake-contact\" target=\"_blank\" rel=\"noopener\">Continue on WhatsApp ↗</a></div></form>`;}\nfunction researchRows(r){return `<div class=\"research-table\"><table><thead><tr>${r.headers.map(x=>`<th>${esc(x)}</th>`).join('')}</tr></thead><tbody>${r.rows.map(row=>`<tr>${row.map(x=>`<td>${esc(x)}</td>`).join('')}</tr>`).join('')}</tbody></table></div>`;}\nfunction researchDataset(i){if(i===0)return [['DEMONSTRATION DATA'],['respondent','Q01','Q02','Q03','Q04'],['R001',4,4,3,5],['R002',3,4,2,4],['R003',5,5,4,5],['R004',2,3,2,3],['R005',4,3,3,4]];if(i===1)return [['DEMONSTRATION DATA'],['respondent','service_quality','access_ease','outcome'],['R001',4.2,3.8,4.4],['R002',3.5,3.2,3.6],['R003',4.8,4.1,4.9],['R004',2.9,3.4,3.1],['R005',4.0,4.4,4.3]];if(i===2)return [['DEMONSTRATION DATA'],['respondent','group','score'],['R001','Method A',79],['R002','Method A',82],['R003','Method B',73],['R004','Method B',76],['R005','Method A',74],['R006','Method B',70]];return [['DEMONSTRATION DATA'],['section','purpose','question'],...researchCases[i].rows];}\nfunction renderResearch(i=0){state.research=i;remember();$$('[data-research]').forEach(b=>b.setAttribute('aria-pressed',Number(b.dataset.research)===i));const r=researchCases[i];$('#research-output').innerHTML=`<span class=\"eyebrow\">INTERACTIVE DEMO / SYNTHETIC DATA</span><h3>${r.title}</h3><p>${r.summary}</p><div class=\"research-metrics\">${r.metrics.map(m=>`<div><strong>${m[0]}</strong><span>${m[1]}</span></div>`).join('')}</div>${researchRows(r)}<div class=\"research-proof\"><span>${r.method}</span>${r.outputs.map(x=>`<small>✓ ${x}</small>`).join('')}</div><div class=\"research-actions\"><button id=\"research-dataset\">Download sample data ↓</button><button id=\"research-notes\">Download analysis notes ↓</button></div><p class=\"disclosure\">This is a learning example built with fictional data. The numbers do not come from a client, university, or real thesis.</p>`;$('#research-dataset').onclick=()=>Engine.csvDownload(`research-demo-${i+1}.csv`,researchDataset(i));$('#research-notes').onclick=()=>{const text=`RESEARCH SUPPORT DEMO\\nSynthetic data, not a client research result.\\n\\nCase: ${r.title}\\nMethod: ${r.method}\\n\\nWhat is reviewed:\\n- ${r.outputs.join('\\n- ')}\\n\\nNotes:\\n${r.summary}\\n\\nEvery result still needs to be read against the research design, data quality, and limitations.`;Engine.downloadBlob(`analysis-notes-${i+1}.txt`,new Blob([text],{type:'text/plain;charset=utf-8'}));};}\nfunction servicesSection(){const groups=[{title:'Research support',fit:'For students who want to understand their method, data, writing, and results more clearly.',items:['Method and research-plan review','SPSS analysis that fits the question','Outline, argument, citation, and draft review','Tables, document formatting, and defense slides'],not:'No fabricated data, impersonation, or ghostwritten submission.',href:'#research-intake'},{title:'Data & Excel',fit:'For work that still feels scattered, repetitive, or difficult to verify.',items:['Data cleanup and reconciliation','Dashboards and automated reports','Formulas, validation, and usable files','Google Sheets and Apps Script'],not:'The scope is confirmed after a sample of the data is reviewed.',href:'#lab'},{title:'Websites & systems',fit:'For organizations or small businesses that need a clearer digital workflow.',items:['Responsive, maintainable websites','Dashboards, forms, and authentication','API and cloud integrations','Documentation and deployment'],not:'Hosting and third-party service costs are discussed separately.',href:'#connect'}];return `<section class=\"services-studio\" id=\"services\">${sectionLabel('04','WAYS TO WORK TOGETHER','RESEARCH / DATA / WEBSITES')}<div class=\"section-heading\"><h2>Start with the problem.<br><i>Not a forced package.</i></h2><p>Share what is happening first. Then we can decide what genuinely needs to be built, cleaned up, reviewed, or tested.</p></div><div class=\"service-lanes\">${groups.map((g,i)=>`<article><span class=\"eyebrow\">0${i+1} / SERVICE</span><h3>${g.title}</h3><p>${g.fit}</p><ul>${g.items.map(x=>`<li>${x}</li>`).join('')}</ul><small>${g.not}</small><a class=\"text-link\" href=\"${g.href}\">See how it works <span>↗</span></a></article>`).join('')}</div><div class=\"work-steps\"><span class=\"eyebrow\">A SIMPLE WORKING PROCESS</span>${[['01','Tell me','Share the context, a sample file, or a quick outline of what you need.'],['02','Review','We check the scope, risks, and what a sensible outcome looks like.'],['03','Build','Progress stays visible, and important decisions are explained as we go.'],['04','Hand over','You receive the finished work, source files, and clear notes on how to use it.']].map(x=>`<div><b>${x[0]}</b><strong>${x[1]}</strong><p>${x[2]}</p></div>`).join('')}</div></section>`;}\nfunction dataProof(){return `<div class=\"data-proof\"><span class=\"eyebrow\">FILES YOU CAN ACTUALLY CHECK</span><div><small>Formula-based reconciliation workbook</small><small>Validation and budget exports</small><small>Maintenance PDF bundle</small><small>Generated scheduling workbook</small><small>Cleaned-data CSV</small><small>Calculation notes in every module</small></div></div>`;}\nfunction numberSpaces(){[['open-lab','05'],['experiments','06'],['profile','07'],['connect','08']].forEach(([id,n])=>{const label=document.querySelector(`#${id} .section-label span`);if(label)label.textContent=label.textContent.replace(/^\\d+/,n)});const total=$('.hero-foot span:last-child');if(total)total.textContent='01 / 09 ↓';}\nfunction home(){document.body.classList.remove('focus-reading');$('#main').innerHTML=`<section class=\"arrival entrance\" id=\"home\"><div class=\"section-label mono\"><span><i class=\"signal\"></i>THE LIVING INDEX — VOL. 01</span><span>WEB SYSTEMS / OPERATIONAL DATA / INTERFACE DESIGN</span></div><h1 class=\"name-display\"><span>KEVIN</span><span>SIMATUPANG<b>.</b></span></h1><div class=\"arrival-bottom\"><div class=\"arrival-intro\"><span class=\"eyebrow\">FULL-STACK DEVELOPER / BALIKPAPAN</span><p>I build web systems, structured data workflows, and interfaces that make complicated work easier to understand.</p><div class=\"arrival-actions\"><a class=\"text-link\" href=\"#field\">View real work <span>↓</span></a><a class=\"text-link\" href=\"#resume\">Resume <span>↗</span></a></div><div class=\"visitor-paths\" aria-label=\"Quick paths\"><a href=\"#field\"><b>Hiring?</b><span>Start with verified work.</span></a><a href=\"#lab\"><b>Operational problem?</b><span>Open the Data Lab.</span></a><a href=\"#research\"><b>Research stuck?</b><span>See ethical support.</span></a></div></div><div class=\"instrument\"><div class=\"instrument-tabs\">${['Systems','Data','Design'].map((x,i)=>`<button data-layer=\"${i}\" aria-pressed=\"${i===0}\"><small>0${i+1}</small>${x}</button>`).join('')}</div><a class=\"instrument-surface\" href=\"#field\" id=\"instrument-content\"></a></div></div><div class=\"hero-foot mono\"><span>SCROLL TO DISCOVER</span><span>BUILT TO KEEP EVOLVING</span><span>01 / 08 ↓</span></div></section><section id=\"field\">${sectionLabel('01','THE WORK UNIVERSE',`${String(data.projects.length).padStart(2,'0')} ENTRIES / CURATED BY EVIDENCE`)}<div class=\"section-heading\"><h2>Real work first.<br><i>Experiments when useful.</i></h2><p>Production projects lead the story. Demonstrations and concepts remain clearly labelled in their own collections.</p></div><div class=\"collection-switch\" aria-label=\"Project collections\">${[['selected','Selected real work'],['lab','Systems & data lab'],['experiments','Experiments'],['all','Complete index']].map(([key,label])=>`<button data-collection=\"${key}\" aria-pressed=\"${state.collection===key}\">${label}</button>`).join('')}</div><div class=\"toolbar\"><div class=\"filters\">${['All work',...new Set(data.projects.map(p=>p.category))].map(x=>`<button data-filter=\"${esc(x)}\" aria-pressed=\"${state.category===x}\">${esc(x)}</button>`).join('')}</div><div class=\"view-switch\"><button data-view=\"atlas\" aria-pressed=\"${state.view==='atlas'}\">▦ Atlas</button><button data-view=\"index\" aria-pressed=\"${state.view==='index'}\">☰ Index</button></div></div><div class=\"search-row\"><label class=\"sr-only\" for=\"work-query\">Search projects or technologies</label><input id=\"work-query\" placeholder=\"Search projects, tools, or disciplines…\" value=\"${esc(state.query)}\"><span class=\"mono\" id=\"result-count\" aria-live=\"polite\"></span></div><div id=\"exhibition\"></div></section><section class=\"data-lab\" id=\"lab\">${sectionLabel('02','THE DATA LAB','DEMONSTRATION DATA')}<div class=\"section-heading\"><h2>Messy in.<br><i>Clarity out.</i></h2><p>No perfect datasets here.<br>Just familiar problems, working logic,<br>and a better way through.</p></div><div class=\"lab-tabs\">${['Reconciliation','Field validation','Budget & actual','Maintenance','Scheduling','Data cleanup'].map((x,i)=>`<button data-lab=\"${i}\" aria-pressed=\"${state.lab===i}\"><span>0${i+1}</span>${x}</button>`).join('')}</div><div class=\"workspace\" id=\"workspace\"></div><p class=\"disclosure\">All records are fictional. Starting scenarios are illustrative, not original client files. Calculations run locally in your browser.</p></section><section class=\"open-lab\" id=\"open-lab\">${sectionLabel('03','OPEN LAB','SMALL EXPERIMENTS / REAL BEHAVIOR')}<div class=\"section-heading\"><h2>Go on.<br><i>Touch the controls.</i></h2><p>Design is a set of decisions.<br>Move one. See what changes.</p></div><div class=\"playground\"><div class=\"control-list\"><label>Type scale<input id=\"type-scale\" type=\"range\" min=\"28\" max=\"66\" value=\"48\"></label><label>Spacing<input id=\"spacing\" type=\"range\" min=\"18\" max=\"60\" value=\"40\"></label><label>Preview width<input id=\"preview-width\" type=\"range\" min=\"280\" max=\"850\" value=\"850\"></label><label>Contrast<select id=\"contrast\"><option value=\"light\">Light / forest</option><option value=\"dark\">Dark / bone</option></select></label><button id=\"play-reset\">Reset composition ↺</button></div><div class=\"play-preview\" id=\"play-preview\"><div class=\"play-meta\"><span>GALILEA / INTERFACE STUDY</span><span>01</span></div><h3 id=\"play-title\">A shared place.<br>An open invitation.</h3><p>Small details make a system feel easier to use. This is a real responsive composition, not an image.</p></div></div><div class=\"architecture-nodes\" id=\"architecture\">${['Browser','API gateway','Authentication','Data service','Response'].map((x,i)=>`<button data-node=\"${i}\" aria-pressed=\"${i===0}\">${String(i+1).padStart(2,'0')} / ${x}</button>`).join('')}</div><p class=\"architecture-note\" id=\"architecture-note\"></p></section><section id=\"experiments\">${sectionLabel('04','SELECTED EXPERIMENTS','CONCEPTS / WORKING STUDIES')}<div class=\"section-heading\"><h2>Room for<br><i>the unexpected.</i></h2><p>A few small studies beyond the usual boundaries of a web project.</p></div><div class=\"experiments-list\"><article class=\"experiment\"><span class=\"eyebrow\">01 / KINETIC TYPOGRAPHY — CONCEPT</span><div class=\"type-demo\" id=\"type-demo\">Make room.</div><label class=\"eyebrow\" for=\"letter-space\">Change the rhythm</label><input id=\"letter-space\" type=\"range\" min=\"-5\" max=\"12\" value=\"-3\"><p>Spacing changes the voice of a phrase. A restrained, keyboard-accessible type study.</p></article><article class=\"experiment\"><span class=\"eyebrow\">02 / DOCUMENT SYSTEMS — DEMONSTRATION</span><h3>Information needs a hierarchy.</h3><p>An illustrative starting scenario and a structured report layout.</p><div class=\"comparison\"><div>weekly report<br>assets 51 done 31<br>check pump location<br>next inspection friday</div><div class=\"after\"><b>FIELD REVIEW</b><hr>31 / 51 verified<br><br><b>Next action</b><br>Confirm pump location.</div></div></article><article class=\"experiment\"><span class=\"eyebrow\">03 / PRESENTATION — DEMONSTRATION</span><h3>One thought. Enough space.</h3><p>A presentation study that adapts to a fullscreen display.</p><button id=\"presentation-open\" style=\"margin-top:20px\">Open presentation ↗</button></article><article class=\"experiment\"><span class=\"eyebrow\">04 / WORKFLOW — CONCEPT</span><h3>A smaller, clearer community.</h3><p>A Discord information architecture study: announcements, shared chat, and temporary two-person voice rooms. This is a workflow concept, not a connected bot.</p><details style=\"margin-top:20px\"><summary>Inspect the workflow</summary><p>Join a voice lobby → bot creates a private room → cap at two members → remove room when empty. Permissions and bot hosting still require implementation.</p></details></article></div></section><section id=\"profile\">${sectionLabel('05','THE HUMAN BEHIND THE SYSTEM','KEVIN SIMATUPANG')}<div class=\"profile-grid\"><div><div class=\"profile-mark\">k↗</div><span class=\"mono\">BASED IN BALIKPAPAN<br>EAST KALIMANTAN, INDONESIA</span></div><div class=\"profile-copy\"><h2>Curiosity.<br><i>With structure.</i></h2><p>I like the moment a complicated process starts making sense. Sometimes that means a website. Sometimes it is a spreadsheet, a better workflow, or a detail nobody noticed until it worked.</p><dl><div><dt>CURRENT EMPLOYMENT</dt><dd>PT. Wulandari Bangun Laksana<br>February 2026 — Present</dd></div><div><dt>EARLIER EXPERIENCE</dt><dd>IT Support Intern<br>PT. Wulandari Bangun Laksana</dd></div><div><dt>EDUCATION</dt><dd>Bachelor’s Degree<br>Informatics Engineering</dd></div><div><dt>ACADEMIC RESULT</dt><dd>GPA 3.84 / 4.00</dd></div><div><dt>WORKING ACROSS</dt><dd>Web, data, operations,<br>and interface design</dd></div><div><dt>THE APPROACH</dt><dd>Understand the problem.<br>Build something useful.</dd></div></dl><a href=\"#resume\" class=\"text-link\" style=\"margin-top:30px\">View resume <span>↗</span></a></div></div><div class=\"capability\"><span class=\"eyebrow\">FOLLOW A CAPABILITY TO THE WORK</span>${['Web Engineering','Cloud & APIs','Data & Automation','UI/UX','Visual Communication'].map((x,i)=>`<button data-skill=\"${x}\" aria-pressed=\"${i===0}\">${x}</button>`).join('')}<div class=\"capability-results\" id=\"capability-results\"></div></div></section><section class=\"connect\" id=\"connect\">${sectionLabel('06','AN OPEN CONVERSATION','WHAT ARE YOU WORKING ON?')}<h2>Have something<br>difficult?<br><i>Let’s make sense of it.</i></h2><div class=\"connect-actions\" id=\"contact-links\"></div><p class=\"connect-note\">Web systems, clearer data, and the work in between.</p></section>`;\napplyResearchStyles();$('#lab .disclosure').insertAdjacentHTML('beforebegin',dataProof());$('#lab').insertAdjacentHTML('afterend',researchSection());$('#research').insertAdjacentHTML('afterend',servicesSection());numberSpaces();layer(0);renderWork();renderLab();renderResearch(state.research);bindHome();bindResearch();renderContact();capability('Web Engineering');architecture(0);hydrateMedia();}\nfunction layer(i){const layers=[['INTERFACE','PROCESS','STRUCTURE','From scattered pieces to a shared place.','#field'],['OBSERVE','RECONCILE','UNDERSTAND','A little less guesswork. A lot more clarity.','#lab'],['COMPOSITION','BEHAVIOR','FEELING','The small details change the whole experience.','#experiments']];const l=layers[i];$('#instrument-content').href=l[4];$('#instrument-content').innerHTML=l.slice(0,3).map((n,j)=>`<div class=\"plane\" style=\"--n:${j}\"><span>${n}</span><b>0${j+1}</b></div>`).join('')+`<p>${l[3]} ↗</p>`;$$('[data-layer]').forEach(b=>b.setAttribute('aria-pressed',Number(b.dataset.layer)===i));}\nfunction renderWork(){const query=state.query.trim().toLowerCase();const collection=p=>query||state.collection==='all'?true:state.collection==='selec