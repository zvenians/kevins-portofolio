ct id=\"cleanup-locale\"><option value=\"id-ID\" ${cleanupLocale==='id-ID'?'selected':''}>Indonesian: 1.234,56</option><option value=\"en-US\" ${cleanupLocale==='en-US'?'selected':''}>International: 1,234.56</option></select></label>${table(['Normalized value','Finding'],rows.map(r=>`<tr><td>${r.value===null?'—':esc(r.value)}</td><td>${esc(r.finding)}</td></tr>`).join(''))}</div></div><p class=\"calculation\">No silent locale guessing. Invalid and empty values stay unresolved; zero stays zero. Repeated numeric values are flagged for review, never automatically deleted as duplicate records.</p>`;$('#cleanup-text').onchange=e=>{cleanupText=e.target.value;cleanup()};$('#cleanup-locale').onchange=e=>{cleanupLocale=e.target.value;cleanup()};$('#cleanup-export').onclick=()=>csvDownload('cleanup-demo.csv',[['Demonstration Data'],['Raw','Normalized','Finding'],...rows.map(r=>[r.raw,r.value,r.finding])]);}\n\nconst commerceProducts=[\n  {id:'sera-notebook',name:'Field Notes Notebook',category:'Desk',price:68000,tone:'sand',tag:'A5 / 160 pages',variants:[['Grid',7],['Plain',5],['Dotted',3]]},\n  {id:'sera-tray',name:'Modular Desk Tray',category:'Desk',price:129000,tone:'clay',tag:'Powder-coated steel',variants:[['Graphite',4],['Bone',6]]},\n  {id:'sera-bottle',name:'Everyday Bottle',category:'Carry',price:158000,tone:'steel',tag:'600 ml / insulated',variants:[['Steel',5],['Forest',2],['Signal',1]]},\n  {id:'sera-tote',name:'Transit Canvas Tote',category:'Carry',price:184000,tone:'forest',tag:'Reinforced canvas',variants:[['Natural',6],['Charcoal',4]]},\n  {id:'sera-pouch',name:'Cable Pouch',category:'Utility',price:97000,tone:'ink',tag:'Five internal loops',variants:[['Small',8],['Large',3]]},\n  {id:'sera-cap',name:'Linen Work Cap',category:'Wear',price:142000,tone:'oat',tag:'Adjustable fit',variants:[['Oat',5],['Graphite',4]]}\n];\nconst commerceShipping={regular:{label:'Regular delivery',note:'2–3 working days',price:18000},express:{label:'Express delivery',note:'Next working day',price:32000},pickup:{label:'Studio pickup',note:'Balikpapan / scheduled',price:0}};\nconst commerceVouchers={WELCOME10:{minimum:150000,label:'10% off, maximum Rp35,000',discount:subtotal=>Math.min(35000,Math.round(subtotal*.1))},SHIP20:{minimum:100000,label:'Shipping discount, maximum Rp20,000',shipping:shipping=>Math.min(20000,shipping)}};\n\nfunction commerceMoney(value){return new Intl.NumberFormat('id-ID',{style:'currency',currency:'IDR',maximumFractionDigits:0}).format(value);}\nfunction commerceKey(id,variant){return `${id}::${variant}`;}\n\nfunction commerceDemo(){\n  let view={query:'',category:'All',sort:'recommended',shipping:'regular',voucher:'',voucherMessage:''};\n  let cart={};\n  try{cart=JSON.parse(localStorage.getItem('living-commerce-cart')||'{}')||{};}catch{}\n  const root=$('#commerce-demo');\n  cart=Object.fromEntries(Object.entries(cart).filter(([key])=>{const [id,variant]=key.split('::');return commerceProducts.some(p=>p.id===id&&p.variants.some(v=>v[0]===variant));}).map(([key,value])=>{const [id,variant]=key.split('::'),stock=commerceProducts.find(p=>p.id===id).variants.find(v=>v[0]===variant)[1];return [key,Math.min(stock,Math.max(0,Math.floor(Number(value)||0)))];}));\n  root.innerHTML=`<div class=\"commerce-demo\">\n    <div class=\"commerce-notice\"><span>INTERACTIVE DEMO / FICTIONAL STORE</span><span>Nothing is purchased, sent, or stored on a server.</span></div>\n    <header class=\"commerce-store-head\"><div><span class=\"eyebrow\">SERA / USEFUL THINGS</span><h3>Quiet objects.<br><i>Clear choices.</i></h3></div><button id=\"commerce-cart-jump\" aria-label=\"Open cart\">Cart <b id=\"commerce-cart-count\">0</b></button></header>\n    <div class=\"commerce-layout\">\n      <section class=\"commerce-catalog\" aria-label=\"Product catalogue\">\n        <div class=\"commerce-toolbar\"><label><span>Search the collection</span><input id=\"commerce-search\" type=\"search\" placeholder=\"Notebook, bottle, tote…\"></label><label><span>Sort</span><select id=\"commerce-sort\"><option value=\"recommended\">Recommended</option><option value=\"price-low\">Price: low to high</option><option value=\"price-high\">Price: high to low</option><option value=\"name\">Name</option></select></label></div>\n        <div class=\"commerce-categories\" id=\"commerce-categories\"></div>\n        <p class=\"commerce-result-count\" id=\"commerce-result-count\" aria-live=\"polite\"></p>\n        <div class=\"commerce-grid\" id=\"commerce-grid\"></div>\n      </section>\n      <aside class=\"commerce-cart\" id=\"commerce-cart\" aria-label=\"Shopping cart\"><div id=\"commerce-cart-content\"></div></aside>\n    </div>\n    <section class=\"commerce-checkout\" id=\"commerce-checkout\"><div><span class=\"eyebrow\">CHECKOUT / REVIEW FIRST</span><h3>A short finish.<br><i>No hidden total.</i></h3><p>Choose delivery, apply a demonstration voucher, then review the information that a production Apps Script would validate again on the server.</p></div><form id=\"commerce-checkout-form\"><label>Recipient name<input name=\"recipient\" required maxlength=\"60\" placeholder=\"For example: Maya\"></label><label>Contact number<input name=\"phone\" required inputmode=\"tel\" pattern=\"[0-9 +()-]{8,20}\" maxlength=\"20\" placeholder=\"For example: 0812 0000 0000\"></label><label class=\"wide\">Delivery address<textarea name=\"address\" required minlength=\"12\" maxlength=\"240\" rows=\"3\" placeholder=\"Use a fictional address for this demonstration.\"></textarea></label><label>City<select name=\"city\"><option>Balikpapan</option><option>Samarinda</option><option>Bontang</option></select></label><label>Payment plan<select name=\"payment\"><option>Bank transfer</option><option>E-wallet</option><option>Cash on pickup</option></select></label><label class=\"wide consent\"><input name=\"demo\" type=\"checkbox\" required> I understand this is a local demonstration and no order will be submitted.</label><button class=\"solid-button wide\" type=\"submit\">Review demonstration order ↗</button></form><div class=\"commerce-order\" id=\"commerce-order\" hidden aria-live=\"polite\"></div></section>\n    <section class=\"commerce-blueprint\"><div class=\"commerce-blueprint-head\"><span class=\"eyebrow\">PRODUCTION BLUEPRINT / GOOGLE SHEETS + APPS SCRIPT</span><h3>Simple storage.<br><i>Strict decisions.</i></h3><p>The spreadsheet stays understandable, while Apps Script owns validation, stock locking, order numbers, and every sensitive write.</p></div><div class=\"commerce-sheet-map\">${[['Products','Title, price, category, status'],['Variants','SKU, option, stock, weight'],['Vouchers','Rule, minimum, cap, active dates'],['Shipping','Zone, service, rate, estimate'],['Orders','Customer, totals, status, timestamps'],['Order Items','Order ID, SKU, quantity, unit price']].map((item,i)=>`<article><b>0${i+1}</b><span>${item[0]}</span><small>${item[1]}</small></article>`).join('')}</div><div class=\"commerce-flow\"><span>Browser</span><b>→</b><span>Apps Script</span><b>→</b><span>Reprice & lock stock</span><b>→</b><span>Sheets + Drive</span></div><p class=\"disclosure\">A production checkout must never trust totals sent by the browser. Apps Script would reload the SKU, price, voucher, shipping rule, and available stock before writing the order inside a lock.</p></section>\n  </div>`;\n\n  function persist(){try{localStorage.setItem('living-commerce-cart',JSON.stringify(cart));}catch{}}\n  function product(id){return commerceProducts.find(item=>item.id===id);}\n  function stockFor(item,variant){return item?.variants.find(option=>option[0]===variant)?.[1]||0;}\n  function cartLines(){return Object.entries(cart).map(([key,quantity])=>{const [id,variant]=key.split('::'),item=product(id);return item?{key,item,variant,quantity:Number(quantity)||0}:null;}).filter(line=>line&&line.quantity>0);}\n  function subtotal(){return cartLines().reduce((sum,line)=>sum+line.item.price*line.quantity,0);}\n  function totals(){const sub=subtot