ICTIONAL</small><h3>The small things.<br>The whole world.</h3><p>A slow conversation. A shared walk. A hundred ordinary days that became something worth celebrating. This is sample copy for an invitation, not a real couple’s story.</p></div>';\n const events='<div class=\"inv-events\"><div><small>THE CEREMONY</small><h3>10:00</h3><p>Garden Hall<br>Balikpapan · WITA</p></div><div><small>THE CELEBRATION</small><h3>18:00</h3><p>The Garden Terrace<br>Balikpapan · WITA</p></div></div>';\n const rsvp='<form class=\"inv-rsvp\"><small>RSVP / DEMONSTRATION</small><h3>A seat for you.</h3><label>Your name<input name=\"guest\" required maxlength=\"60\" autocomplete=\"off\"></label><label>Your reply<select name=\"reply\" required><option value=\"\">Please choose</option><option>Joyfully attending</option><option>Unable to attend</option></select></label><button>Preview my reply ↗</button><p role=\"status\" class=\"inv-feedback\"></p><small>No information is sent or saved.</small></form>';\n const gallery=`<div class=\"inv-art\"><small>ILLUSTRATIVE GALLERY / ORIGINAL ARTWORK</small><div>${['classic','botanical','cinema'].map(x=>`<button data-art=\"${x}\" aria-label=\"View ${worldNames[x]} artwork\">${worldSvg(x)}</button>`).join('')}</div></div>`;\n const date='<div class=\"inv-count\"><strong></strong><span>days until the celebration<br>12 June 2027</span></div>';\n const opening=`<div class=\"inv-opening\">${worldSvg(id)}<button class=\"inv-open\">${id==='classic'?'Open the invitation':id==='botanical'?'Turn the first page':'Begin our story'} ↗</button></div>`;\n if(id==='classic')canvas.innerHTML=`<div class=\"vow-envelope\">${opening}<div class=\"vow-letter\" hidden><p class=\"inv-dedication\">WITH LOVE, ARUNA & BIMA</p>${date}${story}${events}${gallery}${rsvp}</div></div>`;\n if(id==='botanical')canvas.innerHTML=`<div class=\"evergreen-journal\">${opening}<div class=\"journal-pages\" hidden><nav class=\"journal-tabs\" aria-label=\"Journal pages\"><button data-page=\"0\" aria-pressed=\"true\">01 / Our story</button><button data-page=\"1\" aria-pressed=\"false\">02 / The day</button><button data-page=\"2\" aria-pressed=\"false\">03 / Your reply</button></nav><div data-journal=\"0\">${story}${gallery}</div><div data-journal=\"1\" hidden>${date}${events}</div><div data-journal=\"2\" hidden>${rsvp}</div></div></div>`;\n if(id==='cinema')canvas.innerHTML=`<div class=\"afterglow-film\">${opening}<div class=\"film-reel\" hidden><div class=\"film-heading\"><span>01 / THE BEGINNING</span><h3>To all the<br>days ahead.</h3>${date}</div>${story}<div class=\"film-day\"><span>02 / THE DAY</span>${events}</div>${gallery}<div class=\"film-reply\"><span>03 / THE PEOPLE</span>${rsvp}</div></div></div>`;\n const open=canvas.querySelector('.inv-open');open.onclick=()=>{const body=canvas.querySelector('.vow-letter,.journal-pages,.film-reel');body.hidden=false;open.textContent='Invitation opened ↓';body.scrollIntoView({behavior:reduced?'auto':'smooth',block:'start'});canvas.classList.add('inv-is-open');};\n canvas.insertAdjacentHTML('afterbegin','<details class=\"inv-personalize\"><summary>Personalize this invitation</summary><div><label>First name<input id=\"wed-one\" maxlength=\"22\" value=\"Aruna\"></label><label>Second name<input id=\"wed-two\" maxlength=\"22\" value=\"Bima\"></label><label>Wedding date<input id=\"wed-date\" type=\"date\" value=\"2027-06-12\"></label></div></details>');\n const update=()=>{const first=canvas.querySelector('#wed-one').value.trim()||'Aruna',second=canvas.querySelector('#wed-two').value.trim()||'Bima',value=canvas.querySelector('#wed-date').value,date=value?new Date(value+'T10:00:00+08:00'):null;const label=date?new Intl.DateTimeFormat('en-GB',{day:'numeric',month:'long',year:'numeric',timeZone:'Asia/Makassar'}).format(date):'Date to be confirmed';canvas.querySelector('.inv-opening>svg').outerHTML=worldSvg(id,first,second).replace('12 JUNE 2027',esc(label.toUpperCase()));const dedication=canvas.querySelector('.inv-dedication');if(dedication)dedication.textContent='WITH LOVE, '+first+' & '+second;canvas.querySelector('.inv-count strong').textContent=date?Math.max(0,Math.ceil((date-Date.now())/86400000)):'—';canvas.querySelector('.inv-count span').textContent=date?(date<Date.now()?'Celebration date · ':'days until the celebration · ')+label:label;};canvas.querySelectorAll('.inv-personalize input').forEach(x=>x.oninput=update);update();\n canvas.querySelectorAll('[data-page]').forEach(b=>b.onclick=()=>{canvas.querySelectorAll('[data-page]').forEach(x=>x.setAttribute('aria-pressed',String(x===b)));canvas.querySelectorAll('[data-journal]').forEach(x=>x.hidden=x.dataset.journal!==b.dataset.page);});\n canvas.querySelector('form').onsubmit=e=>{e.preventDefault();if(!e.currentTarget.reportValidity())return;const values=new FormData(e.currentTarget);canvas.querySelector('.inv-feedback').textContent=`Demo reply: ${values.get('guest')} — ${values.get('reply')}. Nothing was sent.`;};\n canvas.querySelectorAll('[data-art]').forEach(b=>b.onclick=()=>{const dialog=document.querySelector('#preview-dialog');if(!dialog)return;document.querySelector('#preview-title').textContent='Original invitation artwork';document.querySelector('#preview-body').innerHTML=worldSvg(b.dataset.art);dialog.showModal();});return ()=>{};\n}\nfunction worldSlides(canvas,id){\n let scene=0,timer=null;const scenes=id==='corporate'?['The question','The evidence','The decision']:id==='kinetic'?['LESS','BUT','BETTER']:['Observe','Connect','Explain'];\n const panels=id==='corporate'?'<aside class=\"slide-notes\"><small>PRESENTER NOTES</small><h3>One idea.<br>Three moves.</h3><p>Watch the evidence bar move from the margin into the argument. These are browser animations, not a PowerPoint file.</p></aside>':id==='narrative'?'<aside class=\"slide-notes\"><small>THE STORYBOARD</small><p>01 — A detail worth noticing</p><p>02 — A connection worth making</p><p>03 — An idea worth sharing</p></aside>':'';\n canvas.innerHTML=`<div class=\"presentation-${id}\">${panels}<div class=\"slide-screen morph-stage\" data-scene=\"0\" aria-label=\"Animated slide preview\">${worldSvg(id)}<div class=\"slide-persistent\" aria-hidden=\"true\"></div><div class=\"slide-word\">${scenes[0]}</div><span class=\"slide-number\">01 / 03</span></div><div class=\"world-playback\"><button data-player=\"prev\">← Previous</button><button id=\"morph-play\">Play sequence</button><button data-player=\"next\">Next →</button><button data-player=\"replay\">Replay</button><button data-player=\"full\">Fullscreen</button></div><div class=\"slide-chapters\">${scenes.map((s,i)=>`<button data-scene=\"${i}\" aria-pressed=\"${i===0}\">0${i+1} / ${s}</button>`).join('')}</div><p class=\"slide-status\" role=\"status\">Browser-based motion study. Use Play or step through the scenes.</p></div>`;\n const stage=canvas.querySelector('.slide-screen'),play=canvas.querySelector('#morph-play');\n canvas.insertAdjacentHTML('beforeend',`<details class=\"slide-editor\"><summary>Edit the presentation</summary><div>${scenes.map((s,i)=>`<label>Scene ${i+1}<input data-slide-copy=\"${i}\" maxlength=\"28\" value=\"${esc(s)}\"></label>`).join('')}<button id=\"slide-export\">Download current scene SVG ↓</button><button id=\"slide-reset\">Reset wording</button></div><small>SVG is a static editable illustration. Animation stays in this browser demo; this is not a PowerPoint export.</small></details>`);\n const defaults=[...scenes];canvas.querySelectorAll('[data-slide-copy]').forEach(input=>input.oninput=()=>{const n=Number(input.dataset.slideCopy);scenes[n]=input.value.trim()||defaults[n];canvas.querySelector(`button[data-scene=\"${n}\"]`).textContent=`0${n+1} / ${scenes[n]}`;draw();});\n canvas.querySelector('#slide-reset').onclick=()=>{defaults.forEach((s,i)=>{scenes[i]=s;canvas.querySelector(`[data-slide-copy=\"${i}\"]`).value=s;canvas.querySelector(`button[data-scene=\"${i}\"]`).textContent=`0${i+1} / ${s}`;});draw();};\n canvas.querySelector('#slide-export').onclick=()=>studioDownload(`${id}-scene-${scene+1}.svg`,worldSvg(id).replace('</svg>',`<rect x=\"40\" y=\"565\" width=\"920\" height=\"65\" fill=\"#fffdf5\"/><text x=\"60\" y=\"610\" font-size=\"30\" fill=\"#172b29\">${esc(scenes[scene])}</text></svg>`));\n const draw=()=>{stage.dataset.scene=scene;stage.querySelector('.slide-word').textContent=scenes[scene];stage.querySelector('.slide-number').textContent=`0${scene+1} / 03`;canvas.querySelectorAll('button[data-scene]').forEach(b=>b.setAttribute('aria-pressed',String(Number(b.dataset.scene)===scene)));};\n const stop=()=>{clearInterval(timer);timer=null;play.textContent='Play sequence';};\n const start=()=>{stop();play.textContent='Pause sequence';scene=(scene+1)%3;draw();timer=setInterval(()=>{if(!canvas.isConnected){stop();return;}scene=(scene+1)%3;draw();},2400);};\n play.onclick=()=>timer?stop():start();canvas.querySelectorAll('button[data-scene]').forEach(b=>b.onclick=()=>{stop();scene=Number(b.dataset.scene);draw();});canvas.querySelectorAll('[data-player]').forEach(b=>b.onclick=()=>{const action=b.dataset.player;if(action==='full'){if(document.fullscreenElement)document.exitFullscreen();else if(stage.requestFullscreen)stage.requestFullscreen().catch(()=>canvas.querySelector('.slide-status').textContent='Fullscreen is not available in this browser.');else canvas.querySelector('.slide-status').textContent='Fullscreen is not available in this browser.';return;}stop();scene=action==='prev'?(scene+2)%3:action==='replay'?0:(scene+1)%3;draw();});\n const visibility=()=>{if(document.hidden)stop();};document.addEventListener('visibilitychange',visibility);return()=>{stop();document.removeEventListener('visibilitychange',visibility);};\n}\nfunction worldIdentity(canvas,id){\n const construction='<div class=\"identity-construction\"><small>CONSTRUCTION</small><h3>A repeatable<br>set of rules.</h3><p>One unit defines the spacing. Keep clear space around the mark and check it at the smallest intended size.</p><label><input type=\"checkbox\" id=\"construction-grid\"> Show construction grid</label></div>';\n const tools='<div class=\"identity-tools\"><label>Brand name<input id=\"brand-name\" maxlength=\"24\" value=\"'+(id==='geometric'?'FORM':id==='editorial'?'MAISON':'OFFSET')+'\"></label><label>Application<select id=\"brand-application\"><option value=\"stationery\">Stationery</option><option value=\"poster\">Poster</option><option value=\"label\">Product label</option></select></label><button id=\"brand-export\">Download concept SVG ↓</button><small>Original fictional concept. Not a trademark clearance or client identity.</small></div>';\n if(id==='geometric')canvas.innerHTML=`<div class=\"identity-geometric\"><div class=\"identity-art\">${worldSvg(id)}</div>${construction}<div class=\"identity-application\"><small>APPLICATION / STATIONERY</small><strong>FORM</strong><span>A considered system.</span></div>${tools}</div>`;\n if(id==='editorial')canvas.innerHTML=`<div class=\"identity-editorial\"><div class=\"identity-art\">${worldSvg(id)}</div><div class=\"identity-editorial-spread\"><div><small>AN IDENTITY IN PRINT</small><h3>Quietly<br>recognisable.</h3></div><div class=\"identity-application\"><small>APPLICATION / STATIONERY</small><strong>MAISON</strong><span>Objects with a quiet presence.</span></div></div><details><summary>Explore the construction notes</summary>${construction}</details>${tools}</div>`;\n if(id==='expressive')canvas.innerHTML=`<div class=\"identity-expressive\"><div class=\"identity-application\"><small>APPLICATION / POSTER</small><strong>OFFSET</strong><span>Make a little noise.</span></div><div class=\"identity-art\">${worldSvg(id)}</div><div class=\"identity-rules\">${construction}${tools}</div></div>`;\n const input=canvas.querySelector('#brand-name'),app=canvas.querySelector('.identity-application');\n canvas.querySelector('.identity-tools').insertAdjacentHTML('beforeend','<label>Initials<input id=\"brand-initials\" maxlength=\"2\" value=\"'+(id==='geometric'?'F':id==='editorial'?'M':'O')+'\"></label><label>Ink color<input id=\"brand-ink\" type=\"color\" value=\"#254439\"></label><div class=\"identity-size-test\"><span>SMALL-SIZE CHECK / 24 & 48 PX</span><b></b><b></b></div>');\n const artwork=()=>{const name=input.value.trim()||'YOUR NAME',initials=canvas.querySelector('#brand-initials').value.trim()||name.slice(0,2),ink=canvas.querySelector('#brand-ink').value;let svg=worldSvg(id);const doc=new DOMParser().parseFromString(svg,'image/svg+xml');const texts=[...doc.querySelectorAll('text')];if(id==='editorial'){const t=texts.find(t=>t.textContent==='MAISON');t.textContent=name;t.setAttribute('font-size',Math.min(100,620/Math.max(name.length,1)*1.5));}else if(id==='expressive'){texts.find(t=>t.textContent==='OFF').textContent=name.slice(0,Math.ceil(name.length/2));texts.find(t=>t.textContent==='SET').textContent=name.slice(Math.ceil(name.length/2));texts.filter(t=>Number(t.getAttribute('font-size'))===148).forEach(t=>t.setAttribute('font-size',Math.min(148,800/Math.max(name.length,1))));}else{doc.querySelector('path[fill=\"#254439\"]').remove();const text=doc.createElementNS('http://www.w3.org/2000/svg','text');text.setAttribute('x','500');text.setAttribute('y','430');text.setAttribute('text-anchor','middle');text.setAttribute('font-size','280');text.setAttribute('font-weight','700');text.setAttribute('fill',ink);text.textContent=initials;doc.documentElement.append(text);texts[0].textContent=name+' / CONSTRUCTION SYSTEM';}return new XMLSerializer().serializeToString(doc);};\n const update=()=>{app.querySelector('strong').textContent=input.value.trim()||'YOUR NAME';app.style.setProperty('--brand-ink',canvas.querySelector('#brand-ink').value);canvas.querySelector('.identity-art').innerHTML=artwork();canvas.querySelectorAll('.identity-size-test b').forEach(b=>{b.textContent=canvas.querySelector('#brand-initials').value||input.value.slice(0,2);b.style.color=canvas.querySelector('#brand-ink').value;});};\n input.oninput=update;canvas.querySelector('#brand-initials').oninput=update;canvas.querySelector('#brand-ink').oninput=update;canvas.querySelector('#brand-application').onchange=e=>{app.dataset.application=e.target.value;app.querySelector('small').textContent='APPLICATION / '+e.target.value.toUpperCase();};canvas.querySelector('#brand-application').value=id==='expressive'?'poster':'stationery';app.dataset.application=canvas.querySelector('#brand-application').value;canvas.querySelector('#construction-grid').onchange=e=>canvas.querySelector('.identity-art').classList.toggle('show-grid',e.target.checked);canvas.querySelector('#brand-export').onclick=()=>studioDownload(id+'-concept.svg',artwork());update();return()=>{};\n}\n\nfunction hydrateStudioPreviews(root){\n const styles=[...document.querySelectorAll('style')].map(s=>s.textContent).join('\\n');\n root.querySelectorAll('[data-demo-snapshot]').forEach(host=>{const id=host.dataset.demoSnapshot;if(!demoSnapshots[id])return;const frame=document.createElement('iframe');frame.setAttribute('sandbox','');frame.setAttribute('tabindex','-1');frame.setAttribute('aria-hidden','true');frame.setAttribute('loading','lazy');frame.title='Static preview of '+id;frame.srcdoc='<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><style>'+styles+'</style><style>html,body{margin:0!important;padding:0!important;width:1100px!important;min-width:0!important;overflow:hidden!important;background:#eee9df!important}body>*{margin:0!important;width:100%!important;max-width:none!important;transform:none!important}*{animation:none!important;transition:none!important}#commerce-demo .commerce-blueprint,#commerce-demo .commerce-checkout{display:none}#workspace{min-height:720px}.commerce-product-art{height:180px!important}.commerce-store-head h3{font-size:44px!important}</style></head><body class=\"spatial-gallery spatial-v2 clean-ui\">'+demoSnapshots[id]+'<\\/body></html>';host.append(frame);const size=()=>frame.style.transform='scale('+host.clientWidth/1100+')';size();const observer=new ResizeObserver(()=>{if(!host.isConnected){observer.disconnect();return;}size();});observer.observe(host);});\n}\n// Three different web journeys: editorial commerce, a file workspace, and a booking concierge.\nfunction productIllustration(id){\n const shapes={\n 'sera-notebook':'<path d=\"M155 80h200v280H155z\" fill=\"#e6dcc4\"/><path d=\"M170 80v280\" stroke=\"#927d5c\" stroke-width=\"6\"/><path d=\"M200 150h110M200 170h80\" stroke=\"#8a765b\" stroke-width=\"3\"/>',\n 'sera-tray':'<path d=\"M100 220l210-80 110 85-210 90z\" fill=\"#767c75\"/><path d=\"M100 220v40l110 88v-33z\" fill=\"#414c45\"/><path d=\"M210 315l210-90v40l-210 83z\" fill=\"#515e55\"/><path d=\"M125 221l180-65 85 67-180 67z\" fill=\"#b8beb3\"/>',\n 'sera-bottle':'<rect x=\"210\" y=\"60\" width=\"80\" height=\"40\" rx=\"9\" fill=\"#384c47\"/><path d=\"M210 100h80v25q35 12 35 50v165q0 25-25 25H200q-25 0-25-25V175q0-38 35-50z\" fill=\"#a4b4ae\"/><path d=\"M195 170v160\" stroke=\"#d9e1db\" stroke-width=\"12\"/>',\n 'sera-tote':'<path d=\"M170 145q0-120 80-120t80 120\" fill=\"none\" stroke=\"#9e8c6d\" stroke-width=\"18\"/><path d=\"M130 130h240l-20 235H150z\" fill=\"#d6c8ab\"/><path d=\"M165 130v190M335 130v190\" stroke=\"#b19b78\" stroke-width=\"8\"/>',\n 'sera-pouch':'<rect x=\"110\" y=\"150\" width=\"290\" height=\"160\" rx=\"30\" fill=\"#485859\"/><path d=\"M130 175h245\" stroke=\"#b5bab0\" stroke-width=\"5\"/><path d=\"M365 176v30\" stroke=\"#e6ddca\" stroke-width=\"9\"/>',\n 'sera-cap':'<path d=\"M150 250q0-180 180-110q60 30 60 110\" fill=\"#d3c4a8\"/><path d=\"M150 250q-120 35-30 70q120 30 270-70z\" fill=\"#ad9c7d\"/><path d=\"M255 125q-45 50-30 115\" fill=\"none\" stroke=\"#b29f80\" stroke-width=\"3\"/>'};\n return `<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 500 420\" role=\"img\" aria-label=\"Original illustration of ${esc(commerceProducts.find(p=>p.id===id)?.name||'product')}\"><ellipse cx=\"255\" cy=\"375\" rx=\"145\" ry=\"15\" fill=\"#1b30211a\"/>${shapes[id]||''}</svg>`;\n}\nfunction archiveExperience(){\n const root=$('#archive-demo');let query='',folder='All records',busy=false;const records=[{name:'Weekly bulletin',folder:'October',date:'2026-10-03',type:'PDF'},{name:'Service notes',folder:'October',date:'2026-10-10',type:'DOC'},{name:'Music schedule',folder:'October',date:'2026-10-17',type:'XLS'},{name:'Community notice',folder:'September',date:'2026-09-26',type:'PDF'}];\n root.innerHTML='<div class=\"archive-app\"><aside><span class=\"system-monogram\">A/</span><h3>Everything,<br>in its place.</h3><p>A shared archive.<br>A quieter working day.</p><nav aria-label=\"Sample folders\">'+['All records','October','September'].map((n,i)=>`<button data-folder=\"${n}\" aria-pressed=\"${i===0}\">${n} <span>↗</span></button>`).join('')+'</nav><small>LOCAL SIMULATION<br>FICTIONAL RECORDS</small></aside><section><header><div><small>WORKSPACE / 2026</small><h3 id=\"archive-folder-title\">All records</h3></div><button id=\"queue-upload\">+ Sample upload</button></header><label class=\"system-search\">Find a document<input id=\"archive-search\" type=\"search\" placeholder=\"Search by title or file type\"></label><p id=\"upload-status\" role=\"status\">No storage connection. Explore safely.</p><div class=\"record-list\" id=\"archive-list\"></div><footer><span id=\"archive-count\"></span><span>Preview before you download ↗</span></footer></section></div>';\n const draw=()=>{const visible=records.filter(r=>(folder==='All records'||r.folder===folder)&&(r.name+' '+r.type).toLowerCase().includes(query.toLowerCase()));root.querySelector('#archive-folder-title').textContent=folder;root.querySelector('#archive-count').textContent=visible.length+' sample records';root.querySelector('#archive-list').innerHTML=visible.map(r=>`<button data-document=\"${records.indexOf(r)}\"><b>${r.type}</b><span><strong>${esc(r.name)}</strong><small>${r.date} / ${r.folder}</small></span><span>Open ↗</span></button>`).join('')||'<p class=\"system-emp