asks:revisionDefaults.map(x=>[...x]);const target=saved?.target||'2026-11-30';\n  w.innerHTML=toolkitFrame('08','Keep revisions visible.','A local checklist for planning the next research actions. Progress stays in this browser only.',`<form class=\"tool-form\" id=\"revision-form\"><label>Target date<input id=\"revision-target\" type=\"date\" value=\"${esc(target)}\"></label><div class=\"wide revision-list\">${plan.map((item,i)=>`<label><input data-revision=\"${i}\" type=\"checkbox\" ${item[1]?'checked':''}><span>${esc(item[0])}</span></label>`).join('')}</div></form>`);\n  function update(){plan.forEach((item,i)=>item[1]=$(`[data-revision=\"${i}\"]`).checked);const date=$('#revision-target').value,done=plan.filter(x=>x[1]).length,percent=Math.round(done/plan.length*100),days=date?Math.ceil((new Date(date+'T12:00:00')-new Date())/86400000):null;try{localStorage.setItem('living-research-plan',JSON.stringify({target:date,tasks:plan}));}catch{}$('#tool-result').innerHTML=`<div class=\"revision-progress\"><strong>${percent}%</strong><div><span style=\"width:${percent}%\"></span></div><p>${done} of ${plan.length} actions complete · ${days===null?'no target selected':days>=0?days+' days remaining':Math.abs(days)+' days past target'}</p></div><button id=\"revision-export\">Download revision plan ↓</button>`;$('#revision-export').onclick=()=>csvDownload('research-revision-plan.csv',[['PERSONAL PLANNING FILE'],['Target date',date],['Action','Status'],...plan.map(x=>[x[0],x[1]?'Complete':'Open'])]);}\n  $('#revision-form').onchange=update;update();\n}\n\n// Six focused demonstrations that fill the remaining portfolio gaps.\nfunction nextWaveDemo(kind){\n  const demos={fieldcompanion:fieldCompanionDemo,dataprep:dataPreparationDemo,documents:documentAutomationDemo,commerceops:commerceOperationsDemo,qualityroom:qualityEvidenceDemo,scopebuilder:scopeBuilderDemo};\n  (demos[kind]||(()=>{$('#next-wave-demo').innerHTML='<p>This demonstration is unavailable.</p>';}))();\n}\n\nfunction demoDownload(name,text,type='text/plain;charset=utf-8'){\n  Engine.downloadBlob(name,new Blob([text],{type}));\n}\n\nfunction demoShell(kicker,title,note,body){\n  return `<div class=\"working-demo\" data-demo-stage><div class=\"depth-readout\" aria-hidden=\"true\"><span>INPUT</span><i></i><span>PROCESS</span><i></i><span>OUTPUT</span></div><header class=\"working-demo-head\"><div><span>${kicker}</span><h3>${title}</h3></div><p>${note}</p></header><div class=\"workbench-body\">${body}</div><footer>Demonstration Data / Runs locally / Nothing is submitted</footer></div>`;\n}\n\nfunction fieldCompanionDemo(){\n  const root=$('#next-wave-demo');\n  let connected=true;\n  let queue=[];\n  try{queue=JSON.parse(localStorage.getItem('living-field-queue')||'[]');}catch{}\n  const assets=[\n    {id:'DEMO-OFC-021',name:'Office workstation',department:'Marketing',location:'Room M-03'},\n    {id:'DEMO-MCH-011',name:'Transfer pump',department:'Engineering',location:'Plant A'},\n    {id:'DEMO-VEH-003',name:'Operational vehicle',department:'Operations',location:'Main garage'}\n  ];\n  root.innerHTML=demoShell('FIELD COMPANION / OFFLINE-FIRST PROTOTYPE','A field record that can wait for the network.','Find an asset, record what you actually saw, and keep the handover traceable.',`\n    <div class=\"field-device\">\n      <aside><span class=\"device-label\">FIELD SESSION / 23 OCT 2026</span><button id=\"field-network\" aria-pressed=\"true\">Network / available</button><dl><div><dt>Assigned</dt><dd>${assets.length}</dd></div><div><dt>Local queue</dt><dd id=\"field-queue-count\">0</dd></div><div><dt>Synced</dt><dd id=\"field-synced-count\">0</dd></div></dl><button id=\"field-sync\" class=\"ink-button\">Sync queued records</button><p id=\"field-sync-note\" role=\"status\">Ready for field work.</p></aside>\n      <main><label class=\"field-search\">Inventory number<select id=\"field-asset\">${assets.map(a=>`<option value=\"${a.id}\">${a.id} / ${a.name}</option>`).join('')}</select></label><div id=\"field-asset-card\"></div><form id=\"field-capture\"><div class=\"form-pair\"><label>Observed condition<select name=\"condition\"><option>Good</option><option>Monitor</option><option>Needs repair</option><option>Not found</option></select></label><label>Location found<input name=\"location\" required maxlength=\"80\"></label></div><label>Observation note<textarea name=\"note\" rows=\"4\" maxlength=\"300\" placeholder=\"Write only what can be verified in the field.\"></textarea></label><label class=\"evidence-input\">Evidence photo <input name=\"photo\" type=\"file\" accept=\"image/jpeg,image/png\" capture=\"environment\"><small>The demo stores only the selected file name, never the image.</small></label><button class=\"ink-button\" type=\"submit\">Add to local queue</button></form><div id=\"field-queue\"></div></main>\n    </div>`);\n  const save=()=>{try{localStorage.setItem('living-field-queue',JSON.stringify(queue));}catch{}};\n  function drawAsset(){const a=assets.find(x=>x.id===$('#field-asset').value);$('#field-asset-card').innerHTML=`<span>ASSET FOUND</span><strong>${esc(a.name)}</strong><p>${esc(a.department)} / expected at ${esc(a.location)}</p>`;$('#field-capture [name=\"location\"]').value=a.location;}\n  function drawQueue(){const pending=queue.filter(x=>x.status==='Queued'),synced=queue.filter(x=>x.status==='Synced');$('#field-queue-count').textContent=pending.length;$('#field-synced-count').textContent=synced.length;$('#field-queue').innerHTML=queue.length?`<div class=\"field-log\"><span>LOCAL ACTIVITY</span>${queue.slice().reverse().map(r=>`<article><b>${esc(r.asset)}</b><span>${esc(r.condition)} / ${esc(r.location)}</span><small>${esc(r.time)} · ${esc(r.status)}${r.photo?' · '+esc(r.photo):''}</small></article>`).join('')}</div>`:'<p class=\"empty-note\">No observations recorded in this browser.</p>';}\n  $('#field-network').onclick=()=>{connected=!connected;const b=$('#field-network');b.setAttribute('aria-pressed',connected);b.textContent=connected?'Network / available':'Network / offline';$('#field-sync-note').textContent=connected?'Connection restored. Queued work is still under your control.':'Offline mode. New observations remain on this device.';};\n  $('#field-sync').onclick=()=>{if(!connected){$('#field-sync-note').textContent='Sync paused. Restore the network first.';return;}const pending=queue.filter(x=>x.status==='Queued');if(!pending.length){$('#field-sync-note').textContent='Nothing is waiting to sync.';return;}pending.forEach(x=>x.status='Synced');save();drawQueue();$('#field-sync-note').textContent=`${pending.length} record${pending.length===1?'':'s'} moved through the simulated sync queue.`;};\n  $('#field-asset').onchange=drawAsset;\n  $('#field-capture').onsubmit=e=>{e.preventDefault();if(!e.currentTarget.reportValidity())return;const f=new FormData(e.currentTarget),photo=e.currentTarget.elements.photo.files[0];queue.push({asset:$('#field-asset').value,condition:String(f.get('condition')),location:String(f.get('location')),note:String(f.get('note')),photo:photo?.name||'',time:new Date().toLocaleString('en-GB',{dateStyle:'medium',timeStyle:'short'}),status:'Queued'});save();drawQueue();e.currentTarget.elements.note.value='';e.currentTarget.elements.photo.value='';$('#field-sync-note').textContent=connected?'Observation queued. Sync it when the field session is ready.':'Observation saved locally while offline.';};\n  drawAsset();drawQueue();\n}\n\nconst prepSource=[\n  {id:'R-001',group:'Control',q1:4,q2r:2,q3:5,age:23},\n  {id:'R-002',group:'Program',q1:5,q2r:1,q3:5,age:22},\n  {id:'R-003',group:'Control',q1:3,q2r:99,q3:4,age:24},\n  {id:'R-003',group:'Control',q1:3,q2r:99,q3:4,age:24},\n  {id:'R-004',group:'Program',q1:2,q2r:5,q3:2,age:142},\n  {id:'R-005',group:'Program',q1:4,q2r:2,q3:4,age:21}\n];\n\nfunction dataPreparationDemo(){\n  const root=$('#next-wave-demo');let prepared=[];\n  root.innerHTML=demoShell('RESEARCH DATA / PREPARATION DESK','Clean decisions before statistical output.','Inspect missing codes, duplicate IDs, reverse-scored items, and implausible values before opening SPSS.',`\n    <div class=\"prep-layout\"><aside><label>Missing-value code<input id=\"prep-missing\" type=\"number\" value=\"99\"></label><label>Scale minimum<input id=\"prep-min\" type=\"number\" min=\"0\" value=\"1\"></label><label>Scale maximum<input id=\"prep-max\" type=\"number\" min=\"1\" value=\"5\"></label><label class=\"check-row\"><input id=\"prep-reverse\" type=\"checkbox\" checked> Reverse-score Q2R</label><button id=\"prep-run\" class=\"ink-button\">Prepare working copy</button><div id=\"prep-findings\"></div></aside><main><div class=\"desk-tabs\"><button data-prep-view=\"raw\" aria-pressed=\"true\">Raw import</button><button data-prep-view=\"clean\" aria-pressed=\"false\">Prepared copy</button><button data-prep-view=\"codebook\" aria-pressed=\"false\">Codebook</button></div><div id=\"prep-table\"></div><div class=\"desk-actions\"><button id=\"prep-csv\" disabled>Download prepared CSV</button><button id=\"prep-syntax\" disabled>Download SPSS syntax</button></div></main></div>`);\n  let view='raw';\n  function rowsTable(rows){return table(['Respondent','Group','Q1','Q2R','Q3','Age','Scale mean'],rows.map(r=>`<tr class=\"${r.issue?'review':''}\"><td>${esc(r.id)}</td><td>${esc(r.group)}</td><td>${r.q1}</td><td>${r.q2r===''?'Missing':r.q2r}</td><td>${r.q3}</td><td>${r.age}</td><td>${r.mean??'—'}</td></tr>`).join(''));}\n  function draw(){$$('[data-prep-view]').forEach(b=>b.setAttribute('aria-pressed',b.dataset.prepView===view));if(view==='raw')$('#prep-table').innerHTML=rowsTable(prepSource.map(r=>({...r,mean:'—',issue:r.q2r===99||r.age>100})));else if(view==='clean')$('#prep-table').innerHTML=prepared.length?rowsTable(prepared):'<p class=\"empty-note\">Run preparation to create a working copy.</p>';else $('#prep-table').innerHTML=table(['Variable','Label','Type','Values / rule'],[['id','Respondent identifier','String','Unique; duplicates flagged'],['group','Study group','Nominal','Control / Program'],['q1','Service clarity item','Scale','1–5'],['q2r','Delay/friction item','Scale','Reverse: 6 − value'],['q3','Confidence item','Scale','1–5'],['age','Age in years','Scale','Review values outside 15–100']].map(r=>`<tr>${r.map(v=>`<td>${esc(v)}</td>`).join('')}</tr>`).join(''));}\n  $('#prep-run').onclick=()=>{const missing=Number($('#prep-missing').value),min=Number($('#prep-min').value),max=Number($('#prep-max').value),seen=new Set(),issues=[];prepared=[];prepSource.forEach(r=>{if(seen.has(r.id)){issues.push(`Duplicate ${r.id} excluded from the working copy.`);return;}seen.add(r.id);const q2=r.q2r===missing?'':$('#prep-reverse').checked?max+min-r.q2r:r.q2r,valid=[r.q1,q2,r.q3].filter(v=>typeof v==='number'),mean=valid.length?(valid.reduce((a,b)=>a+b,0)/valid.length).toFixed(2):'';prepared.push({...r,q2r:q2,mean,issue:r.age<15||r.age>100});if(r.q2r===missing)issues.push(`${r.id}: Q2R changed from missing code to blank.`);if(r.age<15||r.age>100)issues.push(`${r.id}: age ${r.age} requires source verification.`);});$('#prep-findings').innerHTML=`<span>PREPARATION LOG</span><strong>${prepared.length} usable rows</strong>${issues.map(x=>`<p>${esc(x)}</p>`).join('')}`;$('#prep-csv').disabled=false;$('#prep-syntax').disabled=false;view='clean';draw();};\n  $$('[data-prep-view]').forEach(b=>b.onclick=()=>{view=b.dataset.prepView;draw();});\n  $('#prep-csv').onclick=()=>csvDownload('research-data-prepared-demo.csv',[['DEMONSTRATION DATA'],['id','group','q1','q2r','q3','age','scale_mean'],...prepared.map(r=>[r.id,r.group,r.q1,r.q2r,r.q3,r.age,r.mean])]);\n  $('#prep-syntax').onclick=()=>demoDownload('research-data-preparation-demo.sps',`* Demonstration syntax. Review variable names and file paths before use.\\nMISSING VALUES q1 q2r q3 (99).\\nRECODE q2r (1=5)(2=4)(3=3)(4=2)(5=1) INTO q2r_scored.\\nCOMPUTE scale_mean=MEAN.2(q1,q2r_scored,q3).\\nVARIABLE LABELS scale_mean 'Mean of available scale items'.\\nEXECUTE.\\n`);\n  draw();\n}\n\nfunction simplePdfBytes(lines){\n  const clean=value=>String(value??'').normalize('NFKD').replace(/[^\\x20-\\x7E]/g,' ').replace(/([\\\\()])/g,'\\\\$1');\n  const stream=['BT','/F1 15 Tf','55 780 Td'];\n  lines.forEach((line,index)=>{if(index){stream.push('0 -28 Td');stream.push(index===2?'/F1 20 Tf':'/F1 10 Tf');}stream.push(`(${clean(line)}) Tj`);});\n  stream.push('ET');const content=stream.join('\\n');\n  const objects=[\n    '<< /Type /Catalog /Pages 2 0 R >>',\n    '<< /Type /Pages /Kids [3 0 R] /Count 1 >>',\n    '<< /Type /Page /Parent 2 0 R /MediaBox [0 0 595 842] /Resources << /Font << /F1 4 0 R >> >> /Contents 5 0 R >>',\n    '<< /Type /Font /Subtype /Type1 /BaseFont /Helvetica >>',\n    `<< /Length ${content.length} >>\\nstream\\n${content}\\nendstream`\n  ];\n  let pdf='%PDF-1.4\\n',offsets=[0];objects.forEach((object,index)=>{offsets.push(pdf.length);pdf+=`${index+1} 0 obj\\n${object}\\nendobj\\n`;});const xref=pdf.length;pdf+=`xref\\n0 ${objects.length+1}\\n0000000000 65535 f \\n`;offsets.slice(1).forEach(offset=>pdf+=String(offset).padStart(10,'0')+' 00000 n \\n');pdf+=`trailer\\n<< /Size ${objects.length+1} /Root 1 0 R >>\\nstartxref\\n${xref}\\n%%EOF`;\n  return new TextEncoder().encode(pdf);\n}\n\nfunction documentAutomationDemo(){\n  const root=$('#next-wave-demo');\n  const serial=String(new Date().getUTCFullYear())+'/014';\n  root.innerHTML=demoShell('DOCUMENT AUTOMATION / CONTROLLED DRAFT','One source, several reliable outputs.','The document remains readable because the data model, template, approval state, and archive reference stay separate.',`\n    <div class=\"document-desk\"><form id=\"document-form\"><label>Document type<select name=\"type\"><option>Asset field review</option><option>Maintenance summary</option><option>Meeting minutes</option><option>Formal correspondence</option></select></label><label>Reference<input name=\"reference\" value=\"WBL/AST/${serial}\" required></label><label>Department<input name=\"department\" value=\"Asset Administration\" required maxlength=\"80\"></label><label>Prepared by<input name=\"owner\" value=\"Field Verification Team\" required maxlength=\"80\"></label><label class=\"wide\">Subject<input name=\"subject\" value=\"Follow-up for assets requiring field confirmation\" required maxlength=\"140\"></label><label class=\"wide\">Main note<textarea name=\"note\" rows=\"5\" maxlength=\"500\">Four records still require location confirmation. One equipment record needs a clearer specification from the responsible department.</textarea></label><button class=\"ink-button wide\" type=\"submit\">Refresh controlled draft</button></form><div><div class=\"paper-preview\" id=\"document-preview\"></div><div class=\"desk-actions\"><button id=\"document-pdf\">Generate sample PDF</button><button id=\"document-log\">Download archive log</button></div></div></div>`);\n  let draft={};\n  function update(e){e?.preventDefault();const form=$('#document-form');if(!form.reportValidity())return;draft=Object.fromEntries(new FormData(form));$('#document-preview').innerHTML=`<header><span>${esc(draft.reference)}</span><b>DRAFT / INTERNAL REVIEW</b></header><h4>${esc(draft.type)}</h4><p class=\"paper-subject\">${esc(draft.subject)}</p><dl><div><dt>Department</dt><dd>${esc(draft.department)}</dd></div><div><dt>Prepared by</dt><dd>${esc(draft.owner)}</dd></div><div><dt>Generated</dt><dd>${new Date().toLocaleDateString('en-GB',{dateStyle:'long'})}</dd></div></dl><p>${esc(draft.note)}</p><footer><span>Review status / Draft</span><span>Archive destination / DEMO-ASSET-REPORTS</span></footer>`;}\n  $('#document-form').onsubmit=update;update();\n  $('#document-log').onclick=()=>demoDownload('document-archive-log-demo.csv',`reference,type,department,status,generated_at\\n\"${draft.reference}\",\"${draft.type}\",\"${draft.department}\",Draft,\"${new Date().toISOString()}\"\\n`,'text/csv;charset=utf-8');\n  $('#document-pdf').onclick=()=>action($('#document-pdf'),()=>{const noteLines=String(draft.note).match(/.{1,78}(?:\\s|$)/g)||[''];const lines=['CONTROLLED DOCUMENT / DEMONSTRATION',draft.reference,draft.type.toUpperCase(),draft.subject,'Department: '+draft.department,'Prepared by: '+draft.owner,'Status: DRAFT / INTERNAL REVIEW','',...noteLines.map(x=>x.trim()),'','Synthetic document. No confidential records are included.'];demoDownload('controlled-document-demo.pdf',simplePdfBytes(lines),'application/pdf');});\n}\n\nfunction commerceOperationsDemo(){\n  const root=$('#next-wave-demo');\n  let inventory=[{sku:'NOTE-GRID',name:'Field Notes / Grid',stock:7,reorder:4,cost:39000,price:68000},{sku:'TRAY-GRAPH',name:'Desk Tray / Graphite',stock:3,reorder:4,cost:79000,price:129000},{sku:'BOT-SIGNAL',name:'Bottle / Signal',stock:1,reorder:3,cost:94000,price:158000},{sku:'TOTE-NAT',name:'Canvas Tote / Natural',stock:6,reorder:3,cost:112000,price:184000}];\n  let orders=[{id:'SERA-1041',customer:'Maya A.',items:2,total:252000,status:'Paid'},{id:'SERA-1042',customer:'Dion R.',items:1,total:158000,status:'Picking'},{id:'SERA-1043',customer:'Nadia P.',items:3,total:323000,status:'Packed'},{id:'SERA-1044',customer:'R. Putra',items:1,total:129000,status:'Return review'}];\n  const statuses=['Paid','Picking','Packed','Shipped'];\n  root.innerHTML=demoShell('SERA / OPERATIONS CONSOLE','The work after checkout.','Stock, fulfilment, exceptions, and margin live behind the storefront—not inside another decorative dashboard.',`<div class=\"ops-console\"><nav><button data-ops=\"orders\" aria-pressed=\"true\">Order desk</button><button data-ops=\"stock\" aria-pressed=\"false\">Stock ledger</button><button data-ops=\"summary\" aria-pressed=\"false\">Daily close</button></nav><div id=\"ops-view\"></div></div>`);\n  let view='orders';\n  function metrics(){const revenue=orders.filter(o=>o.status!=='Return review').reduce((s,o)=>s+o.total,0),low=inventory.filter(x=>x.stock<=x.reorder).length;return {revenue,low,open:orders.filter(o=>o.status!=='Shipped').length};}\n  function draw(){$$('[data-ops]').forEach(b=>b.setAttribute('aria-pressed',b.dataset.ops===view));const m=metrics();if(view==='orders')$('#ops-view').innerHTML=`<div class=\"console-strip\"><span>${m.open} OPEN</span><span>${money(m.revenue)} RECORDED</span><span>${orders.filter(o=>o.status==='Return review').length} EXCEPTION</span></div>${table(['Order','Customer','Items','Total','Current stage','Next action'],orders.map((o,i)=>`<tr class=\"${o.status==='Return review'?'review':''}\"><td>${o.id}</td><td>${o.customer}</td><td>${o.items}</td><td>${money(o.total)}</td><td>${o.status}</td><td><button data-order-next=\"${i}\">${o.status==='Return review'?'Resolve review':o.status==='Shipped'?'Completed':'Advance stage'}</button></td></tr>`).join(''))}`;else if(view==='stock')$('#ops-view').innerHTML=`<div class=\"stock-adjust\"><label>SKU<select id=\"stock-sku\">${inventory.map(x=>`<option>${x.sku}</option>`).join('')}</select></label><label>Movement<input id=\"stock-movement\" type=\"number\" value=\"1\" min=\"-20\" max=\"20\"></label><label>Reason<select id=\"stock-reason\"><option>Supplier receipt</option><option>Manual correction</option><option>Damaged item</option><option>Customer return</option></select></label><button id=\"stock-post\" class=\"ink-button\">Post movement</button></div>${table(['SKU','Product','On hand','Reorder point','Unit cost','Sale price','Gross margin','State'],inventory.map(x=>`<tr class=\"${x.stock<=x.reorder?'review':''}\"><td>${x.sku}</td><td>${x.name}</td><td>${x.stock}</td><td>${x.reorder}</td><td>${money(x.cost)}</td><td>${money(x.price)}</td><td>${Math.round((x.price-x.cost)/x.price*100)}%</td><td>${x.stock<=x.reorder?'Reorder':'Available'}</td></tr>`).join(''))}`;else $('#ops-view').innerHTML=`<div class=\"close-sheet\"><span>DAILY CLOSE / FICTIONAL STORE</span><strong>${money(m.revenue)}</strong><p>Recorded revenue across non-return orders</p><dl><div><dt>Orders in view</dt><dd>${orders.length}</dd></div><div><dt>Open fulfilment</dt><dd>${m.open}</dd></div><div><dt>Low-stock SKUs</dt><dd>${m.low}</dd></div><div><dt>Return reviews</dt><dd>${orders.filter(o=>o.status==='Return review').length}</dd></div></dl><button id=\"ops-export\">Export daily summary</button></div>`;bind();}\n  function bind(){$$('[data-order-next]').forEach(b=>b.onclick=()=>{const o=orders[Number(b.dataset.orderNext)];if(o.status==='Return review')o.status='Paid';else{const i=statuses.indexOf(o.status);o.status=statuses[Math.min(i+1,statuses.length-1)];}draw();});if($('#stock-post'))$('#stock-post').onclick=()=>{const item=inventory.find(x=>x.sku===$('#stock-sku').value),move=Number($('#stock-movement').value);if(!Number.isFinite(move)||item.stock+move<0){toast('That movement would create invalid stock.');return;}item.stock+=move;toast(`${item.sku}: ${move>0?'+':''}${move} / ${$('#stock-reason').value}`);draw();};if($('#ops-export'))$('#ops-export').onclick=()=>csvDownload('sera-operations-daily-close-demo.csv',[['DEMONSTRATION DATA'],['Order','Customer','Items','Total','Status'],...orders.map(o=>[o.id,o.customer,o.items,o.total,o.status]),[],['SKU','Product','Stock','Reorder point'],...inventory.map(x=>[x.sku,x.name,x.stock,x.reorder])]);}\n  $$('[data-ops]').forEach(b=>b.onclick=()=>{view=b.dataset.ops;draw();});draw();\n}\n\nfunction qualityEvidenceDemo(){\n  const root=$('#next-wave-demo');\n  root.innerHTML=demoShell('RELEASE REVIEW / BROWSER SELF-CHECK','Proof should be inspectable.','This is a local release check, not a fabricated Lighthouse score. It reports only what the current document can verify.',`<div class=\"quality-console\"><div class=\"quality-controls\"><label>Preview width <input id=\"quality-width\" type=\"range\" min=\"320\" max=\"1100\" value=\"880\"><output id=\"quality-width-value\">880 px</output></label><button id=\"quality-run\" class=\"ink-button\">Run document checks</button><button id=\"quality-copy\">Copy report</button></div><div class=\"quality-frame\" id=\"quality-frame\"><div><span>RESPONSIVE SAMPLE</span><h4>A useful layout survives a smaller screen.</h4><p>Type, spacing, and controls change together. Nothing important depends on hover.</p><button>Primary action</button><a href=\"#quality-results\">Read evidence</a></div><dl><div><dt>Input</dt><dd>Validated</dd></div><div><dt>State</dt><dd>Visible</dd></div><div><dt>Motion</dt><dd>Optional</dd></div></dl></div><div id=\"quality-results\" aria-live=\"polite\"></div></div>`);\n  let report='';\n  function run(){const checks=[['Skip link',!!document.querySelector('.skip'),'Keyboard users can bypass repeated navigation.'],['Main landmark',!!document.querySelector('main#main'),'The page exposes one primary content region.'],['Dialog labels',[...document.querySelectorAll('dialog')].every(d=>d.querySelector('[aria-label],h2')),'Modal surfaces have a discoverable name.'],['Reduced motion',matchMedia('(prefers-reduced-motion: reduce)').matches||document.documentElement.classList.contains('reduced')||document.documentElement.outerHTML.includes('living-motion'),'A motion preference path is available.'],['Table overflow',[...document.querySelectorAll('.table-scroll')].every(x=>x.tabIndex===0),'Wide evidence tables remain keyboard-scrollable.'],['Project URLs',data.projects.every(p=>p.slug&&p.name),'Every content object has a stable slug and name.'],['Synthetic labels',document.body.textContent.includes('Demonstration Data')||document.body.textContent.includes('DEMONSTRATION'),'Demonstration material is distinguished from verified work.']];report=checks.map(x=>`${x[1]?'PASS':'REVIEW'} / ${x[0]} / ${x[2]}`).join('\\n');$('#quality-results').innerHTML=`<div class=\"audit-list\">${checks.map(x=>`<article class=\"${x[1]?'pass':'review'}\"><b>${x[1]?'PASS':'REVIEW'}</b><strong>${x[0]}</strong><p>${x[2]}</p></article>`).join('')}</div><p class=\"disclosure\">These checks inspect semantics and interface safeguards in the current page. Network performance, Core Web Vitals, and cross-browser behavior still require external measurement.</p>`;}\n  $('#quality-width').oninput=e=>{const width=e.target.value;$('#quality-width-value').textContent=width+' px';$('#quality-frame').style.width=Math.min(width,root.clientWidth)+'px';};$('#quality-run').onclick=run;$('#quality-copy').onclick=()=>navigator.clipboard?.writeText(report).then(()=>toast('Release report copied.')).catch(()=>demoDownload('release-check.txt',report));run();\n}\n\nfunction scopeBuilderDemo(){\n  const root=$('#next-wave-demo');\n  const deliverables={Website:['Responsive interface','Content editor','Deployment notes','Accessibility review'],Data:['Clean workbook','Calculation notes','Exception report','Handover guide'],Research:['Method review','Data preparation','Analysis notes','Defense preparation'],Automation:['Process map','Apps Script workflow','Audit log','Maintenance notes']};\n  root.innerHTML=demoShell('PROJECT INTAKE / SCOPE BUILDER','A better conversation starts with a useful brief.','Choose what matters, name the boundary, and leave with a message that is ready to discuss—not an invented instant quote.',`<div class=\"scope-desk\"><form id=\"scope-form\"><label>Work area<select name=\"area\" id=\"scope-area\">${Object.keys(deliverables).map(x=>`<option>${x}</option>`).join('')}</select></label><label>Current stage<select name=\"stage\"><option>Only an idea</option><option>Existing files or system</option><option>Partially working</option><option>Needs repair or expansion</option></select></label><label>Preferred timeline<select name=\"timeline\"><option>Flexible</option><option>Within two weeks</option><option>Within one month</option><option>Specific date</option></select></label><label>Working environment<select name=\"environment\"><option>Google Workspace</option><option>Vercel and web</option><option>Excel or local files</option><option>Still deciding</option></select></label><fieldset class=\"wide\"><legend>Useful handover</legend><div id=\"scope-deliverables\"></div></fieldset><label class=\"wide\">What is difficult right now?<textarea name=\"problem\" rows=\"5\" maxlength=\"500\" required placeholder=\"A short, practical description is enough.\"></textarea></label><label class=\"wide\">What should remain out of scope?<input name=\"boundary\" maxlength=\"180\" placeholder=\"For example: no payment integration in the first release.\"></label><button class=\"ink-button wide\" type=\"submit\">Prepare project brief</button></form><div id=\"scope-output\"><span>BRIEF PREVIEW</span><p>Your choices will appear here. No price or deadline is guessed before the work is reviewed.</p></div></div>`);\n  let message='';\n  function drawOptions(){const area=$('#scope-area').value;$('#scope-deliverables').innerHTML=deliverables[area].map((x,i)=>`<label><input type=\"checkbox\" name=\"deliverable\" value=\"${esc(x)}\" ${i<2?'checked':''}> ${esc(x)}</label>`).join('');}\n  drawOptions();$('#scope-area').onchange=drawOptions;\n  $('#scope-form').onsubmit=e=>{e.preventDefault();if(!e.currentTarget.reportValidity())return;const f=new FormData(e.currentTarget),items=f.getAll('deliverable');message=['Hello Kevin, I would like to discuss a project.','',`Work area: ${f.get('area')}`,`Current stage: ${f.get('stage')}`,`Preferred timeline: ${f.get('timeline')}`,`Environment: ${f.get('environment')}`,`Useful handover: ${items.join(', ')||'To be discussed'}`,'',`Current problem: ${f.get('problem')}`,`Out of scope: ${f.get('boundary')||'To be discussed'}`,'','I understand the scope, timeline, and cost still need to be reviewed together.'].join('\\n');const email=data.settings?.email||'simatupangkevin9@gmail.com',phone=String(data.settings?.whatsapp||'').replace(/\\D/g,'');$('#scope-output').innerHTML=`<span>PROJECT BRIEF / READY TO REVIEW</span><h4>${esc(f.get('area'))}</h4><dl><div><dt>Stage</dt><dd>${esc(f.get('stage'))}</dd></div><div><dt>Timeline</dt><dd>${esc(f.get('timeline'))}</dd></div><div><dt>Handover</dt><dd>${items.map(esc).join(' / ')||'To be discussed'}</dd></div></dl><p>${esc(f.get('problem'))}</p><div class=\"desk-actions\"><button id=\"scope-copy\">Copy brief</button><a class=\"ink-button\" href=\"${phone?'https:\\x2f\\x2fwa.me/'+phone+'?text='+encodeURIComponent(message):'mailto:'+encodeURIComponent(email)+'?subject='+encodeURIComponent('Project discussion')+'&body='+encodeURIComponent(message)}\" target=\"_blank\" rel=\"noopener\">Continue the conversation</a></div>`;$('#scope-copy').onclick=()=>navigator.clipboard?.writeText(message).then(()=>toast('Project brief copied.')).catch(()=>demoDownload('project-brief.txt',message));};\n}\n\nfunction initCreativeLinks(){\n  const nav=document.querySelector('.header nav');if(nav){const labels={field:'Work',lab:'Data lab',research:'Research',profile:'About',resume:'Resume'};nav.querySelectorAll('a').forEach(a=>{const key=a.getAttribute('href')?.slice(1);if(labels[key])a.textContent=labels[key]});}\n  const arrival=document.querySelector('.arrival');\n  if(arrival&&!document.querySelector('.visitor-guide'))arrival.insertAdjacentHTML('afterend',`<section class=\"visitor-guide\" aria-label=\"Choose a path\"><div class=\"guide-intro\"><span class=\"eyebrow\">A SIMPLE WAY THROUGH</span><h2>See the work.<br><i>Then try the thinking.</i></h2><p>Different questions deserve different proof. Choose the path that fits what you came to see.</p></div><div class=\"guide-paths\"><a href=\"#field\"><span>01 / VERIFIED WORK</span><strong>What has Kevin built?</strong><small>Real websites, source links, and decisions.</small><b>Explore projects ↗</b></a><a href=\"#lab\"><span>02 / INTERACTIVE PROOF</span><strong>How does it work?</strong><small>Data systems you can inspect and change.</small><b>Try the lab ↗</b></a><a href=\"#services\"><span>03 / WORK TOGETHER</span><strong>What could we make?</strong><small>Websites, visual identities, presentations, and invitations.</small><b>See services ↗</b></a></div></section>`);\n  const presentation=document.querySelector('#presentation-open');\n  if(presentation){presentation.textContent='Edit the slide sequence ↗';presentation.onclick=()=>{location.href=projectHref('morph-presentation-studio')};}\n  const list=document.querySelector('#experiments .experiments-list');\n  if(list&&!list.querySelector('.logo-study-link'))list.insertAdjacentHTML('beforeend',`<article class=\"experiment logo-study-link\"><span class=\"eyebrow\">05 / VISUAL IDENTITY — INTERACTIVE DEMO</span><div class=\"logo-study-mark\">K<span>↗</span></div><h3>A symbol should hold up at 32 pixels.</h3><p>Explore three vector directions, adjust the initials and color, and export an SVG concept. No fictional client claim.</p><a class=\"text-link\" href=\"${projectHref('identity-mark-studio')}\">Open logo studio <span>↗</span></a></article>`);\n  const services=document.querySelector('#services .service-lanes');\n  if(services&&!services.querySelector('.identity-service'))services.insertAdjacentHTML('beforeend',`<article class=\"identity-service\"><span class=\"eyebrow\">04 / SERVICE</span><h3>Logo & presentation design</h3><p>For a mark, deck, or presentation that needs a clearer visual point of view.</p><ul><li>Logo concepts and vector refinement</li><li>Typography and color direction</li><li>Slide redesign and motion planning</li><li>PowerPoint Morph production by scope</li></ul><small>Original files and usage needs are reviewed before quoting. The browser demos are concepts, not prior client commissions.</small><a class=\"text-link\" href=\"${projectHref('identity-mark-studio')}\">Try the logo demo <span>↗</span></a><a class=\"text-link\" href=\"${projectHref('morph-presentation-studio')}\">Try the slide demo <span>↗</span></a></article>`);\n  if(services&&!services.querySelector('.wedding-service'))services.insertAdjacentHTML('beforeend',`<article class=\"wedding-service\"><span class=\"eyebrow\">05 / SERVICE</span><h3>Wedding invitation websites</h3><p>A personal, mobile-first place for the story and the practical details guests need.</p><ul><li>Custom visual direction and couple story</li><li>Ceremony, reception, maps, and schedule</li><li>Guest-friendly RSVP flow</li><li>Photo and music choices by approval</li></ul><small>Demo names and event details are fictional. Live RSVP storage and domain setup are scoped separately.</small><a class=\"text-link\" href=\"${projectHref('wedding-invitation-demo')}\">Try an invitation <span>↗</span></a></article>`);\n}\nfunction studioDownload(name,content){const blob=new Blob([content],{type:'image/svg+xml;charset=utf-8'});const url=URL.createObjectURL(blob);const a=document.createElement('a');a.href=url;a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(url),1000);}\nfunction creativeStudio(kind){worldStudio(kind);}\nfunction morphStudio(){\n  const root=document.querySelector('#creative-demo');if(!root)return;\n  let scene=0,timer=null;const scenes=['The question','The evidence','The direction'];\n  root.innerHTML=`<div class=\"studio-shell morph-studio\"><div class=\"studio-top\"><span>FRAME / 16:9</span><span>INTERACTIVE STUDY · NOT A PPTX EDITOR</span></div><div class=\"morph-stage\" data-scene=\"0\" data-tone=\"copper\" aria-label=\"Slide preview\"><span class=\"morph-counter\">01 / 03</span><span class=\"morph-kicker\">RESEARCH / PRESENTATION SYSTEM</span><div class=\"morph-object\" aria-hidden=\"true\"><span>THE SAME OBJECT</span></div><div class=\"morph-copy\"><strong class=\"morph-title\"></strong><p class=\"morph-subtitle\"></p></div><span class=\"morph-scene-label\" aria-live=\"polite\">01 / THE QUESTION</span><span class=\"morph-foot\">KEVIN SIMATUPANG / CONCEPT STUDY</span></div><div class=\"morph-timeline\" aria-label=\"Animation progress\"><span></span><span></span><span></span></div><div class=\"studio-controls\"><p class=\"morph-instruction\">Press <b>Play sequence</b>. Follow the orange object as it travels across three connected slides.</p><div class=\"studio-scene-buttons\">${scenes.map((s,i)=>`<button type=\"button\" data-scene=\"${i}\" aria-pressed=\"${i===0}\"><small>0${i+1}</small>${s}</button>`).join('')}</div><div class=\"studio-edit\"><label>Headline<input id=\"morph-heading\" maxlength=\"48\" value=\"Make the complex clear.\"></label><label>Supporting line<input id=\"morph-caption\" maxlength=\"90\" value=\"A good slide gives the idea room to breathe.\"></label><label>Visual direction<select id=\"morph-tone\"><option value=\"copper\">Copper / ink</option><option value=\"chalk\">Chalk / midnight</option><option value=\"signal\">Signal / ivory</option></select></label></div><div class=\"studio-actions\"><button id=\"morph-play\" type=\"button\">Play sequence ▶</button><button id=\"morph-export\" type=\"button\">Download current frame SVG ↓</button></div><p class=\"studio-note\">The same object moves and changes shape between scenes. The downloadable SVG is a still frame; true PowerPoint Morph would be authored separately in a PPTX.</p></div></div>`;\n  const stage=root.querySelector('.morph-stage');const heading=root.querySelector('#morph-heading'),caption=root.querySelector('#morph-caption');\n  function draw(){stage.dataset.scene=String(scene);stage.dataset.tone=root.querySelector('#morph-tone').value;stage.querySelector('.morph-counter').textContent=`0${scene+1} / 03`;stage.querySelector('.morph-scene-label').textContent=`0${scene+1} / ${scenes[scene].toUpperCase()}`;stage.querySelector('.morph-title').textContent=heading.value||'Make the complex clear.';stage.querySelector('.morph-subtitle').textContent=caption.value||'A good slide gives the idea room to breathe.';root.querySelectorAll('[data-scene]').forEach(b=>{if(b.tagName==='BUTTON')b.setAttribute('aria-pressed',String(Number(b.dataset.scene)===scene))});}\n  root.querySelectorAll('button[data-scene]').forEach(b=>b.onclick=()=>{scene=Number(b.dataset.scene);draw()});[heading,caption,root.querySelector('#morph-tone')].forEach(x=>x.oninput=draw);\n  const play=root.querySelector('#morph-play');play.onclick=()=>{if(timer){clearInterval(timer);timer=null;play.textContent='Play sequence ▶';stage.classList.remove('is-playing');return;}scene=(scene+1)%3;draw();stage.classList.add('is-playing');play.textContent='Pause sequence Ⅱ';timer=setInterval(()=>{if(!root.isConnected){clearInterval(timer);return;}scene=(scene+1)%3;draw()},2600)};\n  root.querySelector('#morph-export').onclick=()=>{const colors={copper:['#191b1c','#eae9e4','#eb6a43'],chalk:['#101a2b','#f4f1e8','#a0d4ce'],signal:['#f2eee3','#172021','#d4512a']}[stage.dataset.tone];const title=esc(heading.value||'Make the complex clear.'),sub=esc(caption.value||'A good slide gives the idea room to breathe.');const x=[920,670,1000][scene],y=[245,330,315][scene],r=[145,200,95][scene];studioDownload(`morph-study-frame-0${scene+1}.svg`,`<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 1280 720\"><rect width=\"1280\" height=\"720\" fill=\"${colors[0]}\"/><circle cx=\"${x}\" cy=\"${y}\" r=\"${r}\" fill=\"none\" stroke=\"${colors[2]}\" stroke-width=\"65\"/><text x=\"80\" y=\"100\" fill=\"${colors[2]}\" font-family=\"Arial\" font-size=\"22\" letter-spacing=\"4\">RESEARCH / PRESENTATION SYSTEM</text><text x=\"80\" y=\"400\" fill=\"${colors[1]}\" font-family=\"Arial\" font-size=\"76\" font-weight=\"700\">${title}</text><text x=\"84\" y=\"466\" fill=\"${colors[1]}\" font-family=\"Arial\" font-size=\"26\">${sub}</text><text x=\"82\" y=\"650\" fill=\"${colors[2]}\" font-family=\"Arial\" font-size=\"18\">0${scene+1} / 03 · DEMONSTRATION</text></svg>`)};\n  draw();\n}\nfunction logoStudio(){\n  const root=document.querySelector('#creative-demo');if(!root)return;let direction=0;const palette={ember:['#101416','#f0ede4','#e26341'],cobalt:['#141c39','#f1f0e9','#92bcf8'],olive:['#eae7dc','#1b2b27','#6f8060']};\n  root.innerHTML=`<div class=\"studio-shell logo-studio\"><div class=\"studio-top\"><span>IDENTITY / EXPLORATION</span><span>FICTIONAL MARK · VECTOR OUTPUT</span></div><div class=\"logo-stage\"><div class=\"logo-hero\"><div id=\"logo-large\"></div><p>PRIMARY MARK / LARGE FORMAT</p></div><div class=\"logo-small\"><div id=\"logo-mini\"></div><span>FAVICON TEST<br>32 × 32</span></div></div><div class=\"studio-controls\"><div class=\"studio-scene-buttons\">${['Monogram','Frame','Signal'].map((s,i)=>`<button data-logo=\"${i}\" aria-pressed=\"${i===0}\"><small>0${i+1}</small>${s}</button>`).join('')}</div><div class=\"studio-edit\"><label>Initials<input id=\"logo-initials\" maxlength=\"2\" value=\"KS\" pattern=\"[A-Za-z]{1,2}\" aria-describedby=\"logo-help\"></label><label>Name / wordmark<input id=\"logo-name\" maxlength=\"24\" value=\"KEVIN SIMATUPANG\"></label><label>Palette<select id=\"logo-palette\"><option value=\"ember\">Ember / ink</option><option value=\"cobalt\">Cobalt / midnight</option><option value=\"olive\">Olive / paper</option></select></label></div><p id=\"logo-help\" class=\"studio-note\">Enter one or two Latin letters. Compare the mark at two sizes before exporting. This is a design exploration, not a finished client identity or trademark check.</p><div class=\"studio-actions\"><button id=\"logo-export\">Download SVG vector ↓</button><a class=\"text-link\" href=\"${homeHref('connect')}\">Discuss an identity project ↗</a></div></div></div>`;\n  function svg(small=false){const initials=(root.querySelector('#logo-initials').value.toUpperCase().replace(/[^A-Z]/g,'').slice(0,2)||'KS'),name=esc(root.querySelector('#logo-name').value.trim()||'YOUR NAME'),[bg,ink,accent]=palette[root.querySelector('#logo-palette').value];const shape=direction===0?`<path d=\"M176 125h288v270H176z\" fill=\"none\" stroke=\"${accent}\" stroke-width=\"8\"/>`:direction===1?`<path d=\"M176 125h288v270H176z\" fill=\"none\" stroke=\"${accent}\" stroke-width=\"8\"/><path d=\"M176 395L464 125\" stroke=\"${accent}\" stroke-width=\"8\"/>`:`<circle cx=\"320\" cy=\"260\" r=\"132\" fill=\"none\" stroke=\"${accent}\" stroke-width=\"9\"/><path d=\"M420 160l54-54m-54 0h54v54\" fill=\"none\" stroke=\"${accent}\" stroke-width=\"9\"/>`;return `<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 640 640\" role=\"img\" aria-label=\"${name} logo concept\"><rect width=\"640\" height=\"640\" fill=\"${bg}\"/>${shape}<text x=\"320\" y=\"302\" text-anchor=\"middle\" fill=\"${ink}\" font-family=\"Arial,sans-serif\" font-size=\"144\" font-weight=\"700\" letter-spacing=\"-16\">${initials}</text>${small?'':`<text x=\"320\" y=\"525\" text-anchor=\"middle\" fill=\"${ink}\" font-family=\"Arial,sans-serif\" font-size=\"26\" letter-spacing=\"5\">${name}</text>`}</svg>`}\n  function draw(){root.querySelector('#logo-large').innerHTML=svg();root.querySelector('#logo-mini').innerHTML=svg(true);root.querySelectorAll('[data-logo]').forEach(b=>b.setAttribute('aria-pressed',String(Number(b.dataset.logo)===direction)))}\n  root.querySelectorAll('[data-logo]').forEach(b=>b.onclick=()=>{direction=Number(b.dataset.logo);draw()});['#logo-initials','#logo-name','#logo-palette'].forEach(s=>root.querySelector(s).oninput=draw);root.querySelector('#logo-export').onclick=()=>studioDownload('identity-mark-concept.svg',svg());draw();\n}\nfunction weddingStudio(){\n  const root=document.querySelector('#creative-demo');if(!root)return;\n  root.innerHTML=`<div class=\"wedding-studio\"><div class=\"wedding-editor\"><span class=\"eyebrow\">DESIGN THE INVITATION / FICTIONAL DEMO</span><h3>Make it yours.</h3><p>Adjust the details and see the invitation change. Nothing here is sent or saved.</p><label>First name<input id=\"wed-one\" maxlength=\"22\" value=\"Aruna\"></label><label>Second name<input id=\"wed-two\" maxlength=\"22\" value=\"Bima\"></label><label>Wedding date<input id=\"wed-date\" type=\"date\" value=\"2027-06-12\"></label><label>Visual direction<select id=\"wed-tone\"><option value=\"garden\">Garden / ivory</option><option value=\"midnight\">Midnight / pearl</option><option value=\"terracotta\">Terracotta / sand</option></select></label><a class=\"text-link\" href=\"${homeHref('connect')}\">Discuss your invitation ↗</a></div><div class=\"wedding-preview\" data-tone=\"garden\"><div class=\"wedding-hero\"><span class=\"wedding-overline\">TOGETHER WITH THEIR FAMILIES</span><div class=\"wedding-names\"><span id=\"wed-preview-one\">Aruna</span><i>&</i><span id=\"wed-preview-two\">Bima</span></div><div class=\"wedding-date\" id=\"wed-preview-date\">SATURDAY · 12 JUNE 2027</div><a href=\"#wed-details\" class=\"wedding-scroll\">THE CELEBRATION ↓</a></div><div id=\"wed-details\" class=\"wedding-details\"><div><span>01 / CEREMONY</span><strong>10.00 WITA</strong><small>Garden Hall · Balikpapan</small></div><div><span>02 / RECEPTION</span><strong>18.00 WITA</strong><small>Garden Hall · Balikpapan</small></div><p>These details are fictional. A real site would use your confirmed venue, schedule, photography, and map link.</p></div><form class=\"wedding-rsvp\" id=\"wedding-rsvp\"><span class=\"eyebrow\">YOUR REPLY / DEMO ONLY</span><h3>Will you join us?</h3><label>Your name<input name=\"guest\" required maxlength=\"60\" placeholder=\"Guest name\"></label><label>Attendance<select name=\"attendance\" required><option value=\"\">Choose one</option><option value=\"Yes, I will be there\">Yes, I will be there</option><option value=\"Sorry, I cannot attend\">Sorry, I cannot attend</option></select></label><button type=\"submit\">Preview reply ↗</button><p id=\"wedding-response\" role=\"status\"></p><small>Local preview only. No guest information is stored or transmitted.</small></form></div></div>`;\n  root.querySelector('.wedding-details').insertAdjacentHTML('afterend','<div class=\"wedding-story\"><span class=\"eyebrow\">A SMALL STORY / FICTIONAL</span><h3>Some days become a beginning.</h3><p>We would love to share this one with you. The real invitation would carry the couple’s own words and approved photographs, never a generic story presented as fact.</p></div>');\n  function update(){const first=root.querySelector('#wed-one').value.trim()||'Aruna',second=root.querySelector('#wed-two').value.trim()||'Bima';root.querySelector('#wed-preview-o