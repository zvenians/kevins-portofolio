/* The Living Index — Apps Script / Sheets / Drive */
const INDEX = { version: '1.0.0', maxPdf: 5 * 1024 * 1024, maxImage: 4 * 1024 * 1024 };

function owner_() {
  const email = Session.getActiveUser().getEmail();
  const expected = PropertiesService.getScriptProperties().getProperty('OWNER_EMAIL');
  if (!expected || !email || email.toLowerCase() !== expected.toLowerCase()) throw new Error('Owner access required. Open this app with the Google account that installed it.');
  return email;
}
function setupLivingIndex() {
  const props = PropertiesService.getScriptProperties();
  const active = Session.getActiveUser().getEmail();
  if (!active || active !== Session.getEffectiveUser().getEmail()) throw new Error('Run setup from the Apps Script editor as its owner.');
  if (props.getProperty('OWNER_EMAIL') && props.getProperty('OWNER_EMAIL') !== active) throw new Error('Owner mismatch.');
  props.setProperty('OWNER_EMAIL', active);
  const lock=LockService.getScriptLock(); lock.waitLock(10000);
  try {
    if (!props.getProperty('DATABASE_ID')) {
      const db=SpreadsheetApp.create('The Living Index — Content');
      props.setProperty('DATABASE_ID',db.getId());
      db.getSheets()[0].setName('Projects');
      [['Projects',['id','slug','name','category','visibility','featured','order','updatedAt','contentJson']],['Resume',['id','name','fileId','size','uploadedAt','published']],['Media',['id','name','fileId','mime','size','createdAt']],['Audit',['timestamp','actor','action','recordId']],['Settings',['key','value']]].forEach(function(def){
        const sheet=db.getSheetByName(def[0])||db.insertSheet(def[0]);
        sheet.getRange(1,1,1,def[1].length).setValues([def[1]]).setBackground('#171A1C').setFontColor('#EAE9E4').setFontWeight('bold');sheet.setFrozenRows(1);sheet.setColumnWidths(1,def[1].length,150);
      });
      const projectSheet=db.getSheetByName('Projects');
      projectSheet.getRange(2,1,SEED_PROJECTS.length,9).setValues(SEED_PROJECTS.map(projectRow_));
      projectSheet.getRange('E2:E1000').setDataValidation(SpreadsheetApp.newDataValidation().requireValueInList(['public','draft','private'],true).setAllowInvalid(false).build());
      projectSheet.setColumnWidth(9,400);
    }
    if(!props.getProperty('MEDIA_FOLDER_ID'))props.setProperty('MEDIA_FOLDER_ID',DriveApp.createFolder('The Living Index — Private Media').getId());
    audit_('setup','site');
    console.log('Content database: '+db_().getUrl());
    return {databaseUrl:db_().getUrl(),version:INDEX.version};
  }finally{lock.releaseLock();}
}
function db_(){const id=PropertiesService.getScriptProperties().getProperty('DATABASE_ID');if(!id)throw new Error('Run setupLivingIndex in the Apps Script editor first.');return SpreadsheetApp.openById(id);}
function rows_(name){const sh=db_().getSheetByName(name);if(sh.getLastRow()<2)return[];return sh.getRange(2,1,sh.getLastRow()-1,sh.getLastColumn()).getValues();}
function audit_(action,id){db_().getSheetByName('Audit').appendRow([new Date().toISOString(),Session.getActiveUser().getEmail()||'public',action,id]);}
function safeCell_(v){const s=String(v==null?'':v);return /^[=+@\-]/.test(s)?"'"+s:s;}
function projectRow_(p){return [p.id,p.slug,safeCell_(p.name),safeCell_(p.category),p.visibility,p.featured,p.order,p.updatedAt,JSON.stringify(p)];}
function projects_(privateAccess){return rows_('Projects').map(function(r){try{const p=JSON.parse(r[8]);p.visibility=String(r[4]);p.featured=r[5]===true;p.order=Number(r[6])||0;return p;}catch(e){return null;}}).filter(function(p){return p&&(privateAccess||p.visibility==='public');}).sort(function(a,b){return Number(b.featured)-Number(a.featured)||a.order-b.order;});}
function settings_(){const result={};rows_('Settings').forEach(function(r){if(['email','linkedin','whatsapp','publicUrl'].indexOf(r[0])>=0)result[r[0]]=String(r[1]);});return result;}
function getPublicContent(){return {projects:projects_(false),resume:resumeMeta_(),settings:settings_(),version:INDEX.version};}
function doGet(e){
  const params=e&&e.parameter||{};
  try {
    if(params.format==='json')return ContentService.createTextOutput(JSON.stringify(getPublicContent())).setMimeType(ContentService.MimeType.JSON);
    if(params.format==='file'){
      const file=params.type==='resume'?getResumeFile():params.type==='media'?getMediaFile(String(params.id||'')):null;
      if(!file)throw new Error('Unsupported public file request.');
      return ContentService.createTextOutput(JSON.stringify(file)).setMimeType(ContentService.MimeType.JSON);
    }
    const isAdmin=params.page==='admin';
    if(isAdmin)owner_();
    const bootstrap=isAdmin?getAdminContent():getPublicContent();
    bootstrap.admin=isAdmin;bootstrap.appUrl=ScriptApp.getService().getUrl();bootstrap.projectSlug=params.project||'';
    const safe=JSON.stringify(bootstrap).replace(/</g,'\\u003c').replace(/\u2028/g,'\\u2028').replace(/\u2029/g,'\\u2029');
    const html=ASSETS.html.replace('/*BOOTSTRAP*/', function(){return 'window.INDEX_BOOTSTRAP='+safe+';';}).replace('/*STYLES*/',function(){return ASSETS.css;}).replace('/*CLIENT*/',function(){return ASSETS.client;});
    return HtmlService.createHtmlOutput(html).setTitle(isAdmin?'Manage — The Living Index':'Kevin Simatupang — The Living Index').addMetaTag('viewport','width=device-width, initial-scale=1');
  }catch(error){return HtmlService.createHtmlOutput('<!doctype html><html><body style="background:#0b0d0e;color:#eae9e4;font:18px system-ui;padding:8vw"><h1>The Living Index</h1><p>'+escape_(error.message)+'</p><p>For owner access, use the Google account that installed this project.</p></body></html>').setTitle('The Living Index — Access');}
}
function escape_(s){return String(s).replace(/[&<>"']/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c];});}
function getAdminContent(){owner_();return {projects:projects_(true),resumes:rows_('Resume').map(resumeRow_),media:rows_('Media').map(function(r){return{id:r[0],name:r[1],mime:r[3],size:r[4],createdAt:r[5]};}),audit:rows_('Audit').slice(-30).reverse(),settings:settings_(),databaseUrl:db_().getUrl()};}
function validateProject_(p){
 if(!p||typeof p!=='object')throw new Error('Project content is missing.');
 ['id','slug'].forEach(function(k){if(!/^[a-z0-9]+(?:-[a-z0-9]+)*$/.test(p[k]||''))throw new Error(k+' must contain lowercase words separated by hyphens.');});
 ['name','title','summary','category','challenge','approach','implementation','outcome','tradeoff'].forEach(function(k){if(typeof p[k]!=='string'||!p[k].trim()||p[k].length>6000)throw new Error('Please check '+k+'.');});
 if(['public','draft','private'].indexOf(p.visibility)<0)throw new Error('Invalid visibility.');
 if(['Real Project','Interactive Demo','Case Study','Concept','Historical Prototype','In Progress'].indexOf(p.status)<0)throw new Error('Invalid status.');
 if(['portal','archive','governance','editorial','exploration','history'].indexOf(p.visual)<0)throw new Error('Invalid exhibit style.');
 ['disciplines','technologies','evidence'].forEach(function(k){if(!Array.isArray(p[k])||p[k].some(function(v){return typeof v!=='string'||v.length>500;}))throw new Error('Invalid '+k+'.');});
 ['repositoryUrl','liveUrl','coverUrl'].forEach(function(k){if(p[k]&&!/^https:\/\/[^\s<>"']+$/.test(p[k]))throw new Error(k+' must be a valid HTTPS URL.');});
 if(!Number.isFinite(Number(p.order))||typeof p.featured!=='boolean')throw new Error('Invalid ordering.');
 if(JSON.stringify(p).length>45000)throw new Error('Project exceeds the content size limit.');
 return JSON.parse(JSON.stringify(p));
}
function saveProject(project){owner_();const p=validateProject_(project);const lock=LockService.getScriptLock();lock.waitLock(10000);try{const all=projects_(true);if(all.some(function(x){return x.slug===p.slug&&x.id!==p.id;}))throw new Error('That project URL is already used.');const old=all.find(function(x){return x.id===p.id;});if(old&&old.updatedAt!==p.updatedAt)throw new Error('This project changed in another session. Reload before saving.');p.updatedAt=new Date().toISOString();const sh=db_().getSheetByName('Projects');const values=rows_('Projects');const index=values.findIndex(function(r){return r[0]===p.id;});sh.getRange(index<0?sh.getLastRow()+1:index+2,1,1,9).setValues([projectRow_(p)]);audit_('project.'+p.visibility,p.id);return p;}finally{lock.releaseLock();}}
function saveSettings(input){owner_();const allowed=['email','linkedin','whatsapp'];const rows=[];allowed.forEach(function(k){const value=String(input[k]||'').trim();if(value.length>300)throw new Error('Setting too long.');if(k==='email'&&value&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value))throw new Error('Invalid email.');if(k==='linkedin'&&value&&!/^https:\/\/(www\.)?linkedin\.com\//.test(value))throw new Error('Use a LinkedIn HTTPS link.');if(k==='whatsapp'&&value&&!/^\d{8,15}$/.test(value))throw new Error('WhatsApp needs country code and digits only.');rows.push([k,safeCell_(value)]);});const lock=LockService.getScriptLock();lock.waitLock(10000);try{const sh=db_().getSheetByName('Settings');sh.getRange(2,1,3,2).setValues(rows);audit_('settings.update','site');return settings_();}finally{lock.releaseLock();}}
function resumeRow_(r){return{id:r[0],name:r[1],fileId:r[2],size:r[3],uploadedAt:r[4],published:r[5]===true};}
function resumeMeta_(){const row=rows_('Resume').find(function(r){return r[5]===true;});if(!row)return null;const r=resumeRow_(row);delete r.fileId;return r;}
function validateUpload_(data,pdf){if(!data||typeof data.base64!=='string'||data.base64.length>(pdf?INDEX.maxPdf:INDEX.maxImage)*1.4)throw new Error('File is too large.');const bytes=Utilities.base64Decode(data.base64);if(bytes.length>(pdf?INDEX.maxPdf:INDEX.maxImage)||bytes.length<8)throw new Error('Invalid file size.');if(pdf){if(data.mime!=='application/pdf'||String.fromCharCode.apply(null,bytes.slice(0,5).map(function(n){return n&255;}))!=='%PDF-')throw new Error('Upload a valid PDF file.');}else{const b=bytes.map(function(n){return n&255;});const png=b[0]===137&&b[1]===80&&b[2]===78&&b[3]===71;const jpg=b[0]===255&&b[1]===216&&b[2]===255;if(!((png&&data.mime==='image/png')||(jpg&&data.mime==='image/jpeg')))throw new Error('Use a PNG or JPEG image.');}return bytes;}
function uploadResume(data){owner_();const bytes=validateUpload_(data,true);const name=String(data.name||'resume.pdf').replace(/[^a-zA-Z0-9._ -]/g,'_').slice(0,100);const folder=DriveApp.getFolderById(PropertiesService.getScriptProperties().getProperty('MEDIA_FOLDER_ID'));const file=folder.createFile(Utilities.newBlob(bytes,'application/pdf',name));const r={id:Utilities.getUuid(),name:name,fileId:file.getId(),size:bytes.length,uploadedAt:new Date().toISOString(),published:false};const lock=LockService.getScriptLock();lock.waitLock(10000);try{db_().getSheetByName('Resume').appendRow([r.id,r.name,r.fileId,r.size,r.uploadedAt,false]);audit_('resume.upload',r.id);}finally{lock.releaseLock();}return r;}
function publishResume(id){owner_();const lock=LockService.getScriptLock();lock.waitLock(10000);try{const rows=rows_('Resume');if(id&&!rows.some(function(r){return r[0]===id;}))throw new Error('Resume version not found.');if(rows.length)db_().getSheetByName('Resume').getRange(2,6,rows.length,1).setValues(rows.map(function(r){return[r[0]===id];}));audit_(id?'resume.publish':'resume.unpublish',id||'all');return resumeMeta_();}finally{lock.releaseLock();}}
function getResumeFile(id){let row;if(id){owner_();row=rows_('Resume').find(function(r){return r[0]===id;});}else row=rows_('Resume').find(function(r){return r[5]===true;});if(!row)throw new Error('No resume is published yet.');const blob=DriveApp.getFileById(row[2]).getBlob();return{name:row[1],mime:'application/pdf',base64:Utilities.base64Encode(blob.getBytes())};}
function uploadMedia(data){owner_();const bytes=validateUpload_(data,false);const name=String(data.name||'image').replace(/[^a-zA-Z0-9._ -]/g,'_').slice(0,100);const file=DriveApp.getFolderById(PropertiesService.getScriptProperties().getProperty('MEDIA_FOLDER_ID')).createFile(Utilities.newBlob(bytes,data.mime,name));const id=Utilities.getUuid();db_().getSheetByName('Media').appendRow([id,name,file.getId(),data.mime,bytes.length,new Date().toISOString()]);audit_('media.upload',id);return{id:id,name:name};}
function getMediaFile(id){const projects=projects_(false);if(!projects.some(function(p){return p.mediaId===id;}))owner_();const row=rows_('Media').find(function(r){return r[0]===id;});if(!row)throw new Error('Image unavailable.');return{mime:row[3],base64:Utilities.base64Encode(DriveApp.getFileById(row[2]).getBlob().getBytes())};}

const SEED_PROJECTS = [{"slug":"galilea-web-portal","title":"A place to gather.","name":"GMAHK Galilea","summary":"Worship resources, community information, and presentation tools in one considered place.","category":"Web Engineering","disciplines":["Digital Products","UI/UX","Cloud & APIs"],"technologies":["JavaScript","CSS","Google Apps Script","Google Sheets","Vercel","Service Worker"],"status":"Real Project","visual":"portal","coverUrl":"https://raw.githubusercontent.com/zvenians/gmahk-galilea/21a5dd238279f61a48eebcaad59729ccb2da66c8/docs/visitor-ui-proof.jpg","liveUrl":"https://gmahk-galilea.vercel.app","challenge":"A community website needs to serve someone finding a service time and someone presenting a hymn on a large screen. Those are very different reading conditions.","approach":"Keep the public interface lightweight. Separate the reader, schedule, appearance controls, and presentation behaviors into focused modules.","implementation":"A Vercel API layer connects the browser to Google Apps Script. Sheets provide editable content. Service-worker caching, reader preferences, and fullscreen controls support the worship experience.","outcome":"The repository contains a public portal, Bible and hymnal readers, Sabbath presentations, theme controls, and operational verification scripts. Performance gains are not quantified here.","tradeoff":"Cached public content needs explicit invalidation. Apps Script changes have their own release cycle, separate from a frontend deployment.","evidence":["viewer.js","sw.js","api/gas.js","sabbath-presentation.js","appearance.css"],"id":"galilea-web-portal","featured":true,"order":0,"visibility":"public","updatedAt":"2026-10-22","repositoryUrl":"https://github.com/zvenians/gmahk-galilea","revision":"21a5dd238279f61a48eebcaad59729ccb2da66c8"},{"slug":"galilea-digital-archive","title":"Files, with a place.","name":"Galilea Digital Archive","summary":"A cloud-connected archive that makes recurring records easier to find and manage.","category":"Digital Products","disciplines":["Web Engineering","Cloud & APIs"],"technologies":["Next.js","React","TypeScript","Tailwind CSS","Firebase","Google Drive API"],"status":"Real Project","visual":"archive","coverUrl":"https://raw.githubusercontent.com/zvenians/gmahk-galilea-digital-archive/9a4b68ee28fa13775ad958048b3b412af3d918c9/public/jesus-hero.jpg","liveUrl":"https://drive-galilea.vercel.app","challenge":"Recurring documents and media need predictable organization without giving every visitor administrative access to cloud storage.","approach":"Organize records by category and time, then put authentication and folder boundaries between the interface and Google Drive.","implementation":"Next.js route handlers coordinate Drive API operations. Firebase verifies identity and stores records. Resumable upload helpers, a queue, cache utilities, and download routes separate the main responsibilities.","outcome":"Source inspection confirms archive browsing, upload handling, media endpoints, and administrative routes. The exhibit below is a local simulation using fictional records.","tradeoff":"OAuth credentials and Drive quotas remain external dependencies. A successful interface render alone does not prove every production upload path works.","evidence":["src/lib/drive.ts","src/lib/auth-server.ts","src/lib/resumable-upload.ts","src/app/api/upload/route.ts"],"id":"galilea-digital-archive","featured":true,"order":1,"visibility":"public","updatedAt":"2026-10-22","repositoryUrl":"https://github.com/zvenians/gmahk-galilea-digital-archive","revision":"9a4b68ee28fa13775ad958048b3b412af3d918c9"},{"slug":"majelis-galilea","title":"Less fragmentation.","name":"Majelis Galilea","summary":"Meetings, decisions, budgets, and documents connected through a shared administrative system.","category":"Business Systems","disciplines":["Cloud & APIs","Data & Automation"],"technologies":["JavaScript","Google Apps Script","Google Sheets","Vercel","Google Drive"],"status":"Real Project","visual":"governance","liveUrl":"https://majelis-galilea.vercel.app","challenge":"Administrative work crosses many boundaries: a meeting produces a decision, a decision produces an assignment, and an assignment may affect a budget or document.","approach":"Connect the workflow around shared records and explicit permissions, with a clearer interface for each responsibility.","implementation":"A browser administration shell calls a Vercel proxy and Apps Script business logic. Sheets hold related records; the backend contains role checks and document-generation workflows.","outcome":"The source includes meeting and governance workflows, finance, membership, assets, and official correspondence. No confidential administrative records are reproduced.","tradeoff":"Sheets is familiar to operators, but relational integrity, concurrent edits, and authorization require deliberate application logic.","evidence":["admin/js/core.js","admin/js/features.js","api/gas.js","apps-script/Code.gs","scripts/test-access-boundaries.js"],"id":"majelis-galilea","featured":true,"order":2,"visibility":"public","updatedAt":"2026-10-22","repositoryUrl":"https://github.com/zvenians/majelis-galilea","revision":"748021b9211b0ac2edc45c7fa15d13b5a4235f70"},{"slug":"naomi-rouli","title":"The pace of a story.","name":"Naomi Rouli","summary":"An editorial study in typography, quiet movement, and the space between chapters.","category":"Creative Experiments","disciplines":["UI/UX","Visual Communication"],"technologies":["HTML","CSS","JavaScript","Firebase Hosting"],"status":"Real Project","visual":"editorial","liveUrl":"https://naomirouli.web.app","challenge":"A personal story needs pacing and emotional clarity without turning every screen into another effect.","approach":"Structure the experience into nine scenes. Let typography, composition, and chapter changes carry the narrative.","implementation":"Vanilla JavaScript uses IntersectionObserver for chapter navigation and pointer capture for a horizontal photo rail. CSS custom properties maintain the editorial system.","outcome":"The public repository supports the interaction techniques described here. This exhibit uses an original typographic illustration; private photographs and personal letters are not reused.","tradeoff":"The interface is intentionally bespoke. Reusing its technical patterns is more appropriate than republishing its personal content.","evidence":["script.js","style.css","index.html","firebase.json"],"id":"naomi-rouli","featured":true,"order":3,"visibility":"public","updatedAt":"2026-10-22","repositoryUrl":"https://github.com/zvenians/naomirouli","revision":"486fea3ead595309b8fc1a97d573aa3ec334ec97"},{"slug":"zvenians-exploration","title":"Learning restraint.","name":"Zvenians Web Exploration","summary":"An independent study of product composition, responsive rhythm, and disciplined typography.","category":"Creative Experiments","disciplines":["Web Engineering","UI/UX"],"technologies":["HTML","CSS","JavaScript","GitHub Pages"],"status":"Concept","visual":"exploration","liveUrl":"https://zvenians.github.io","challenge":"Understand how a consistent visual system can support different product stories across a static website.","approach":"Work with type scale, whitespace, full-width compositions, and responsive layouts before adding interaction.","implementation":"Semantic HTML, CSS layout primitives, and lightweight JavaScript. GitHub Pages hosts the static output.","outcome":"An independent educational design exploration, not a commercial engagement or an official Apple website.","tradeoff":"Promotional imagery in the original project is not republished here. This case study focuses on layout techniques.","evidence":["README.md","index.html","mac.html","store.html"],"id":"zvenians-exploration","featured":false,"order":4,"visibility":"public","updatedAt":"2026-10-22","repositoryUrl":"https://github.com/zvenians/zvenians.github.io","revision":"726ef582d4ec955929c58701bcf2cf318a29ce9e"},{"slug":"galilea-origins","title":"Every system starts somewhere.","name":"Galilea Origins","summary":"A historical marker connecting an early idea to the later, dedicated platforms.","category":"Creative Experiments","disciplines":["Web Engineering"],"technologies":["Documentation"],"status":"Historical Prototype","visual":"history","challenge":"The early namespace represents the beginning of a broader church web initiative.","approach":"Keep the historical context visible without counting it as another completed application.","implementation":"At the audited revision, this repository contains a README only. The active implementations live in the three dedicated Galilea repositories.","outcome":"Useful as a timeline marker, not evidence of a functioning prototype.","tradeoff":"No executable application was found in this repository.","evidence":["README.md"],"id":"galilea-origins","featured":false,"order":5,"visibility":"public","updatedAt":"2026-10-22","repositoryUrl":"https://github.com/zvenians/galilea","revision":"b3b1f0a586aefc29fe7b4c2718dd27f0d67ee188"},{"slug":"ruang-temu-booking-demo","title":"Booking, without the back-and-forth.","name":"Ruang Temu — Booking Demo","summary":"A local-service booking demo that helps customers choose a service, pick a time, and send one clear booking summary.","category":"Digital Products","disciplines":["Web Engineering","UI/UX"],"technologies":["JavaScript","Responsive UI","Form Validation","Local State","WhatsApp Flow"],"status":"Interactive Demo","visual":"booking","challenge":"Small businesses often handle bookings through open-ended chat. Customers ask for details one by one, while the owner has to copy schedules and service details by hand.","approach":"Turn the conversation into a simple flow: choose a service, date, and time, then review everything in one place. WhatsApp stays familiar, but the message arrives complete and easier to process.","implementation":"The demo runs locally in the browser with form validation, changing time slots, a booking summary, and clear feedback. Every name, schedule, and transaction is fictional and disconnected from a real business.","outcome":"Visitors can try the booking flow from the first choice to the final summary. It proves the interface logic and responsive behavior; it is not presented as a client production system.","tradeoff":"Payments, customer accounts, a production database, and an owner calendar are intentionally outside this demo. Those features need real operating rules before they should be built.","evidence":["Working service and time-slot selection","Name, date, and contact validation","A booking summary ready to share","Responsive behavior without real business data"],"id":"ruang-temu-booking-demo","featured":true,"order":6,"visibility":"public","updatedAt":"2026-10-23"},{"slug":"sera-goods-commerce-demo","title":"A small shop with serious order logic.","name":"SERA Goods — Commerce Demo","summary":"A detailed storefront demonstration with product discovery, variants, stock-aware cart logic, vouchers, shipping choices, and a clear checkout review.","category":"Digital Products","disciplines":["Web Engineering","Business Systems","UI/UX"],"technologies":["Google Apps Script","Google Sheets","JavaScript","Cart State","Voucher Rules","Shipping Logic"],"status":"Interactive Demo","visual":"commerce","challenge":"A small online shop needs more than attractive product cards. Prices, variants, stock, vouchers, shipping, and order details have to stay consistent from the first browse to the final confirmation.","approach":"Build one short buying flow around the decisions that matter: find a product, choose the right variant, understand the total, and review the order before anything is submitted. Administrative complexity stays behind the storefront.","implementation":"The public exhibit runs as a safe local simulation with a searchable catalogue, category filters, variant-aware stock, quantity controls, voucher validation, configurable shipping, and checkout validation. The production blueprint maps Products, Variants, Vouchers, Shipping, Orders, and Order Items to Google Sheets, with Apps Script rechecking prices and stock before writing an order.","outcome":"Visitors can complete the full storefront journey and inspect the business rules behind it. All products, prices, stock, addresses, vouchers, and order numbers are fictional demonstration data.","tradeoff":"The exhibit does not process payments, contact a courier API, upload real products, or save customer details. A production version would require authenticated administration, Drive media storage, server-side order locking, rate limits, and verified payment or shipping integrations.","evidence":["Searchable and filterable product catalogue","Variant and stock-aware cart calculations","Voucher eligibility and discount limits","Shipping selection and final checkout review","Google Sheets and Apps Script production data model"],"id":"sera-goods-commerce-demo","featured":true,"order":7,"visibility":"public","updatedAt":"2026-10-23"},{"slug":"operations-decision-workbench","title":"A decision should leave a trail.","name":"Operations Decision Workbench","summary":"A procurement and operations demonstration that compares vendor offers with editable weights, transparent formulas, and an exportable decision workbook.","category":"Data & Automation","disciplines":["Data & Automation","Business Systems","Operational Systems"],"technologies":["Excel","Google Sheets","Google Apps Script","Weighted Scoring","Formula Auditing","XLSX Export"],"status":"Interactive Demo","visual":"operations","challenge":"Choosing a supplier from several quotations is rarely a lowest-price decision. Lead time, warranty, documentation, technical compliance, and approval notes need to stay visible without turning the process into an untraceable spreadsheet.","approach":"Keep the decision model small enough to inspect. Each criterion has an explicit weight, every vendor score uses the same normalization rule, and the current recommendation changes as the priorities change.","implementation":"The browser demonstration recalculates four fictional vendor offers in real time. The downloadable Excel workbook separates source quotations, settings, and formula-based scoring so a reviewer can trace the result instead of trusting a fixed dashboard number. The wider Data Lab also includes field validation, maintenance records, reconciliation, scheduling, budgets, and cleanup workflows.","outcome":"Visitors can change the decision weights, compare commercial and technical trade-offs, and download a functioning workbook with editable inputs and formulas. No real vendor, quote, or company record is used.","tradeoff":"Weighted scoring helps structure a review but cannot approve a purchase. A production workflow still needs procurement policy, authorized reviewers, document verification, conflict checks, and controlled access to actual quotations.","evidence":["Editable price, lead-time, warranty, and compliance weights","Normalized multi-criteria vendor scoring","Formula-based XLSX decision workbook","Clear distinction between recommendation and approval"],"id":"operations-decision-workbench","featured":true,"order":8,"visibility":"public","updatedAt":"2026-10-23"},{"slug":"research-practice-toolkit","title":"Research support that shows its reasoning.","name":"Research Practice Toolkit","summary":"Eight local research tools for method selection, sample planning, assumption review, result tables, questionnaire structure, citations, defense practice, and revision tracking.","category":"Data & Automation","disciplines":["Data & Automation","Research Support","Technical Documentation"],"technologies":["SPSS Planning","Statistical Reasoning","JavaScript","CSV Export","Local State","Research Writing"],"status":"Interactive Demo","visual":"researchtools","challenge":"Research support can become vague or irresponsible when it only promises a finished answer. Students need to see how a method connects to a question, what assumptions need attention, and where their own academic judgment is still required.","approach":"Turn the support process into inspectable tools. Each module explains its rule, exposes the inputs, gives a cautious output, and names what it cannot decide. The interface supports learning and revision instead of replacing the student.","implementation":"Eight browser-based modules cover method advising, survey sample estimates, assumption diagnostics, formatted result tables, questionnaire blueprints, author-year consistency checks, defense-question practice, and a locally saved revision plan. Sample exports are generated without uploading research data.","outcome":"Visitors can test a research decision from planning through defense preparation and download selected working files. All examples are fictional, and all generated writing is labeled as a draft for student and supervisor review.","tradeoff":"The toolkit does not run SPSS, verify source authenticity, approve a methodology, write a thesis, fabricate data, or guarantee an academic result. Discipline-specific decisions still require qualified supervision and the student’s own work.","evidence":["Research-method decision helper","Finite-population sample-size calculation","Assumption and influence diagnostics","Questionnaire and result-table CSV exports","Citation consistency review","Defense practice and local revision tracker"],"id":"research-practice-toolkit","featured":true,"order":9,"visibility":"public","updatedAt":"2026-10-23"},{"slug":"asset-field-companion","title":"The network can wait. The observation should not.","name":"Asset Field Companion","summary":"An offline-first field workflow for finding an asset, recording its condition, attaching evidence, and synchronizing a reviewable observation later.","category":"Business Systems","disciplines":["Operational Systems","Web Engineering","Data & Automation"],"technologies":["Progressive Web App","Local Queue","Google Apps Script","Google Sheets","Responsive Forms"],"status":"Interactive Demo","visual":"fieldcompanion","challenge":"Field verification does not always happen beside a reliable connection. A useful tool has to preserve the inventory context, make evidence easy to record on a phone, and show clearly what is local, queued, or synchronized.","approach":"Treat every observation as a small controlled handover. The interface keeps the expected record beside the actual condition, saves work locally first, and lets the operator decide when the queue is ready to synchronize.","implementation":"The demonstration supports asset selection, field condition, observed location, notes, optional photo selection, an offline switch, a persistent local queue, and simulated synchronization. A production version would use a service worker and authenticated Apps Script writes into controlled Sheets and Drive folders.","outcome":"Visitors can complete a realistic mobile field flow and see the difference between a saved observation and a synchronized record. All asset numbers, locations, and departments are fictional.","tradeoff":"The public demo does not upload photos, request precise location, scan a real QR code, or write to production storage. Those capabilities require clear consent, authentication, retention rules, and conflict handling.","evidence":["Persistent browser-local observation queue","Offline and restored-network states","Condition, location, note, and evidence workflow","Explicit sync status and production boundary"],"id":"asset-field-companion","featured":true,"order":10,"visibility":"public","updatedAt":"2026-10-23"},{"slug":"research-data-preparation-studio","title":"Good analysis begins before the Analyze menu.","name":"Research Data Preparation Studio","summary":"A hands-on preparation desk for missing codes, duplicate respondents, reverse scoring, implausible values, codebooks, and SPSS-ready working files.","category":"Data & Automation","disciplines":["Research Support","Data & Automation","Technical Documentation"],"technologies":["SPSS Syntax","CSV Export","Codebook Design","Data Validation","JavaScript"],"status":"Interactive Demo","visual":"dataprep","challenge":"Statistical output can look precise even when the input still contains duplicate IDs, hidden missing-value codes, incorrectly scored items, or impossible values. Those decisions need to be recorded before testing begins.","approach":"Keep the raw import unchanged and create a separate working copy. Every correction is visible in a preparation log, while the codebook explains what each variable means and how it should be treated.","implementation":"The browser tool identifies a duplicate respondent, converts a chosen missing code, optionally reverse-scores Q2R, calculates a scale mean, flags an implausible age, and exports both a prepared CSV and starter SPSS syntax.","outcome":"Visitors can move a small fictional survey from raw rows to a documented analysis-ready copy without uploading anything. The generated files remain editable and clearly labeled as demonstrations.","tradeoff":"The tool does not determine whether a response should be deleted, validate an instrument, replace subject-matter judgment, or open proprietary SPSS files. A real engagement begins with the actual codebook and research protocol.","evidence":["Raw and prepared views remain separate","Missing-code and duplicate handling","Reverse scoring and computed scale mean","CSV, codebook, and SPSS syntax outputs"],"id":"research-data-preparation-studio","featured":true,"order":11,"visibility":"public","updatedAt":"2026-10-23"},{"slug":"document-automation-studio","title":"A document is easier to trust when its source is clear.","name":"Document Automation Studio","summary":"A controlled Sheets-to-document workflow for references, structured fields, draft status, PDF generation, and an archive-ready activity record.","category":"Business Systems","disciplines":["Document Systems","Data & Automation","Workflow Design"],"technologies":["Google Apps Script","Google Sheets","Google Docs","Google Drive","PDF Generation"],"status":"Interactive Demo","visual":"documents","challenge":"Recurring reports and letters are often copied from an old file until their reference, wording, or approval state becomes uncertain. The document needs a dependable source and a visible lifecycle.","approach":"Separate structured data from presentation. A small form supplies the controlled fields, the document preview makes the result inspectable, and the archive log records what would be generated and where it belongs.","implementation":"The demonstration builds four document types from editable inputs, refreshes an A4-style draft, generates a real sample PDF, and exports a compact archive log. The production blueprint maps the same flow to Sheets, Docs templates, Apps Script, and Drive.","outcome":"Visitors can produce a usable fictional report while seeing its reference, draft state, owner, generation date, and archive destination. No confidential company document is reproduced.","tradeoff":"A generated draft is not an approval. Production use still requires authorized templates, access controls, version retention, naming policy, and a clear sign-off process.","evidence":["Structured document input","Controlled A4-style preview","Real client-side PDF output","Archive log with reference and status"],"id":"document-automation-studio","featured":true,"order":12,"visibility":"public","updatedAt":"2026-10-23"},{"slug":"sera-commerce-operations-console","title":"Checkout is only the beginning of the order.","name":"SERA Commerce Operations Console","summary":"The back-office half of the SERA storefront: fulfilment stages, stock movements, reorder signals, return review, margin context, and a daily close.","category":"Digital Products","disciplines":["Business Systems","Web Engineering","Data & Automation"],"technologies":["Inventory Ledger","Order Fulfilment","Google Sheets","Google Apps Script","CSV Export"],"status":"Interactive Demo","visual":"commerceops","challenge":"A polished storefront does not explain what happens after payment. Stock changes, picking, packing, shipping, returns, and end-of-day review need consistent rules behind the public interface.","approach":"Use a compact operations desk instead of another marketing dashboard. Orders move through explicit stages, every stock adjustment has a reason, and low-stock items remain visible during the daily close.","implementation":"The local demonstration advances fictional orders, resolves a return-review exception, posts stock movements with validation, calculates visible gross margin, identifies reorder items, and exports a daily operational record.","outcome":"The original storefront and this console now show both sides of a commerce system: the customer journey and the work required to fulfil it. No order, payment, or customer record leaves the browser.","tradeoff":"The demo has no payment reconciliation, courier webhook, accounting integration, or multi-user stock lock. Those features require verified external services and server-side transactional controls.","evidence":["Order-stage workflow","Validated stock movement ledger","Reorder and gross-margin context","Exportable daily close"],"id":"sera-commerce-operations-console","featured":true,"order":13,"visibility":"public","updatedAt":"2026-10-23"},{"slug":"quality-evidence-room","title":"Quality is a record, not an adjective.","name":"Performance & Accessibility Evidence Room","summary":"A transparent release-review surface for responsive behavior, keyboard safeguards, reduced motion, semantic structure, and clearly bounded evidence.","category":"Creative Experiments","disciplines":["Web Engineering","UI/UX","Technical Documentation"],"technologies":["Accessibility","Responsive Design","Release Checks","Reduced Motion","Progressive Enhancement"],"status":"Interactive Demo","visual":"qualityroom","challenge":"Claims such as fast, responsive, and accessible are easy to write and easy to exaggerate. A credible portfolio should separate what the current page can inspect from what still requires external measurement.","approach":"Present release evidence as a small review room. The visitor can resize a real composition, run document-level checks, copy the result, and read the boundary around performance claims.","implementation":"The tool inspects the live document for a skip link, main landmark, dialog labels, reduced-motion path, keyboard-scrollable tables, stable project URLs, and demonstration disclosure. It deliberately does not invent Lighthouse or Core Web Vitals scores.","outcome":"Visitors see how quality work is documented instead of receiving an unsupported score. The responsive sample also makes layout behavior observable rather than replacing it with screenshots.","tradeoff":"DOM checks cannot replace assistive-technology testing, real-user metrics, slow-network trials, or cross-browser QA. Those results should only be published after the corresponding test has actually run.","evidence":["Live semantic document checks","Responsive width instrument","Copyable release report","Explicit measurement limitations"],"id":"quality-evidence-room","featured":false,"order":14,"visibility":"public","updatedAt":"2026-10-23"},{"slug":"project-brief-scope-builder","title":"A useful brief before a confident estimate.","name":"Project Brief & Scope Builder","summary":"A practical intake tool for websites, data work, research support, and automation—without guessing a price or promising an unreviewed deadline.","category":"Business Systems","disciplines":["Workflow Design","Client Communication","Information Architecture"],"technologies":["Form Validation","Structured Briefs","WhatsApp Handoff","Email Handoff","Local Processing"],"status":"Interactive Demo","visual":"scopebuilder","challenge":"A first message often contains either too little information or a long list of disconnected features. Both make it difficult to understand the actual problem, handover, and boundary.","approach":"Ask only for the choices that improve the first conversation: work area, current stage, working environment, useful deliverables, the immediate problem, and what should stay outside the first scope.","implementation":"The builder changes its handover options by service area, validates the brief, creates a readable summary, copies it to the clipboard, and prepares a WhatsApp or email handoff using the published contact settings. Nothing is stored by the page.","outcome":"A prospective client can arrive with an unclear need and leave with a concise message that Kevin can review. Cost and timing remain discussion points instead of fabricated instant calculations.","tradeoff":"The generated brief is not a contract, proposal, quotation, or technical discovery. Sensitive files should only be shared through an agreed channel after the initial review.","evidence":["Service-specific handover choices","Clear scope-boundary prompt","Copyable structured brief","Contact handoff without public data storage"],"id":"project-brief-scope-builder","featured":false,"order":15,"visibility":"public","updatedAt":"2026-10-23"},{"id":"morph-presentation-studio","slug":"morph-presentation-studio","title":"Give the idea room to move.","name":"Morph Presentation Studio","summary":"An editable slide sequence where the same objects move between layouts—an interactive study of presentation pacing.","category":"Visual Communication","disciplines":["Presentation Design","Motion","Typography"],"technologies":["HTML","CSS Transitions","JavaScript","SVG Export"],"status":"Interactive Demo","visual":"morphslides","featured":false,"order":16,"visibility":"public","updatedAt":"2026-10-25","challenge":"Dense slides make an audience read instead of listen. Movement can clarify the relationship between ideas when it follows the same visual objects.","approach":"Keep three slides connected by one numbered marker, headline, and geometric object. Let visitors change the wording and choose a visual direction before playing the sequence.","implementation":"A browser-local stage changes the layout of persistent DOM elements across three scenes. CSS interpolates their position, scale, shape, and color; reduced-motion removes the tween. Export creates an SVG of the selected frame, not a PowerPoint file.","outcome":"Visitors can edit copy, switch themes, step between slides, autoplay, and download an SVG still. This demonstrates slide direction and Morph-like behavior, not a completed PowerPoint commission.","tradeoff":"Actual PowerPoint Morph animations require an authored .pptx and are not produced by this browser preview. The export is a static SVG frame.","evidence":["Editable copy","Three connected scenes","Reduced-motion support","SVG still export"]},{"id":"identity-mark-studio","slug":"identity-mark-studio","title":"A mark with a point of view.","name":"Identity Mark Studio","summary":"A small, functioning logo workbench: explore structure, weight, contrast, and export a vector concept.","category":"Visual Communication","disciplines":["Logo Design","Visual Identity","Typography"],"technologies":["SVG","JavaScript","Design Systems"],"status":"Interactive Demo","visual":"logostudio","featured":false,"order":17,"visibility":"public","updatedAt":"2026-10-25","challenge":"A useful logo must work as a system, not only as a large image on a moodboard.","approach":"Offer a compact set of structural directions and test each at large and small sizes with deliberate color choices.","implementation":"The browser renders a live SVG from sanitized initials, geometric construction, color, and wordmark. Visitors can switch three directions and download the selected vector as SVG.","outcome":"A usable exploration of logo decisions and scalable output. All names and marks are fictional concepts, not client work or a claim of registered identity.","tradeoff":"This is a concept generator, not a trademark search, final identity strategy, or a substitute for a custom design engagement.","evidence":["Live vector construction","Small-size preview","Three design directions","SVG download"]},{"id":"wedding-invitation-demo","slug":"wedding-invitation-demo","title":"An invitation worth opening.","name":"Wedding Invitation Experience","summary":"A responsive digital wedding invitation with a live design editor, event details, a fictional story, and RSVP simulation.","category":"Visual Communication","disciplines":["Website Design","Invitation Design","Responsive UX"],"technologies":["HTML","CSS","JavaScript","Accessible Forms"],"status":"Interactive Demo","visual":"wedding","featured":false,"order":18,"visibility":"public","updatedAt":"2026-10-25","challenge":"An invitation should feel personal without making guests search for the date, location, or RSVP.","approach":"Lead with the couple, then give the event facts a clear reading order. Keep the guest journey calm on a phone and make every important action available without animation.","implementation":"The demo updates fictional names, date, and visual direction in real time. It shows ceremony and reception details, an illustrative story, and a local RSVP confirmation with input validation. It does not send, store, or publish guest data.","outcome":"Visitors can inspect a responsive invitation flow and try the RSVP safely. This is a fictional demonstration, not a commissioned couple or production guest list.","tradeoff":"A real invitation requires approved photographs, precise event details, delivery and RSVP storage, privacy choices, and an agreed domain or hosting plan.","evidence":["Responsive invitation preview","Live content controls","Accessible RSVP validation","No public guest data storage"]}];
