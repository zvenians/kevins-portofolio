>{const author=line.trim().match(/^([A-Z][A-Za-zÀ-ÿ'’-]+)/),year=line.match(/\\((\\d{4}[a-z]?)\\)/);return author&&year?(author[1]+' '+year[1]).toLowerCase():null}).filter(Boolean),missing=[...new Set(citations.filter(c=>!referencePairs.includes(c)))],unused=[...new Set(referencePairs.filter(r=>!citations.includes(r)))];$('#tool-result').innerHTML=`<div class=\"citation-status\"><div><strong>${citations.length}</strong><span>citations found</span></div><div><strong>${referencePairs.length}</strong><span>references parsed</span></div><div><strong>${missing.length+unused.length}</strong><span>items to review</span></div></div><div class=\"citation-findings\"><div><h5>Missing from reference list</h5>${missing.length?missing.map(x=>`<span>${esc(x)}</span>`).join(''):'<span>None found</span>'}</div><div><h5>Not cited in this draft</h5>${unused.length?unused.map(x=>`<span>${esc(x)}</span>`).join(''):'<span>None found</span>'}</div></div><p class=\"tool-caution\">Only parenthetical “(Author, 2024)” patterns are checked. Narrative citations, organizations, multiple authors, DOI accuracy, and source authenticity need a full review.</p>`;}\n  form.oninput=update;update();\n}\n\nconst defenseQuestions={quantitative:['Why does this test fit your research question?','How did you check the assumptions?','What does the effect size add beyond the p-value?','Which limitation matters most when reading this result?'],qualitative:['Why is this participant selection appropriate?','How did you move from raw material to themes?','What did you do to strengthen credibility?','Which alternative interpretation did you consider?'],mixed:['Why was one method not enough?','How did the quantitative and qualitative findings connect?','Where did the two strands disagree?','How did integration change the conclusion?']};\nlet defensePosition=0;\nfunction defensePractice(){\n  const w=$('#research-tool-workspace');\n  w.innerHTML=toolkitFrame('07','Practice the difficult questions.','Choose a design, 