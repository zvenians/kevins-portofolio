y);border:2px solid #11110f;box-shadow:18px 20px 0 #11110f}\n#commerce-demo .commerce-notice{padding:10px 18px;background:#ee4b2b;color:#fff8e9;border-bottom:2px solid #11110f;font:700 9px var(--world-mono);text-transform:uppercase}\n#commerce-demo .commerce-store-head{position:relative;min-height:430px;padding:42px;background:#f7d531;color:#11110f;border-bottom:2px solid #11110f;overflow:hidden;isolation:isolate}\n#commerce-demo .commerce-store-head:after{content:\"S\";position:absolute;z-index:-1;right:-.08em;bottom:-.37em;font:800 clamp(340px,48vw,680px)/1 var(--world-display);color:#ee4b2b;transform:rotate(-8deg)}\n#commerce-demo .commerce-store-head .eyebrow{font:700 10px var(--world-mono);letter-spacing:.11em}\n#commerce-demo .commerce-store-head h3{max-width:760px;font:800 clamp(68px,9vw,132px)/.78 var(--world-display)!important;letter-spacing:-.085em;text-transform:uppercase}\n#commerce-demo .commerce-store-head h3 i{font-family:inherit;font-style:normal;-webkit-text-stroke:2px #11110f;color:transparent}\n#commerce-demo .commerce-store-head button{align-self:flex-start;border:2px solid #11110f;background:#11110f;color:#f7d531;font:700 11px var(--world-mono);box-shadow:7px 7px 0 #fff8e9}\n#commerce-demo .commerce-layout{background:#f4efdf}\n#commerce-demo .commerce-catalog{padding:34px;border-right:2px solid #11110f}\n#commerce-demo .commerce-toolbar{padding-bottom:20px;border-bottom:2px solid #11110f}\n#commerce-demo :is(.commerce-toolbar,.commerce-product-copy,.commerce-shipping,.commerce-voucher,.commerce-checkout) label{font-family:var(--world-mono)}\n#commerce-demo .commerce-categories{gap:0}\n#commerce-demo .commerce-categories button{border:0;border-right:1px solid #11110f;border-bottom:1px solid #11110f;font:700 10px var(--world-mono);text-transform:uppercase}\n#commerce-demo .commerce-categories button[aria-pressed=true]{background:#ee4b2b;color:#fff8e9}\n#commerce-demo .commerce-grid{gap:18px}\n#commerce-demo .commerce-product{border:2px solid #1111