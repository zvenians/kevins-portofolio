mmerce-blueprint{padding:50px 42px;background:#f7d531;color:#11110f;border-top:2px solid #11110f}\n#commerce-demo .commerce-blueprint h3{font:800 clamp(48px,6vw,86px)/.82 var(--world-display)!important;text-transform:uppercase}\n#commerce-demo .commerce-sheet-map{border:2px solid #11110f;background:#11110f}\n#commerce-demo .commerce-sheet-map article{background:#fff8e9}\n#commerce-demo .commerce-flow{background:#ee4b2b;color:#fff8e9;border:2px solid #11110f;font-family:var(--world-mono)}\n\n/* Archive — a contemporary reading room and index-card system. */\n#archive-demo{position:relative;--demo-accent:#153f34;padding:clamp(28px,5vw,64px);background:#d8d1bd;color:#153f34;font-family:\"Bricolage Grotesque\",sans-serif;overflow:hidden}\n#archive-demo:before{content:\"ARCHIVE / 2026\";position:absolute;right:-74px;top:150px;transform:rotate(90deg);font:700 9px \"Space Mono\",monospace;letter-spacing:.2em}\n#archive-demo:after{content:\"A\";position:absolute;right:-.12em;bottom:-.42em;font:600 430px/1 \"Bodoni Moda\",serif;color:#c4bba3;pointer-events:none}\n#archive-demo>*{position:relative;z-index:1}\n#archive-demo .simulation-label{font:700 9px \"Space Mono\",monospace;letter-spacing:.15em;border-bottom:1px solid #153f34;padding-bottom:16px}\n#archive-demo .archive-controls{display:grid;grid-template-columns:1fr auto;gap:12px;margin-top:52px;padding:0;background:transparent;box-shadow:none}\n#archive-demo .archive-controls input{min-height:70px;padding:0 24px;border:1px solid #153f34;background:#eee9dc;font:400 26px \"Bodoni Moda\",serif}\n#archive-demo .archive-controls button{min-height:70px;padding:0 24px;background:#153f34;color:#eee9dc;border:1px solid #153f34;font:700 10px \"Space Mono\",monospace;text-transform:uppercase}\n#archive-demo #upload-status{min-height:40px;padding-top:14px;font:700 10px \"Space Mono\",monospace}\n#archive-demo .archive-list{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;filter:none}\n#archive-demo .archive-list button{position:relative;min-height:250px;padding:25px;display:flex;flex-direction:column;align-items:flex-start;justify-content:space-between;background:#eee9dc;color:#153f34;border:1px solid #153f34;text-align:left;box-shadow:8px 9px 0 #153f34}\n#archive-demo .archive-list button:before{content:\"0\" counter(archive-card);counter-increment:archive-card;font:600 72px/.8 \"Bodoni Moda\",serif;color:#9d9a87}\n#archive-demo .archive-list{counter-reset:archive-card}\n#archive-demo .archive-list button span:first-of-type{font:600 25px/.95 \"Bodoni Moda\",serif}\n#archive-demo .archive-list button span:last-child{font:700 9px \"Space Mono\",monospace;letter-spacing:.08em;border-top:1px solid;padding-top:12px;width:100%}\n\n/* Booking — warm service atelier with ticket-like time slots. */\n#booking-demo{--demo-accent:#e84627;padding:clamp(28px,5vw,64px);background:#f3a93b;color:#20211d;font-family:\"Bricolage Grotesque\",sans-serif;overflow:hidden}\n#booking-demo .simulation-label{font:700 10px \"Space Mono\",monospace;letter-spacing:.14em}\n#booking-demo .booking-form{position:relative;max-width:900px;margin:40px auto 0;padding:clamp(28px,5vw,62px);background:#f6f1e6;border:2px solid #20211d;box-shadow:18px 20px 0 #20211d;display:grid;grid-template-columns:1fr 1fr;gap:28px}\n#booking-demo .booking-form:before{content:\"MAKE TIME\";position:absolute;right:22px;top:-28px;font:800 clamp(40px,7vw,90px)/1 \"Syne\",sans-serif;letter-spacing:-.08em;color:#e84627;transform:rotate(-3deg)}\n#booking-demo .booking-form>label{font:700 10px \"Space Mono\",monospace;text-transform:uppercase}\n#booking-demo .booking-form input,#booking-demo .booking-form select{margin-top:9px;min-height:54px;border:0;border-bottom:2px solid #20211d;background:transparent;font:500 17px \"Bricolage Grotesque\",sans-serif}\n#booking-demo .booking-form fieldset{grid-column:1/-1;border:0;border-top:2px solid #20211d;padding:24px 0 0}\n#booking-demo .booking-form legend{font:700 10px \"Space Mono\",monospace;text-transform:uppercase;padding-right:18px}\n#booking-demo .slot-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}\n#booking-demo .slot-grid label span{min-height:72px;display:grid;place-items:center;border:2px solid #20211d;background:#fffaf0;font:700 18px \"Space Mono\",monospace;transition:transform .2s ease,background .2s ease,box-shadow .2s ease}\n#booking-demo .slot-grid label input:checked+span{background:#20211d;color:#f3a93b;transform:translate(-3px,-3px);box-shadow:5px 5px 0 #e84627}\n#booking-demo .booking-form>button{grid-column:1/-1;min-height:62px;background:#e84627;color:#fffaf0;border:2px solid #20211d;font:700 12px \"Space Mono\",monospace;text-transform:uppercase}\n#booking-demo .booking-summary{max-width:900px;margin:0 auto;background:#20211d;color:#fffaf0;border:2px solid #20211d;border-top:12px solid #e84627;padding:38px;box-shadow:none}\n#booking-demo .booking-summary h3{font:800 clamp(44px,6vw,72px)/.9 \"Syne\",sans-serif;letter-spacing:-.06em}\n\n/* Data Lab — shared structure, different instrument for every problem. */\n.data-lab .workspace{--lab-accent:#ff5b35;--lab-bg:#e9e6dc;--lab-ink:#181a18;position:relative;background:var(--lab-bg);color:var(--lab-ink);border:2px solid var(--lab-ink);box-shadow:18px 20px 0 var(--lab-ink);font-family:\"Bricolage Grotesque\",sans-serif;overflow:hidden}\n.data-lab .workspace:before{content:attr(data-lab-world);display:block;padding:10px 18px;background:var(--lab-ink);color:var(--lab-bg);font:700 9px \"Space Mono\",monospace;letter-spacing:.15em;text-transform:uppercase}\n.data-lab .workspace-heading{position:relative;min-height:270px;padding:34px 38px;align-items:end;background:var(--lab-bg);border-bottom:2px solid var(--lab-ink);overflow:hidden}\n.data-lab .workspace-heading:after{content:attr(data-lab-world);position:absolute;right:-.03em;bottom:-.33em;font:800 clamp(120px,18vw,270px)/.7 \"Syne\",sans-serif;letter-spacing:-.09em;color:var(--lab-accent);opacity:.18;text-transform:uppercase;pointer-e