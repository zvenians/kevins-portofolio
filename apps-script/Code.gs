uerySelector(`#${id} .section-label span`);if(label)label.textContent=label.textContent.replace(/^\\d+/,n)});const total=$('.hero-foot span:last-child');if(total)total.textContent='01 / 09 ↓';}\nfunction home(){document.body.classList.remove('focus-reading');$('#main').innerHTML=`<section class=\"arrival entrance\" id=\"home\"><div class=\"section-label mono\"><span><i class=\"signal\"></i>THE LIVING INDEX — VOL. 01</span><span>WEB SYSTEMS / OPERATIONAL DATA / INTERFACE DESIGN</span></div><h1 class=\"name-display\"><span>KEVIN</span><span>SIMATUPANG<b>.</b></span></h1><div class=\"arrival-bottom\"><div class=\"arrival-intro\"><span class=\"eyebrow\">FULL-STACK DEVELOPER / BALIKPAPAN</span><p>I build web systems, structured data workflows, and interfaces that make complicated work easier to understand.</p><div class=\"arrival-actions\"><a class=\"text-link\" href=\"#field\">View real work <span>↓</span></a><a class=\"text-link\" href=\"#resume\">Resume <span>↗</span></a></div><div class=\"visitor-paths\" aria-label=\"Quick paths\"><a href=\"#field\"><b>Hiring?</b><span>Start with verified work.</span></a><a href=\"#lab\"><b>Operational problem?</b><span>Open the Data Lab.</span></a><a href=\"#research\"><b>Research stuck?</b><span>See ethical support.</span></a></div></div><div class=\"instrument\"><div class=\"instrument-tabs\">${['Systems','Data','Design'].map((x,i)=>`<button data-layer=\"${i}\" aria-pressed=\"${i===0}\"><small>0${i+1}</small>${x}</button>`).join('')}</div><a class=\"instrument-surface\" href=\"#field\" id=\"instrument-content\"></a></div></div><div class=\"hero-foot mono\"><span>SCROLL TO DISCOVER</span><span>BUILT TO KEEP EVOLVING</span><span>01 / 08 ↓</span></div></section><section id=\"field\">${sectionLabel('01','THE WORK UNIVERSE',`${String(data.projects.length).padStart(2,'0')} ENTRIES / CURATED BY EVIDENCE`)}<div class=\"section-heading\"><h2>Real work first.<br><i>Experiments when useful.</i></h2><p>Production projects lead the story. Demo