stration Data','Fictional records only'],['Threshold IDR',state.threshold],['Rule','2025-2026 cost; <=2024 revaluation'],['Basis','Selected comparable valuation; not depreciation']]);X.utils.book_append_sheet(wb,settings,'Settings');const headers=['Inventory ID','Description','Acquired','Original cost','2024 revaluation','Comparison basis','Basis value','Operations value','Variance','Finding'];const reconciled=reconcile(accounting,operational,state.threshold);const sheet=X.utils.aoa_to_sheet([headers,...reconciled.map(r=>[r.id,r.name,r.date,r.cost,r.revaluation,r.basis,r.base,r.value,r.variance,r.status])]);reconciled.forEach((r,i)=>{const n=i+2;['A','B','C','D','E'].forEach(col=>{const cell=sheet[col+n]||{t:'s',v:''};cell.f=`IF(Accounting!${col}${n}=\"\",\"\",Accounting!${col}${n})`;sheet[col+n]=cell;});const dup=`OR(COUNTIF(Accounting!A$2:A$11,A${n})>1,COUNTIF(Operations!A$2:A$9,A${n})>1)`;sheet['F'+n]={t:'s',v:r.basis,f:`IF(VALUE(LEFT(C${n},4))<=2024,\"Revaluation 2024\",IF(OR(VALUE(LEFT(C${n},4))=2025,VALUE(LEFT(C${n},4))=2026),\"Original cost\",\"Review year\"))`};sheet['G'+n]={t:r.base===null?'s':'n',v:r.base??'',f:`IF(F${n}=\"Revaluation 2024\",IF(E${n}=\"\",\"\",E${n}),IF(F${n}=\"Original cost\",IF(D${n}=\"\",\"\",D${n}),\"\"))`};sheet['H'+n]={t:r.value===null?'s':'n',v:r.value??'',f:`IF(A${n}=\"\",\"\",IF(COUNTIF(Operations!A$2:A$9,A${n})<>1,\"\",IF(INDEX(Operations!C$2:C$9,MATCH(A${n},Operations!A$2:A$9,0))=\"\",\"\",INDEX(Operations!C$2:C$9,MATCH(A${n},Operations!A$2:A$9,0)))))`};sheet['I'+n]={t:r.variance===null?'s':'n',v:r.variance??'',f:`IF(OR(A${n}=\"\",${dup},G${n}=\"\",H${n}=\"\"),\"\",H${n}-G${n})`};sheet['J'+n]={t:'s',v:r.status,f:`IF(A${n}=\"\",\"Missing identifier\",IF(${dup},\"Duplicate identifier\",IF(COUNTIF(Operations!A$2:A$9,A${n})=0,\"Not in operations\",IF(OR(G${n}=\"\",H${n}=\"\"),\"Missing valuation\",IF(ABS(I${n})>Settings!B$2,\"Material variance\",\"Within threshold\")))))`};});sheet['!cols']=headers.map((_,i)=>({wch:i===1?25:22}));X.utils.book_append_sheet(wb,sheet,'Reconciled');const unmatched=operational.filter(o=>!accounting.some(a=>a.id===o.id));X.utils.book_append_sheet(wb,X.utils.aoa_to_sheet([['Operations-only records — not automatic errors'],['ID','Description','Value'],...unmatched.map(r=>[r.id,r.name,r.value])]),'Operations only');wb.Workbook={CalcPr:{calcMode:'auto',fullCalcOnLoad:true}};X.writeFile(wb,'Living-Index-Reconciliation-Demo.xlsx');toast('Workbook generated with formulas and cached results.');}\nlet validated=[18,7,4,2];function validation(){const names=['Office equipment','Machines','Vehicles','Buildings'],totals=[30,12,6,3],previous=[15,6,3,2],sum=validated.reduce((a,b)=>a+b,0);$('#workspace').innerHTML=workspaceHeading('02','Observation becomes evidence.','<button class=\"dark-button\" id=\"validation-export\">Export review ↓</button>')+`<div class=\"lab-stats\"><div><strong>${Math.round(sum/51*100)}%</strong><span>${sum} / 51 validated</span></div><div><strong>${51-sum}</strong><span>Pending</span></div><div><strong>${sum-26>=0?'+':''}${sum-26}</strong><span>Since last week</span></div></div><div class=\"validation-grid\">${names.map((n,i)=>`<label>${n} — ${validated[i]} / ${totals[i]}<input data-validated=\"${i}\" type=\"range\" min=\"0\" max=\"${totals[i]}\" value=\"${validated[i]}\"><small>${totals[i]-validated[i]} records still need verification</small></label>`).join('')}</div>`+table(['Record','Department / Location','Condition','RFID','Last inspection','Next action'],[['DEMO-F01 / PC','Admin / Room A','Good','Registered','2026-10-19','Confirm identifier'],['DEMO-F02 / Pump','Engineering / Unclear','Needs inspection','Pending','2026-10-18','Confirm location with PIC'],['DEMO-F03 / Vehicle','Operations / Garage','Service due','Not applicable','2026-10-20','Review service report']].map(r=>'<tr>'+r.map(v=>`<td>${v}</td>`).join('')+'</tr>').join(''))+'<p class=\"calculation\">Observe → identify → confirm location and condition → validate. Controls model aggregate pro